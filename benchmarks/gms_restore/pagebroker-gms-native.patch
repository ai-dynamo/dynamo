+  fs::rename(artifact_ / "shards" / "weights.bin", artifact_ / "weights-real.bin");
+  fs::create_symlink("../weights-real.bin", artifact_ / "shards" / "weights.bin");
+  ExpectRejected(request_, "shard size mismatch");
+  fs::remove(artifact_ / "shards" / "weights.bin");
