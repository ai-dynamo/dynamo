--- /dev/null
+++ b/agent/pagebroker/gms_load_layout.cpp
@@ -0,0 +1,82 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "gms_load_layout.hpp"
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+
+namespace snapshot::pagebroker {
+namespace {
+void Require(bool ok, const char* message) {
+  if (!ok) throw std::runtime_error(message);
+}
+FileDescriptor OpenShard(int directory, const std::string& path) {
+  Require(!path.empty() && path.front() != '/' && path.find('\0') == std::string::npos,
+          "GMS shard must be a relative path");
+  FileDescriptor parent(fcntl(directory, F_DUPFD_CLOEXEC, 0));
+  Require(parent.get() >= 0, "duplicate GMS artifact directory");
+  size_t begin = 0;
+  while (true) {
+    const size_t end = path.find('/', begin);
+    const std::string component = path.substr(begin, end - begin);
+    Require(!component.empty() && component != "." && component != "..", "unsafe GMS shard path");
+    const bool last = end == std::string::npos;
+    FileDescriptor next(openat(parent.get(), component.c_str(), O_CLOEXEC | O_NOFOLLOW |
+                               (last ? O_RDONLY | O_DIRECT : O_RDONLY | O_DIRECTORY)));
+    Require(next.get() >= 0, "open pinned GMS shard without symlinks");
+    if (last) return next;
+    parent = std::move(next);
+    begin = end + 1;
+  }
+}
+
+}  // namespace
+std::vector<GmsShardSource> ValidateGmsSources(
+    const v1::LoadGmsWeightsRequest& request, int directory, size_t granularity,
+    std::map<std::string, uint64_t>* expected, size_t* bytes) {
+  Require(granularity > 0, "invalid GMS allocation granularity");
+  Require(!request.capture_id().empty() && !request.generation().empty() &&
+          !request.expected_server_nonce().empty() && request.allocations_size() > 0,
+          "GMS load requires capture, generation, server incarnation and allocations");
+  std::map<std::string, std::vector<const v1::GmsAllocation*>> groups;
+  *bytes = 0;
+  for (const auto& allocation : request.allocations()) {
+    Require(!allocation.allocation_id().empty() && allocation.aligned_size() > 0 &&
+            allocation.aligned_size() % granularity == 0 && allocation.offset() % granularity == 0,
+            "invalid GMS allocation ID, size or alignment");
+    Require(expected->emplace(allocation.allocation_id(), allocation.aligned_size()).second,
+            "duplicate GMS allocation ID");
+    Require(allocation.aligned_size() <= std::numeric_limits<size_t>::max() - *bytes,
+            "GMS byte count overflows");
+    *bytes += allocation.aligned_size();
+    groups[allocation.shard()].push_back(&allocation);
+  }
+  std::vector<GmsShardSource> shards;
+  for (auto& [path, allocations] : groups) {
+    std::sort(allocations.begin(), allocations.end(), [](const auto* a, const auto* b) {
+      return a->offset() < b->offset();
+    });
+    size_t size = 0;
+    for (const auto* allocation : allocations) {
+      Require(allocation->offset() == size && allocation->aligned_size() <=
+              std::numeric_limits<size_t>::max() - size, "GMS shard extents must cover the file contiguously");
+      size += allocation->aligned_size();
+    }
+    GmsShardSource shard{OpenShard(directory, path), {}, 0, {}};
+    struct stat info{};
+    Require(!fstat(shard.file.get(), &info) && S_ISREG(info.st_mode) &&
+            info.st_size >= 0 && static_cast<uint64_t>(info.st_size) == size,
+            "GMS shard file size does not match allocations");
+    const int flags = fcntl(shard.file.get(), F_GETFL);
+    Require(flags >= 0 && (flags & O_DIRECT), "GMS shard must use O_DIRECT");
+    shard.path = path;
+    shard.size = size;
+    shard.allocations = std::move(allocations);
+    shards.push_back(std::move(shard));
+  }
+  return shards;
+}
+}  // namespace snapshot::pagebroker
