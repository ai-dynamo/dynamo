diff --git a/agent/pagebroker/gms_admission.cpp b/agent/pagebroker/gms_admission.cpp
new file mode 100644
index 00000000..612df9fe
--- /dev/null
+++ b/agent/pagebroker/gms_admission.cpp
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "gms_admission.hpp"
+
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <google/protobuf/struct.pb.h>
+#include <google/protobuf/util/json_util.h>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <system_error>
+#include <tuple>
+#include <vector>
+#include "integrity/content_digest.hpp"
+
+namespace snapshot::pagebroker {
+namespace {
+using Object = google::protobuf::Struct;
+using Value = google::protobuf::Value;
+using Record = std::tuple<std::string, uint64_t, std::string, uint64_t>;
+
+void Require(bool condition, const char* message) {
+  if (!condition) throw std::invalid_argument(message);
+}
+bool Text(const std::string& s) {
+  return !s.empty() && s.size() <= 256 && s.find('\0') == std::string::npos;
+}
+const Value& Field(const Object& o, const char* name) {
+  auto it = o.fields().find(name);
+  Require(it != o.fields().end(), "GMS manifest missing field");
+  return it->second;
+}
+uint64_t Integer(const Value& v) {
+  Require(v.kind_case() == Value::kNumberValue && std::isfinite(v.number_value()) &&
+          v.number_value() >= 0 && v.number_value() < 9007199254740992.0 &&
+          std::floor(v.number_value()) == v.number_value(), "GMS manifest invalid integer");
+  return static_cast<uint64_t>(v.number_value());
+}
+std::string String(const Value& v) {
+  Require(v.kind_case() == Value::kStringValue, "GMS manifest invalid string");
+  return v.string_value();
+}
+}
+
+void ValidateGmsArtifact(const v1::LoadGmsWeightsRequest& r, int directory) {
+  Require(Text(r.capture_id()) && Text(r.generation()) && Text(r.destination_uuid()) &&
+          Text(r.expected_server_nonce()), "GMS identity fields are required");
+  Require(r.rank() < 1024 && r.timeout_seconds() > 0 && r.timeout_seconds() <= 240,
+          "GMS rank or deadline is invalid");
+  Require(r.allocations_size() > 0 && r.allocations_size() <= 1024,
+          "GMS allocation count is invalid");
+  Require(cuda_checkpoint_storage::IsSHA256Hex(r.manifest_sha256()), "GMS manifest digest is required");
+  const auto& socket = r.socket_path();
+  Require(!socket.empty() && socket.front() == '/' && socket.size() < sizeof(sockaddr_un::sun_path) &&
+          socket.find('\0') == std::string::npos && std::filesystem::path(socket).lexically_normal() == socket,
+          "GMS socket must be an absolute normalized path");
+
+  FileDescriptor manifest(openat(directory, "manifest.json", O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+  if (manifest.get() < 0) throw std::system_error(errno, std::generic_category(), "open GMS manifest");
+  struct stat st{};
+  Require(fstat(manifest.get(), &st) == 0 && S_ISREG(st.st_mode) && st.st_size > 0 && st.st_size <= 1048576,
+          "GMS manifest must be a small regular file");
+  std::string bytes(static_cast<size_t>(st.st_size), '\0');
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const auto n = read(manifest.get(), bytes.data() + offset, bytes.size() - offset);
+    if (n < 0 && errno == EINTR) continue;
+    Require(n > 0, "GMS manifest truncated");
+    offset += n;
+  }
+  char trailing;
+  Require(read(manifest.get(), &trailing, 1) == 0, "GMS manifest changed during admission");
+  cuda_checkpoint_storage::ContentDigest digest;
+  std::string actual, error;
+  if (!digest.Update(bytes.data(), bytes.size(), &error) || !digest.Finalize(&actual, &error))
+    throw std::runtime_error(error);
+  Require(actual == r.manifest_sha256(), "GMS manifest digest mismatch");
+  Object json;
+  Require(google::protobuf::util::JsonStringToMessage(bytes, &json).ok(), "GMS manifest invalid JSON");
+  Require(json.fields_size() == 2 && Integer(Field(json, "version")) == 1, "GMS manifest version invalid");
+  const auto& allocations = Field(json, "allocations");
+  Require(allocations.kind_case() == Value::kListValue, "GMS manifest allocations must be a list");
+  std::vector<Record> saved, requested;
+  for (const auto& v : allocations.list_value().values()) {
+    Require(v.kind_case() == Value::kStructValue && v.struct_value().fields_size() == 4,
+            "GMS manifest allocation fields invalid");
+    const auto& a = v.struct_value();
+    saved.emplace_back(String(Field(a, "allocation_id")), Integer(Field(a, "aligned_size")),
+                       String(Field(a, "shard")), Integer(Field(a, "offset")));
+  }
+  std::set<std::string> ids;
+  std::map<std::string, std::vector<std::pair<uint64_t, uint64_t>>> shards;
+  for (const auto& a : r.allocations()) {
+    Require(Text(a.allocation_id()) && ids.insert(a.allocation_id()).second, "GMS allocation ID duplicate or invalid");
+    const std::filesystem::path path(a.shard());
+    Require(path.parent_path() == "shards" && path.filename() != "." && path.filename() != ".." &&
+            Text(path.filename().string()) && a.shard().find('\\') == std::string::npos,
+            "GMS shard must be a direct child of shards");
+    Require(a.aligned_size() > 0 && a.aligned_size() < (uint64_t{1} << 53) &&
+            a.offset() < (uint64_t{1} << 53) && a.aligned_size() % 4096 == 0 && a.offset() % 4096 == 0,
+            "GMS extent size or alignment is invalid");
+    requested.emplace_back(a.allocation_id(), a.aligned_size(), a.shard(), a.offset());
+    shards[a.shard()].emplace_back(a.offset(), a.aligned_size());
+  }
+  std::sort(saved.begin(), saved.end());
+  std::sort(requested.begin(), requested.end());
+  Require(saved == requested, "GMS requested allocations differ from captured manifest");
+  FileDescriptor shard_directory(openat(directory, "shards", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW));
+  Require(shard_directory.get() >= 0, "GMS shards directory unavailable");
+  for (auto& [name, extents] : shards) {
+    std::sort(extents.begin(), extents.end());
+    uint64_t end = 0;
+    for (auto [start, size] : extents) {
+      Require(start == end, "GMS shard extents must be contiguous and non-overlapping");
+      end += size;
+    }
+    FileDescriptor file(openat(shard_directory.get(), std::filesystem::path(name).filename().c_str(),
+                               O_RDONLY | O_CLOEXEC | O_NOFOLLOW));
+    Require(file.get() >= 0 && fstat(file.get(), &st) == 0 && S_ISREG(st.st_mode) &&
+            st.st_size >= 0 && static_cast<uint64_t>(st.st_size) == end, "GMS shard size mismatch");
+  }
+}
+
+FileDescriptor ConnectGmsEndpoint(const v1::LoadGmsWeightsRequest& r) {
+  FileDescriptor fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+  if (fd.get() < 0) throw std::system_error(errno, std::generic_category(), "create GMS connection");
+  timeval deadline{static_cast<time_t>(r.timeout_seconds()), 0};
+  if (setsockopt(fd.get(), SOL_SOCKET, SO_RCVTIMEO, &deadline, sizeof(deadline)) < 0 ||
+      setsockopt(fd.get(), SOL_SOCKET, SO_SNDTIMEO, &deadline, sizeof(deadline)) < 0)
+    throw std::system_error(errno, std::generic_category(), "set GMS connection deadline");
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  Require(r.socket_path().size() < sizeof(address.sun_path), "GMS socket path too long");
+  std::memcpy(address.sun_path, r.socket_path().c_str(), r.socket_path().size() + 1);
+  if (connect(fd.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0)
+    throw std::system_error(errno, std::generic_category(), "connect GMS endpoint");
+  return fd;
+}
+}  // namespace snapshot::pagebroker
