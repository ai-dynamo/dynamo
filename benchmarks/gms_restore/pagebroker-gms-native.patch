+
+TEST_F(GmsAdmissionTest, BrokerReplaysPublishedResultWithoutSecondGpuAdmission) {
+  Listen();
+  Broker broker(root_ / "staging", root_ / "storage", fs::absolute("build/fake-gms-gpu-engine"));
+  broker.StartGpuEngine();
+  const auto first = broker.HandleRequest(Envelope());
+  ASSERT_TRUE(first.has_gms_weights_loaded()) << first.DebugString();
+  const auto second = broker.HandleRequest(Envelope("load-2"));
+  ASSERT_TRUE(second.has_gms_weights_loaded()) << second.DebugString();
+  EXPECT_EQ(second.request_id(), "load-2");
+  EXPECT_EQ(second.gms_weights_loaded().report(), first.gms_weights_loaded().report());
+  EXPECT_EQ(Calls(), 1u);
+  request_.set_generation("different-generation");
+  const auto changed = broker.HandleRequest(Envelope("load-3"));
+  ASSERT_TRUE(changed.has_failure());
+  EXPECT_EQ(changed.failure().code(), v1::Failure::TRANSACTION_CONFLICT);
+  EXPECT_EQ(Calls(), 1u);
+}
+
+TEST_F(GmsAdmissionTest, BrokerConcurrentDuplicatesWaitForSingleAdmission) {
+  Listen();
+  std::ofstream(artifact_ / "hold-gms") << '1';
+  Broker broker(root_ / "staging", root_ / "storage", fs::absolute("build/fake-gms-gpu-engine"));
+  broker.StartGpuEngine();
+  auto first = std::async(std::launch::async, [&] { return broker.HandleRequest(Envelope()); });
+  const bool admitted = WaitForAdmission();
+  auto second = std::async(std::launch::async, [&] { return broker.HandleRequest(Envelope("load-2")); });
+  const auto second_state = second.wait_for(std::chrono::milliseconds(50));
+  fs::remove(artifact_ / "hold-gms");
+  EXPECT_TRUE(admitted);
+  EXPECT_EQ(second_state, std::future_status::timeout);
+  EXPECT_TRUE(first.get().has_gms_weights_loaded());
+  EXPECT_TRUE(second.get().has_gms_weights_loaded());
+  EXPECT_EQ(Calls(), 1u);
