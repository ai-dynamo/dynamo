+Response
+Broker::LoadGms(const Request& request)
+{
+  const auto& operation = request.load_gms_weights();
+  StorageBackend storage;
+  storage.mutable_filesystem()->set_directory(operation.artifact_directory());
+  auto source = Engine(TransferEngineType::POSIX_COPY).OpenRestoreSource(storage);
+  ValidateGmsArtifact(operation, source.get());
+  if (!gpu_engine_)
+    return Fail(request, Failure::INVALID_REQUEST, "GMS loading requires a configured GPU engine");
+  if (FindTransaction(request.transaction_id()))
+    return Fail(request, Failure::TRANSACTION_CONFLICT, "GMS transaction conflicts with native transaction");
+  const auto binding = operation.SerializeAsString();
+  const auto identity = operation.destination_uuid() + "\n" + operation.expected_server_nonce();
+  std::shared_ptr<GmsAttempt> attempt;
+  {
+    std::unique_lock lock(gms_mutex_);
+    const auto existing = gms_attempts_.find(identity);
+    if (existing != gms_attempts_.end()) {
+      attempt = existing->second;
+      if (attempt->binding != binding || attempt->transaction != request.transaction_id())
+        return Fail(request, Failure::TRANSACTION_CONFLICT, "GMS server incarnation already admitted; no RW retry allowed");
+      if (!attempt->changed.wait_for(lock, std::chrono::seconds(operation.timeout_seconds()),
+                                     [&] { return attempt->complete; }))
+        return Fail(request, Failure::TRANSACTION_CONFLICT, "GMS admission still running; duplicate did not acquire RW");
+      auto response = attempt->response;
+      response.set_request_id(request.request_id());
+      return response;
+    }
+    if (gms_transactions_.contains(request.transaction_id()) || gms_attempts_.size() >= 1024)
+      return Fail(request, Failure::TRANSACTION_CONFLICT, "GMS transaction reused or one-shot ledger full");
+    attempt = std::make_shared<GmsAttempt>();
+    attempt->binding = binding;
+    attempt->transaction = request.transaction_id();
+    gms_attempts_.emplace(identity, attempt);
+    gms_transactions_.emplace(request.transaction_id(), identity);
+  }
+  auto response = Reply(request);
+  try {
+    auto endpoint = ConnectGmsEndpoint(operation);
+    v1::NativeSessionReply reply;
+    std::vector<FileDescriptor> descriptors;
+    try {
+      auto session = gpu_engine_->LoadGms(operation, source.get(), endpoint.get());
+      if (!ReceiveFrame(session.get(), reply, descriptors) || !descriptors.empty())
+        throw std::runtime_error("GMS GPU reply missing or carried unexpected descriptors");
+    } catch (...) {
+      // Reap the GPU worker before releasing the pinned artifact admission.
+      // A lost reply alone cannot prove outstanding DMA stopped.
+      gpu_engine_->Stop();
+      throw;
+    }
+    if (reply.has_failure())
+      *response.mutable_failure() = reply.failure();
+    else
+      response.mutable_gms_weights_loaded()->set_report(reply.report());
+  } catch (const std::exception& error) {
+    response = Fail(request, Failure::STORAGE_ERROR, error.what());
+  }
+  {
+    std::lock_guard lock(gms_mutex_);
+    attempt->response = response;
+    attempt->complete = true;
+  }
+  attempt->changed.notify_all();
+  return response;
+}
