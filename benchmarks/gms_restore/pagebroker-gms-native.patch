+#include <future>
+#include <map>
+#include <stdexcept>
+#include <thread>
+
+using namespace snapshot::pagebroker;
+using namespace std::chrono_literals;
+
+namespace {
+constexpr const char* kUuid = "GPU-00000000-0000-0000-0000-000000000001";
+constexpr const char* kNonce = "fake-server-incarnation";
+
+void Check(bool okay) { if (!okay) { throw std::runtime_error("fake peer assertion failed"); } }
+
+template<class Fill>
+std::string Packed(const char* type, uint32_t extra, Fill fill)
+{
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(extra + 1); packer.pack("type"); packer.pack(type); fill(packer);
+  return {buffer.data(), buffer.size()};
+}
+
+std::string Packed(const char* type) { return Packed(type, 0, [](auto&) {}); }
+
+std::string Handshake(const char* uuid = kUuid, const char* nonce = kNonce, const char* lock = "rw")
+{
+  return Packed("handshake_response", 3, [&](auto& p) {
+    p.pack("gpu_uuid"); p.pack(uuid); p.pack("server_nonce"); p.pack(nonce);
+    p.pack("lock_type"); p.pack(lock);
+  });
+}
+
+void SendBytes(int fd, const std::string& bytes)
+{
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const auto sent = send(fd, bytes.data() + offset, bytes.size() - offset, MSG_NOSIGNAL);
+    Check(sent > 0); offset += sent;
+  }
+}
+
+void Reply(int fd, const std::string& payload, const std::vector<int>& fds = {}, bool fragmented = false)
+{
+  uint32_t size = htonl(payload.size());
+  std::string frame(reinterpret_cast<char*>(&size), sizeof(size));
+  frame += payload;
+  if (fragmented) {
+    // Put descriptors on the first payload byte, after all four header reads.
+    for (size_t i = 0; i < 4; ++i) { SendBytes(fd, frame.substr(i, 1)); }
+    frame.erase(0, 4);
+  }
+  if (!fds.empty()) {
+    std::vector<char> control(CMSG_SPACE(fds.size() * sizeof(int)));
+    iovec vector{frame.data(), 1};
+    msghdr message{};
+    message.msg_iov = &vector; message.msg_iovlen = 1;
+    message.msg_control = control.data(); message.msg_controllen = control.size();
+    auto* header = CMSG_FIRSTHDR(&message);
+    header->cmsg_level = SOL_SOCKET; header->cmsg_type = SCM_RIGHTS;
+    header->cmsg_len = CMSG_LEN(fds.size() * sizeof(int));
+    std::memcpy(CMSG_DATA(header), fds.data(), fds.size() * sizeof(int));
+    Check(sendmsg(fd, &message, MSG_NOSIGNAL) == 1);
+    frame.erase(0, 1);
+  }
+  if (fragmented) {
+    for (const auto byte : frame) { SendBytes(fd, std::string(1, byte)); }
+  } else { SendBytes(fd, frame); }
+}
+
+msgpack::object_handle Request(int fd, const char* expected)
+{
+  auto exact = [&](void* destination, size_t count) {
+    auto* data = static_cast<char*>(destination);
+    while (count) { const auto read = recv(fd, data, count, 0); Check(read > 0); data += read; count -= read; }
+  };
+  uint32_t count = 0;
+  exact(&count, sizeof(count)); count = ntohl(count); Check(count <= (1U << 20));
+  std::string data(count, '\0'); exact(data.data(), data.size());
+  auto result = msgpack::unpack(data.data(), data.size());
+  std::map<std::string, msgpack::object> fields;
+  result.get().convert(fields); Check(fields.at("type").as<std::string>() == expected);
+  return result;
+}
+
+class Peer {
+ public:
+  explicit Peer(std::function<void(int)> work)
+  {
+    int sockets[2]; Check(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) == 0);
+    client = FileDescriptor(sockets[0]); server_ = FileDescriptor(sockets[1]);
+    timeval timeout{2, 0};
+    Check(setsockopt(server_.get(), SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) == 0);
+    worker_ = std::thread([this, work = std::move(work)] {
+      try { work(server_.get()); } catch (...) { error_ = std::current_exception(); }
+    });
+  }
+  ~Peer() { shutdown(server_.get(), SHUT_RDWR); if (worker_.joinable()) { worker_.join(); } }
+  void Finish() { worker_.join(); if (error_) { std::rethrow_exception(error_); } }
+  FileDescriptor client{-1};
+ private:
+  FileDescriptor server_{-1};
+  std::thread worker_;
+  std::exception_ptr error_;
+};
+
+size_t DescriptorCount()
+{
+  return std::distance(std::filesystem::directory_iterator("/proc/self/fd"), std::filesystem::directory_iterator());
+}
+
+void Admit(int fd) { Request(fd, "handshake_request"); Reply(fd, Handshake()); }
+}  // namespace
+
+TEST(GmsV1Client, FragmentedFramesDescriptorsAndExactInventory)
+{
+  int pipe_fds[2]; ASSERT_EQ(pipe(pipe_fds), 0);
+  FileDescriptor read_fd(pipe_fds[0]), write_fd(pipe_fds[1]);
+  ASSERT_EQ(write(write_fd.get(), "ok", 2), 2);
+  Peer peer([&](int fd) {
+    auto handshake_object = Request(fd, "handshake_request");
+    auto handshake = handshake_object.get().as<std::map<std::string, msgpack::object>>();
+    Check(handshake.at("lock_type").as<std::string>() == "rw");
+    const auto identity = handshake.at("expected_identity").as<std::vector<std::string>>();
+    Check(identity == std::vector<std::string>{kNonce, kUuid});
+    Reply(fd, Handshake(), {}, true);
+    auto handle = Request(fd, "allocate_request");
+    auto allocation = handle.get().as<std::map<std::string, msgpack::object>>();
+    Check(allocation.at("allocation_id").as<std::string>() == "captured-allocation");
+    Check(allocation.at("aligned_size").as<uint64_t>() == (uint64_t{1} << 33));
+    Reply(fd, Packed("success_response"));
+    Request(fd, "export_request"); Reply(fd, Packed("export_response"), {read_fd.get()}, true);
+    Request(fd, "list_allocations_request");
+    Reply(fd, Packed("list_allocations_response", 1, [](auto& p) {
+      p.pack("allocations"); p.pack_array(1); p.pack_map(2);
+      p.pack("allocation_id"); p.pack("captured-allocation"); p.pack("aligned_size"); p.pack(uint64_t{1} << 33);
+    }));
+    Request(fd, "commit_request"); Reply(fd, Packed("success_response"));
+    char byte; Check(recv(fd, &byte, 1, 0) == 0);  // Destructor must not send abort after commit.
+  });
+  {
+    GmsV1Client client(std::move(peer.client));
+    client.Handshake(kUuid, kNonce);
+    EXPECT_EQ(client.gpu_uuid(), kUuid); EXPECT_EQ(client.server_nonce(), kNonce);
+    client.Allocate("captured-allocation", uint64_t{1} << 33);
+    auto fd = client.Export("captured-allocation");
+    EXPECT_NE(fcntl(fd.get(), F_GETFD) & FD_CLOEXEC, 0);
+    char value[2]; ASSERT_EQ(read(fd.get(), value, 2), 2); EXPECT_EQ(std::string(value, 2), "ok");
+    EXPECT_EQ(client.ListAllocations(), (std::vector<GmsAllocationRecord>{{"captured-allocation", uint64_t{1} << 33}}));
+    client.Commit();
+    EXPECT_THROW(client.Allocate("new", 4096), std::runtime_error);
+  }
+  peer.Finish();
+}
+
+TEST(GmsV1Client, RejectsWrongIdentityOrLease)
+{
+  for (const auto& response : {Handshake("wrong-gpu"), Handshake(kUuid, "wrong-nonce"), Handshake(kUuid, kNonce, "ro")}) {
+    Peer peer([&](int fd) { Request(fd, "handshake_request"); Reply(fd, response); });
+    GmsV1Client client(std::move(peer.client));
+    EXPECT_THROW(client.Handshake(kUuid, kNonce), std::runtime_error);
+    EXPECT_THROW(client.Allocate("id", 4096), std::runtime_error);
+    client.Close(); peer.Finish();
+  }
+}
+
+TEST(GmsV1Client, RejectsMissingExtraTruncatedOrUnexpectedDescriptorsWithoutLeaks)
+{
+  for (const int count : {0, 2, 32, -1}) {
+    const auto before = DescriptorCount();
+    {
+      FileDescriptor descriptor(open("/dev/null", O_RDONLY | O_CLOEXEC));
+      Peer peer([&](int fd) {
+        Admit(fd);
+        Request(fd, count < 0 ? "allocate_request" : "export_request");
+        Reply(fd, Packed(count < 0 ? "success_response" : "export_response"),
+              std::vector<int>(count < 0 ? 1 : count, descriptor.get()));
+      });
+      GmsV1Client client(std::move(peer.client)); client.Handshake(kUuid);
+      if (count < 0) { EXPECT_THROW(client.Allocate("id", 4096), std::runtime_error); }
+      else { EXPECT_THROW(client.Export("id"), std::runtime_error); }
+      client.Close(); peer.Finish();
+    }
+    EXPECT_EQ(DescriptorCount(), before) << "descriptor count " << count;
+  }
+}
+
+TEST(GmsV1Client, RejectsMalformedUnexpectedAndErrorResponses)
+{
+  const auto error = Packed("error_response", 2, [](auto& p) {
+    p.pack("message"); p.pack("fake allocation failure"); p.pack("out_of_memory"); p.pack(true);
+  });
+  const auto unknown = Packed("success_response", 1, [](auto& p) { p.pack("extra"); p.pack(1); });
+  const auto duplicate = Packed("success_response", 1, [](auto& p) { p.pack("type"); p.pack("success_response"); });
+  for (const auto& response : {error, unknown, duplicate, Packed("export_response"), std::string(1, '\xc1'), Packed("success_response") + "x"}) {
+    Peer peer([&](int fd) { Admit(fd); Request(fd, "allocate_request"); Reply(fd, response); });
+    GmsV1Client client(std::move(peer.client)); client.Handshake(kUuid);
+    EXPECT_THROW(client.Allocate("id", 4096), std::runtime_error);
+    EXPECT_THROW(client.Commit(), std::runtime_error);
+    client.Abort(); peer.Finish();
+  }
+}
+
+TEST(GmsV1Client, RejectsDuplicateInventoryIdsAndInvalidSizes)
+{
+  for (const bool duplicate : {false, true}) {
+    Peer peer([&](int fd) {
+      Admit(fd); Request(fd, "list_allocations_request");
+      Reply(fd, Packed("list_allocations_response", 1, [&](auto& p) {
+        p.pack("allocations"); p.pack_array(2);
+        for (int i = 0; i < 2; ++i) {
+          p.pack_map(2); p.pack("allocation_id"); p.pack(duplicate ? "same" : std::to_string(i));
+          p.pack("aligned_size"); p.pack(duplicate ? 4096 : -1);
+        }
+      }));
+    });
+    GmsV1Client client(std::move(peer.client)); client.Handshake(kUuid);
+    EXPECT_THROW(client.ListAllocations(), std::runtime_error);
+    client.Close(); peer.Finish();
+  }
+}
+
+TEST(GmsV1Client, RejectsOversizedTruncatedAndDeepFrames)
+{
+  for (int mode = 0; mode < 3; ++mode) {
+    Peer peer([&](int fd) {
+      Request(fd, "handshake_request");
+      if (mode == 2) {
+        std::string deep(32, '\x91'); deep += '\xc0'; Reply(fd, deep);
+      } else {
+        uint32_t size = htonl(mode == 0 ? (1U << 20) + 1 : 10);
+        SendBytes(fd, std::string(reinterpret_cast<char*>(&size), sizeof(size)));
+        if (mode == 1) { SendBytes(fd, "short"); shutdown(fd, SHUT_WR); }
+      }
+    });
+    GmsV1Client client(std::move(peer.client));
+    EXPECT_THROW(client.Handshake(kUuid), std::runtime_error);
+    client.Close(); peer.Finish();
+  }
+}
+
+TEST(GmsV1Client, WholeRpcDeadlineStopsSlowFragmentTrickleAndRetainsLeaseUntilClose)
+{
+  std::promise<void> may_finish;
+  auto finish = may_finish.get_future();
+  Peer peer([&](int fd) {
+    Request(fd, "handshake_request");
+    uint32_t length = htonl(100);
+    SendBytes(fd, std::string(reinterpret_cast<char*>(&length), sizeof(length)));
+    for (int i = 0; i < 3; ++i) { SendBytes(fd, "x"); std::this_thread::sleep_for(35ms); }
+    pollfd descriptor{fd, POLLIN, 0};
+    Check(poll(&descriptor, 1, 0) == 0);  // Failure has not closed/aborted the lease.
+    finish.wait();
+  });
+  GmsV1Client client(std::move(peer.client), 80ms);
+  const auto started = std::chrono::steady_clock::now();
+  EXPECT_THROW(client.Handshake(kUuid), std::runtime_error);
+  EXPECT_LT(std::chrono::steady_clock::now() - started, 500ms);
+  EXPECT_THROW(client.Commit(), std::runtime_error);
+  may_finish.set_value(); peer.Finish(); client.Close();
+}
+
+TEST(GmsV1Client, ExplicitAbortSendsAbortOnceAndThenCloses)
+{
+  Peer peer([](int fd) {
+    Admit(fd); Request(fd, "abort_request"); Reply(fd, Packed("success_response"));
+    char byte; Check(recv(fd, &byte, 1, 0) == 0);
+  });
+  GmsV1Client client(std::move(peer.client)); client.Handshake(kUuid); client.Abort(); client.Abort();
+  peer.Finish();
+}
+
+namespace {
+class PythonServer {
+ public:
+  PythonServer()
+  {
+    char directory[] = "/tmp/pb-gms-test-XXXXXX";
+    const char* made = mkdtemp(directory); Check(made != nullptr); root = made;
+    path = (root / "gms.sock").string();
+    pid_ = fork(); Check(pid_ >= 0);
+    if (!pid_) {
+      const char* python = std::getenv("GMS_V1_PYTHON"); if (!python) { python = "python3"; }
+      execlp(python, python, "gms_v1_client_mock.py", "--root", root.c_str(), nullptr);
+      _exit(127);
+    }
+    for (int i = 0; i < 300; ++i) {
+      std::ifstream(root / "identity") >> nonce;
+      if (!nonce.empty()) { return; }
+      std::this_thread::sleep_for(10ms);
+    }
+    kill(pid_, SIGKILL); waitpid(pid_, nullptr, 0); pid_ = -1;
+    throw std::runtime_error("Python GMS mock did not become ready");
+  }
+  ~PythonServer()
+  {
+    if (pid_ > 0) { kill(pid_, SIGTERM); waitpid(pid_, nullptr, 0); }
+    std::filesystem::remove_all(root);
+  }
+  FileDescriptor Connect()
+  {
+    FileDescriptor fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+    sockaddr_un address{}; address.sun_family = AF_UNIX;
+    Check(path.size() < sizeof(address.sun_path)); std::strcpy(address.sun_path, path.c_str());
+    Check(connect(fd.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0); return fd;
+  }
+  bool State(const std::string& expected)
+  {
+    for (int i = 0; i < 200; ++i) {
+      std::string state; std::getline(std::ifstream(root / "state"), state);
+      if (state == expected) { return true; }
+      std::this_thread::sleep_for(10ms);
+    }
+    return false;
+  }
+  std::filesystem::path root;
+  std::string path, nonce;
+ private:
+  pid_t pid_ = -1;
+};
+}  // namespace
+
+TEST(GmsV1Client, ActualPythonV1ProtocolAndServerFakeVmm)
+{
+  if (!std::getenv("GMS_V1_DYNAMO_ROOT")) { GTEST_SKIP() << "Set GMS_V1_DYNAMO_ROOT for actual Dynamo V1 interoperability"; }
+  PythonServer server;
+  const std::vector<GmsAllocationRecord> expected{{"captured-one", 2147483648ULL}, {"captured-two", 4294967296ULL}};
+  {
+    GmsV1Client client(server.Connect()); client.Handshake(kUuid, server.nonce);
+    for (const auto& record : expected) { client.Allocate(record.allocation_id, record.aligned_size); }
+    EXPECT_EQ(client.ListAllocations(), expected);
+    auto exported = client.Export(expected.front().allocation_id);
+    EXPECT_NE(fcntl(exported.get(), F_GETFD) & FD_CLOEXEC, 0);
+    client.Commit(); EXPECT_EQ(client.ListAllocations(), expected);
+  }
+  EXPECT_TRUE(server.State("1 2 2 0 0"));
+  {
+    GmsV1Client wrong(server.Connect()); EXPECT_THROW(wrong.Handshake(kUuid, "wrong-incarnation"), std::runtime_error);
+  }
+  EXPECT_TRUE(server.State("1 2 2 0 0"));
+  {
+    GmsV1Client client(server.Connect()); client.Handshake(kUuid, server.nonce);
+    EXPECT_TRUE(client.ListAllocations().empty());  // New RW replaces committed epoch.
+    client.Allocate("aborted", 4096); client.Abort();
+  }
+  EXPECT_TRUE(server.State("0 0 0 0 0"));
+  {
+    GmsV1Client client(server.Connect()); client.Handshake(kUuid, server.nonce);
+    client.Allocate("uncommitted", 4096);  // Destructor disconnect clears epoch.
+  }
+  EXPECT_TRUE(server.State("0 0 0 0 0"));
+  {
+    GmsV1Client client(server.Connect()); client.Handshake(kUuid, server.nonce);
+    client.Allocate("duplicate", 4096);
+    EXPECT_THROW(client.Allocate("duplicate", 4096), std::runtime_error);
+    client.Abort();
+  }
+  EXPECT_TRUE(server.State("0 0 0 0 0"));
+}
