new file mode 100644
index 00000000..23646270
--- /dev/null
+++ b/agent/pagebroker/gms_v1_client.cpp
@@ -0,0 +1,336 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "gms_v1_client.hpp"
+
+#include <msgpack.hpp>
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <climits>
+#include <cstring>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+
+namespace snapshot::pagebroker {
+namespace {
+constexpr size_t kMaxFrame = 1U << 20;
+using Clock = std::chrono::steady_clock;
+using Deadline = Clock::time_point;
+using Fields = std::map<std::string, msgpack::object>;
+
+[[noreturn]] void IoError(const char* operation)
+{
+  throw std::runtime_error(std::string("GMS ") + operation + ": " + std::strerror(errno));
+}
+
+void Wait(int fd, short events, Deadline deadline)
+{
+  for (;;) {
+    const auto remaining = std::chrono::ceil<std::chrono::milliseconds>(deadline - Clock::now()).count();
+    if (remaining <= 0) { throw std::runtime_error("GMS RPC deadline exceeded"); }
+    pollfd descriptor{fd, events, 0};
+    const int result = poll(&descriptor, 1, static_cast<int>(std::min<int64_t>(remaining, INT_MAX)));
+    if (result < 0 && errno == EINTR) { continue; }
+    if (result < 0) { IoError("poll"); }
+    if (result == 0) { continue; }
+    if (descriptor.revents & POLLNVAL) { throw std::runtime_error("GMS invalid socket"); }
+    if (descriptor.revents & (events | POLLERR | POLLHUP)) { return; }
+  }
+}
+
+void Send(int fd, const void* data, size_t length, Deadline deadline)
+{
+  const auto* bytes = static_cast<const char*>(data);
+  while (length) {
+    Wait(fd, POLLOUT, deadline);
+    const auto count = send(fd, bytes, length, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) { continue; }
+    if (count < 0) { IoError("send"); }
+    if (!count) { throw std::runtime_error("GMS send made no progress"); }
+    bytes += count;
+    length -= count;
+  }
+}
+
+void Receive(int fd, void* data, size_t length, Deadline deadline,
+             std::vector<FileDescriptor>& descriptors)
+{
+  auto* bytes = static_cast<char*>(data);
+  while (length) {
+    Wait(fd, POLLIN, deadline);
+    alignas(cmsghdr) std::array<char, CMSG_SPACE(16 * sizeof(int))> ancillary{};
+    iovec vector{bytes, length};
+    msghdr message{};
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.data();
+    message.msg_controllen = ancillary.size();
+    const auto count = recvmsg(fd, &message, MSG_CMSG_CLOEXEC | MSG_DONTWAIT);
+    if (count < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) { continue; }
+    if (count < 0) { IoError("recvmsg"); }
+    // Own all delivered descriptors before checking truncation or multiplicity.
+    // Linux closes descriptors omitted by MSG_CTRUNC; we close those delivered.
+    for (auto* header = CMSG_FIRSTHDR(&message); header; header = CMSG_NXTHDR(&message, header)) {
+      if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS) { continue; }
+      if (header->cmsg_len < CMSG_LEN(0) || (header->cmsg_len - CMSG_LEN(0)) % sizeof(int)) {
+        throw std::runtime_error("GMS malformed descriptor ancillary data");
+      }
+      const size_t size = header->cmsg_len - CMSG_LEN(0);
+      for (size_t offset = 0; offset < size; offset += sizeof(int)) {
+        int received = -1;
+        std::memcpy(&received, CMSG_DATA(header) + offset, sizeof(received));
+        descriptors.emplace_back(received);
+      }
+    }
+    if (message.msg_flags & (MSG_CTRUNC | MSG_TRUNC)) {
+      throw std::runtime_error("GMS truncated ancillary data or payload");
+    }
+    if (descriptors.size() > 1) { throw std::runtime_error("GMS received multiple descriptors"); }
+    if (!count) { throw std::runtime_error("GMS unexpected EOF"); }
+    bytes += count;
+    length -= count;
+  }
+}
+
+std::string String(const msgpack::object& object)
+{
+  if (object.type != msgpack::type::STR) { throw std::runtime_error("GMS expected string field"); }
+  return {object.via.str.ptr, object.via.str.size};
+}
+
+Fields Object(const msgpack::object& object)
+{
+  if (object.type != msgpack::type::MAP) { throw std::runtime_error("GMS expected map"); }
+  Fields result;
+  for (uint32_t i = 0; i < object.via.map.size; ++i) {
+    const auto& entry = object.via.map.ptr[i];
+    if (!result.emplace(String(entry.key), entry.val).second) {
+      throw std::runtime_error("GMS duplicate response field");
+    }
+  }
+  return result;
+}
+
+void Validate(const Fields& fields, std::initializer_list<const char*> required,
+              std::initializer_list<const char*> optional = {})
+{
+  std::set<std::string> allowed;
+  for (const auto* key : required) {
+    allowed.insert(key);
+    if (!fields.contains(key)) { throw std::runtime_error("GMS missing response field"); }
+  }
+  for (const auto* key : optional) { allowed.insert(key); }
+  for (const auto& [key, value] : fields) {
+    (void)value;
+    if (!allowed.contains(key)) { throw std::runtime_error("GMS unknown response field"); }
+  }
+}
+
+void Expected(const Fields& fields, const char* type)
+{
+  const auto found = fields.find("type");
+  if (found == fields.end() || String(found->second) != type) {
+    throw std::runtime_error("GMS unexpected response type");
+  }
+}
+
+template<class Fill>
+std::string Encode(const char* type, uint32_t fields, Fill fill)
+{
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(fields + 1);
+  packer.pack("type");
+  packer.pack(type);
+  fill(packer);
+  return {buffer.data(), buffer.size()};
+}
+
+std::string Encode(const char* type)
+{
+  return Encode(type, 0, [](auto&) {});
+}
+}  // namespace
+
+struct GmsV1Client::Reply {
+  msgpack::object_handle object;
+  FileDescriptor fd{-1};
+  Fields fields;
+};
+
+GmsV1Client::GmsV1Client(FileDescriptor connected_socket, std::chrono::milliseconds rpc_timeout)
+    : socket_(std::move(connected_socket)), timeout_(rpc_timeout)
+{
+  if (socket_.get() < 0 || timeout_.count() <= 0) {
+    throw std::invalid_argument("GMS requires a connected socket and positive RPC timeout");
+  }
+  const int flags = fcntl(socket_.get(), F_GETFD);
+  if (flags < 0 || fcntl(socket_.get(), F_SETFD, flags | FD_CLOEXEC) < 0) { IoError("fcntl"); }
+}
+
+GmsV1Client::~GmsV1Client() noexcept { Close(); }
+
+void GmsV1Client::Close() noexcept
+{
+  socket_ = FileDescriptor(-1);
+  state_ = State::Closed;
+}
+
+void GmsV1Client::Require(State state) const
+{
+  if (failed_ || state_ != state || socket_.get() < 0) {
+    throw std::runtime_error("GMS client is disconnected, failed, or in the wrong lease state");
+  }
+}
+
+GmsV1Client::Reply GmsV1Client::Exchange(const std::string& payload)
+{
+  if (payload.empty() || payload.size() > kMaxFrame) { throw std::runtime_error("GMS invalid request size"); }
+  const auto deadline = Clock::now() + timeout_;
+  uint32_t length = htonl(static_cast<uint32_t>(payload.size()));
+  Send(socket_.get(), &length, sizeof(length), deadline);
+  Send(socket_.get(), payload.data(), payload.size(), deadline);
+  std::vector<FileDescriptor> descriptors;
+  Receive(socket_.get(), &length, sizeof(length), deadline, descriptors);
+  length = ntohl(length);
+  if (!length || length > kMaxFrame) { throw std::runtime_error("GMS invalid response frame size"); }
+  std::string response(length, '\0');
+  Receive(socket_.get(), response.data(), response.size(), deadline, descriptors);
+  Reply reply;
+  size_t offset = 0;
+  try {
+    reply.object = msgpack::unpack(response.data(), response.size(), offset, nullptr, nullptr,
+                                  msgpack::unpack_limit(65536, 16, kMaxFrame, 0, 0, 8));
+  } catch (const std::exception&) {
+    throw std::runtime_error("GMS invalid MessagePack response");
+  }
+  if (offset != response.size()) { throw std::runtime_error("GMS trailing MessagePack data"); }
+  if (!descriptors.empty()) { reply.fd = std::move(descriptors.front()); }
+  reply.fields = Object(reply.object.get());
+  const auto type = reply.fields.find("type");
+  if (type == reply.fields.end()) { throw std::runtime_error("GMS missing response type"); }
+  if (String(type->second) == "error_response") {
+    Validate(reply.fields, {"type", "message"}, {"out_of_memory"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS error response carried descriptor"); }
+    if (reply.fields.contains("out_of_memory") &&
+        reply.fields.at("out_of_memory").type != msgpack::type::BOOLEAN) {
+      throw std::runtime_error("GMS invalid out_of_memory field");
+    }
+    throw std::runtime_error("GMS server error: " + String(reply.fields.at("message")));
+  }
+  return reply;
+}
+
+void GmsV1Client::Handshake(const std::string& expected_uuid, const std::string& expected_nonce)
+{
+  Require(State::New);
+  try {
+    if (expected_uuid.empty()) { throw std::invalid_argument("GMS expected GPU UUID is required"); }
+    auto reply = Exchange(Encode("handshake_request", 2, [&](auto& packer) {
+      packer.pack("lock_type"); packer.pack("rw");
+      packer.pack("expected_identity");
+      if (expected_nonce.empty()) { packer.pack_nil(); }
+      else { packer.pack_array(2); packer.pack(expected_nonce); packer.pack(expected_uuid); }
+    }));
+    Expected(reply.fields, "handshake_response");
+    Validate(reply.fields, {"type", "lock_type", "server_nonce", "gpu_uuid"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS handshake carried descriptor"); }
+    server_nonce_ = String(reply.fields.at("server_nonce"));
+    gpu_uuid_ = String(reply.fields.at("gpu_uuid"));
+    if (String(reply.fields.at("lock_type")) != "rw" || gpu_uuid_ != expected_uuid ||
+        server_nonce_.empty() || (!expected_nonce.empty() && server_nonce_ != expected_nonce)) {
+      throw std::runtime_error("GMS handshake lease, GPU UUID, or server nonce mismatch");
+    }
+    state_ = State::Writer;
+  } catch (...) { failed_ = true; throw; }
+}
+
+void GmsV1Client::Allocate(const std::string& allocation_id, uint64_t aligned_size)
+{
+  Require(State::Writer);
+  try {
+    if (allocation_id.empty() || !aligned_size) { throw std::invalid_argument("GMS allocation ID and size are required"); }
+    auto reply = Exchange(Encode("allocate_request", 2, [&](auto& packer) {
+      packer.pack("allocation_id"); packer.pack(allocation_id);
+      packer.pack("aligned_size"); packer.pack(aligned_size);
+    }));
+    Expected(reply.fields, "success_response");
+    Validate(reply.fields, {"type"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS allocate carried descriptor"); }
+  } catch (...) { failed_ = true; throw; }
+}
+
+FileDescriptor GmsV1Client::Export(const std::string& allocation_id)
+{
+  if (state_ != State::Writer && state_ != State::Reader) { Require(State::Writer); }
+  Require(state_);
+  try {
+    if (allocation_id.empty()) { throw std::invalid_argument("GMS allocation ID is required"); }
+    auto reply = Exchange(Encode("export_request", 1, [&](auto& packer) {
+      packer.pack("allocation_id"); packer.pack(allocation_id);
+    }));
+    Expected(reply.fields, "export_response");
+    Validate(reply.fields, {"type"});
+    if (reply.fd.get() < 0) { throw std::runtime_error("GMS export missing descriptor"); }
+    return std::move(reply.fd);
+  } catch (...) { failed_ = true; throw; }
+}
+
+std::vector<GmsAllocationRecord> GmsV1Client::ListAllocations()
+{
+  if (state_ != State::Writer && state_ != State::Reader) { Require(State::Writer); }
+  Require(state_);
+  try {
+    auto reply = Exchange(Encode("list_allocations_request"));
+    Expected(reply.fields, "list_allocations_response");
+    Validate(reply.fields, {"type", "allocations"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS inventory carried descriptor"); }
+    const auto& array = reply.fields.at("allocations");
+    if (array.type != msgpack::type::ARRAY) { throw std::runtime_error("GMS invalid inventory array"); }
+    std::vector<GmsAllocationRecord> result;
+    std::set<std::string> ids;
+    for (uint32_t i = 0; i < array.via.array.size; ++i) {
+      auto record = Object(array.via.array.ptr[i]);
+      Validate(record, {"allocation_id", "aligned_size"});
+      auto id = String(record.at("allocation_id"));
+      const auto& size = record.at("aligned_size");
+      if (id.empty() || !ids.insert(id).second || size.type != msgpack::type::POSITIVE_INTEGER || !size.via.u64) {
+        throw std::runtime_error("GMS invalid or duplicate allocation record");
+      }
+      result.push_back({std::move(id), size.via.u64});
+    }
+    return result;
+  } catch (...) { failed_ = true; throw; }
+}
+
+void GmsV1Client::Commit()
+{
+  Require(State::Writer);
+  try {
+    auto reply = Exchange(Encode("commit_request"));
+    Expected(reply.fields, "success_response");
+    Validate(reply.fields, {"type"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS commit carried descriptor"); }
+    state_ = State::Reader;
+  } catch (...) { failed_ = true; throw; }
+}
+
+void GmsV1Client::Abort()
+{
+  if (failed_ || state_ != State::Writer) { Close(); return; }
+  try {
+    auto reply = Exchange(Encode("abort_request"));
+    Expected(reply.fields, "success_response");
+    Validate(reply.fields, {"type"});
+    if (reply.fd.get() >= 0) { throw std::runtime_error("GMS abort carried descriptor"); }
+    Close();
+  } catch (...) { failed_ = true; Close(); throw; }
+}
+}  // namespace snapshot::pagebroker
