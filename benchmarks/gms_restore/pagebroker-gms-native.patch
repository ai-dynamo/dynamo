+  ExpectRejected(request_, "version invalid");
+  SaveManifest("{\"version\":1,\"allocations\":[{\"allocation_id\":\"a\",\"aligned_size\":9007199254740992,\"shard\":\"shards/weights.bin\",\"offset\":0}]}");
+  ExpectRejected(request_, "invalid integer");
