+
+TEST_F(GmsAdmissionTest, BrokerRetainsFailedAdmissionWithoutDestructiveRetry) {
+  Listen();
+  std::ofstream(artifact_ / "fail-gms") << '1';
+  Broker broker(root_ / "staging", root_ / "storage", fs::absolute("build/fake-gms-gpu-engine"));
+  broker.StartGpuEngine();
+  const auto first = broker.HandleRequest(Envelope());
+  ASSERT_TRUE(first.has_failure());
+  fs::remove(artifact_ / "fail-gms");
+  const auto retry = broker.HandleRequest(Envelope("retry"));
+  ASSERT_TRUE(retry.has_failure());
+  EXPECT_EQ(retry.failure().message(), first.failure().message());
+  EXPECT_EQ(Calls(), 1u);
+  const auto different_transaction = broker.HandleRequest(Envelope("other", "transaction-2"));
+  ASSERT_TRUE(different_transaction.has_failure());
+  EXPECT_EQ(different_transaction.failure().code(), v1::Failure::TRANSACTION_CONFLICT);
+  EXPECT_EQ(Calls(), 1u);
+}
+
+TEST_F(GmsAdmissionTest, BrokerConnectionFailureIsStickyEvenIfEndpointAppears) {
+  Broker broker(root_ / "staging", root_ / "storage", fs::absolute("build/fake-gms-gpu-engine"));
+  broker.StartGpuEngine();
+  const auto first = broker.HandleRequest(Envelope());
+  ASSERT_TRUE(first.has_failure());
+  EXPECT_NE(first.failure().message().find("connect GMS endpoint"), std::string::npos);
+  Listen();
+  const auto retry = broker.HandleRequest(Envelope("retry"));
+  ASSERT_TRUE(retry.has_failure());
+  EXPECT_EQ(retry.failure().message(), first.failure().message());
+  EXPECT_EQ(Calls(), 0u);
+}
