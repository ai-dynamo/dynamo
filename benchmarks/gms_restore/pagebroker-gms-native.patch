+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace snapshot::pagebroker {
+// A rank releases its ring after every shard. FIFO admission prevents the next
+// shard from overtaking a native residual transfer already waiting for the GPU.
+class FairTransferMutex {
+ public:
+  void lock() {
+    std::unique_lock lock(mutex_);
+    const auto ticket = next_++;
+    changed_.wait(lock, [&] { return ticket == serving_; });
+    held_ = true;
+  }
+  void unlock() {
+    {
+      std::lock_guard lock(mutex_);
+      held_ = false;
+      ++serving_;
+    }
+    changed_.notify_all();
+  }
+  size_t waiters() {
+    std::lock_guard lock(mutex_);
+    return next_ - serving_ - (held_ ? 1 : 0);
+  }
+ private:
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  uint64_t next_ = 0;
+  uint64_t serving_ = 0;
+  bool held_ = false;
+};
+}  // namespace snapshot::pagebroker
