+  ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets), 0);
+  FileDescriptor gms(sockets[0]), server(sockets[1]);
+  FileDescriptor source(open(directory, O_DIRECTORY | O_CLOEXEC));
+  v1::LoadGmsWeightsRequest request;
+  request.set_rank(7);
+  auto connection = engine.LoadGms(request, source.get(), gms.get());
+  v1::NativeSessionReply reply;
+  std::vector<FileDescriptor> descriptors;
+  ASSERT_TRUE(ReceiveFrame(connection.get(), reply, descriptors));
+  EXPECT_TRUE(descriptors.empty());
+  EXPECT_EQ(reply.report(), "gms-loaded");
+  char marker[13]{};
+  EXPECT_EQ(read(server.get(), marker, sizeof(marker)), 13);
+  EXPECT_STREQ(marker, "gms-fd-probe");
+  int rank = -1;
+  std::ifstream(std::filesystem::path(directory) / "gms-rank") >> rank;
+  EXPECT_EQ(rank, 7);
+  engine.Stop();
+  std::filesystem::remove_all(directory);
+}
