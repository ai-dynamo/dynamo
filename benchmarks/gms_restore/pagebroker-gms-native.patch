+namespace snapshot::pagebroker {
+struct GmsShardSource {
+  FileDescriptor file;
+  std::string path;
+  size_t size;
+  std::vector<const v1::GmsAllocation*> allocations;
+};
+// Validates the manifest shape and pins every exact O_DIRECT source file before
+// an RW lease can mutate GMS. Allocation pointers borrow the immutable request.
+std::vector<GmsShardSource> ValidateGmsSources(
