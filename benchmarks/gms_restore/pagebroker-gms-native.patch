+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "fair_transfer_mutex.hpp"
+#include <gtest/gtest.h>
+#include <chrono>
+#include <future>
+#include <thread>
+#include <vector>
+
+namespace snapshot::pagebroker {
+TEST(FairTransferMutexTest, NextShardCannotOvertakeQueuedNativeTransfer) {
+  FairTransferMutex ring;
+  std::vector<int> order;
+  ring.lock();  // The current GMS shard is transferring.
+  auto native = std::async(std::launch::async, [&] {
+    std::lock_guard lease(ring);
+    order.push_back(1);
+  });
+  auto await_waiters = [&](size_t count) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    while (ring.waiters() != count && std::chrono::steady_clock::now() < deadline)
+      std::this_thread::yield();
+    return ring.waiters() == count;
+  };
+  const bool native_queued = await_waiters(1);
+  auto next_shard = std::async(std::launch::async, [&] {
+    std::lock_guard lease(ring);
+    order.push_back(2);
+  });
+  const bool both_queued = await_waiters(2);
+  ring.unlock();
+  native.get();
+  next_shard.get();
+  EXPECT_TRUE(native_queued);
+  EXPECT_TRUE(both_queued);
+  EXPECT_EQ(order, (std::vector<int>{1, 2}));
+  EXPECT_EQ(ring.waiters(), 0U);
+}
+}  // namespace snapshot::pagebroker
