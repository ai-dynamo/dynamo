+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "gms_load_layout.hpp"
+#include <gtest/gtest.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <filesystem>
+
+namespace snapshot::pagebroker {
+namespace {
+class GmsLayoutTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    char pattern[] = "/tmp/pagebroker-gms-layout-XXXXXX";
+    auto* made = mkdtemp(pattern);
+    ASSERT_NE(made, nullptr);
+    path = made;
+    std::filesystem::create_directory(path / "shards");
+    directory = FileDescriptor(open(path.c_str(), O_DIRECTORY | O_CLOEXEC));
+    ASSERT_GE(directory.get(), 0);
+    FileDescriptor file(open((path / "shards/data.bin").c_str(), O_CREAT | O_RDWR | O_CLOEXEC, 0600));
+    ASSERT_GE(file.get(), 0);
+    ASSERT_EQ(ftruncate(file.get(), 8192), 0);
+    request.set_capture_id("capture");
+    request.set_generation("generation");
+    request.set_expected_server_nonce("nonce");
+    // Intentionally reverse manifest order; offset governs the imported VA.
+    Add("second", 4096, 4096);
+    Add("first", 4096, 0);
+  }
+  void TearDown() override { std::filesystem::remove_all(path); }
+  void Add(const std::string& id, uint64_t size, uint64_t offset) {
+    auto* allocation = request.add_allocations();
+    allocation->set_allocation_id(id);
+    allocation->set_aligned_size(size);
+    allocation->set_offset(offset);
+    allocation->set_shard("shards/data.bin");
+  }
+  auto Validate() {
+    std::map<std::string, uint64_t> expected;
+    size_t bytes = 0;
+    return ValidateGmsSources(request, directory.get(), 4096, &expected, &bytes);
+  }
+  std::filesystem::path path;
+  FileDescriptor directory{-1};
+  v1::LoadGmsWeightsRequest request;
+};
+
+TEST_F(GmsLayoutTest, ContiguousAllocationsBecomeOneWholeFileWithDirectIO) {
+  std::map<std::string, uint64_t> expected;
+  size_t bytes = 0;
+  auto sources = ValidateGmsSources(request, directory.get(), 4096, &expected, &bytes);
+  ASSERT_EQ(sources.size(), 1U);
+  EXPECT_EQ(sources[0].size, 8192U);
+  EXPECT_EQ(bytes, 8192U);
+  EXPECT_EQ(expected.size(), 2U);
+  EXPECT_EQ(sources[0].allocations[0]->allocation_id(), "first");
+  EXPECT_EQ(sources[0].allocations[1]->offset(), 4096U);
+  EXPECT_TRUE(fcntl(sources[0].file.get(), F_GETFL) & O_DIRECT);
+}
+TEST_F(GmsLayoutTest, RejectsDuplicateCapturedAllocationID) {
+  request.mutable_allocations(0)->set_allocation_id("first");
+  EXPECT_THROW(Validate(), std::runtime_error);
+}
+TEST_F(GmsLayoutTest, RejectsGapsOverlapsAndUnalignedSizes) {
+  request.mutable_allocations(0)->set_offset(8192);
+  EXPECT_THROW(Validate(), std::runtime_error);
+  request.mutable_allocations(0)->set_offset(0);
+  EXPECT_THROW(Validate(), std::runtime_error);
+  request.mutable_allocations(0)->set_offset(4096);
+  request.mutable_allocations(0)->set_aligned_size(4095);
+  EXPECT_THROW(Validate(), std::runtime_error);
+}
+TEST_F(GmsLayoutTest, RejectsFilesLongerOrShorterThanCapturedExtents) {
+  FileDescriptor file(open((path / "shards/data.bin").c_str(), O_RDWR));
+  ASSERT_EQ(ftruncate(file.get(), 12288), 0);
+  EXPECT_THROW(Validate(), std::runtime_error);
+  ASSERT_EQ(ftruncate(file.get(), 4096), 0);
+  EXPECT_THROW(Validate(), std::runtime_error);
+}
+TEST_F(GmsLayoutTest, RejectsTraversalAndIntermediateSymlinks) {
+  for (const std::string name : {"../data.bin", "/data.bin", "shards//data.bin", "./shards/data.bin"}) {
+    for (auto& allocation : *request.mutable_allocations()) allocation.set_shard(name);
+    EXPECT_THROW(Validate(), std::runtime_error);
+  }
+  std::filesystem::create_directory_symlink(path / "shards", path / "alias");
+  for (auto& allocation : *request.mutable_allocations()) allocation.set_shard("alias/data.bin");
+  EXPECT_THROW(Validate(), std::runtime_error);
+}
+TEST_F(GmsLayoutTest, RejectsFinalSymlinkAndMissingServerIncarnation) {
+  std::filesystem::create_symlink(path / "shards/data.bin", path / "alias.bin");
+  for (auto& allocation : *request.mutable_allocations()) allocation.set_shard("alias.bin");
+  EXPECT_THROW(Validate(), std::runtime_error);
+  for (auto& allocation : *request.mutable_allocations()) allocation.set_shard("shards/data.bin");
+  request.clear_expected_server_nonce();
+  EXPECT_THROW(Validate(), std::runtime_error);
+}
