index 00000000..dfdc4120
--- /dev/null
+++ b/agent/pagebroker/gms_load_operation.cpp
@@ -0,0 +1,225 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#include "gms_load_operation.hpp"
+#include "gms_v1_client.hpp"
+#include "gms_load_layout.hpp"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <iostream>
+#include <limits>
+#include <map>
+#include <memory>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <syncstream>
+
+namespace snapshot::pagebroker {
+namespace {
+using Clock = std::chrono::steady_clock;
+void Require(bool ok, const char* message) {
+  if (!ok) throw std::runtime_error(message);
+}
+void Check(CUresult result, const char* operation) {
+  if (result == CUDA_SUCCESS) return;
+  const char* name = nullptr;
+  cuGetErrorName(result, &name);
+  throw std::runtime_error(std::string(operation) + ": " + (name ? name : "unknown CUDA error"));
+}
+void DrainCheck(CUresult result, const char* operation) noexcept {
+  if (result == CUDA_SUCCESS) return;
+  // Never release the V1 lease while imported memory or DMA has an unknown
+  // lifetime. As with native sessions, engine death is the failure boundary.
+  std::fprintf(stderr, "GMS CUDA cleanup failed: %s\n", operation);
+  std::_Exit(1);
+}
+double Seconds(Clock::time_point start) {
+  return std::chrono::duration<double>(Clock::now() - start).count();
+}
+std::string Quote(const std::string& text) {
+  std::string out = "\"";
+  constexpr char hex[] = "0123456789abcdef";
+  for (const unsigned char c : text) {
+    if (c == '\\' || c == '"') { out += '\\'; out += c; }
+    else if (c < 32) { out += "\\u00"; out += hex[c >> 4]; out += hex[c & 15]; }
+    else out += c;
+  }
+  return out + '"';
+}
+class Trace {
+ public:
+  explicit Trace(const v1::LoadGmsWeightsRequest& request) : request_(request) {}
+  void Emit(const char* phase, const std::string& extra = "") const {
+    const auto epoch = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    std::osyncstream(std::cerr) << "{\"event\":\"gms_load_phase\",\"phase\":" << Quote(phase)
+      << ",\"capture_id\":" << Quote(request_.capture_id())
+      << ",\"generation\":" << Quote(request_.generation()) << ",\"rank\":" << request_.rank()
+      << ",\"destination_uuid\":" << Quote(request_.destination_uuid())
+      << ",\"epoch_ns\":" << epoch << ",\"elapsed_seconds\":" << Seconds(start_) << extra << "}\n";
+  }
+  double Elapsed() const { return Seconds(start_); }
+ private:
+  const v1::LoadGmsWeightsRequest& request_;
+  Clock::time_point start_ = Clock::now();
+};
+
+
+struct Reservation {
+  CUdeviceptr base = 0;
+  size_t size = 0;
+  ~Reservation() {
+    if (base) DrainCheck(cuMemAddressFree(base, size), "free shard VA");
+  }
+};
+struct Mapping {
+  CUmemGenericAllocationHandle handle = 0;
+  CUdeviceptr base = 0;
+  size_t size = 0;
+  bool mapped = false;
+  ~Mapping() {
+    if (mapped) DrainCheck(cuMemUnmap(base, size), "unmap GMS allocation");
+    if (handle) DrainCheck(cuMemRelease(handle), "release imported GMS handle");
+  }
+};
+struct Shard : GmsShardSource {
+  explicit Shard(GmsShardSource source) : GmsShardSource(std::move(source)) {}
+  // Destruction order: unmap every handle before freeing the VA reservation.
+  Reservation reservation;
+  std::vector<std::unique_ptr<Mapping>> mappings;
+};
+struct Stream {
+  CUstream value = nullptr;
+  ~Stream() {
+    if (!value) return;
+    DrainCheck(cuStreamSynchronize(value), "drain GMS stream");
+    DrainCheck(cuStreamDestroy(value), "destroy GMS stream");
+  }
+};
+
+
+}  // namespace
+
+std::string LoadGmsWeights(const v1::LoadGmsWeightsRequest& request,
+                           FileDescriptor directory, FileDescriptor socket,
+                           GmsTransferDevice device) {
+  const Trace trace(request);
+  const auto deadline = Clock::now() + std::chrono::seconds(request.timeout_seconds() ? request.timeout_seconds() : 300);
+  auto check_deadline = [&] { Require(Clock::now() < deadline, "GMS load deadline exceeded"); };
+  Require(request.destination_uuid() == device.uuid, "GMS load GPU UUID mismatch");
+  struct stat directory_info{};
+  Require(!fstat(directory.get(), &directory_info) && S_ISDIR(directory_info.st_mode), "GMS source is not a directory");
+  Check(cuCtxSetCurrent(device.context), "set GMS engine context");
+  CUmemAllocationProp properties{};
+  properties.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+  properties.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+  properties.location.id = device.device;
+  properties.requestedHandleTypes = CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR;
+  size_t granularity = 0;
+  Check(cuMemGetAllocationGranularity(&granularity, &properties, CU_MEM_ALLOC_GRANULARITY_MINIMUM), "get GMS allocation granularity");
+  Require(granularity > 0, "invalid GMS allocation granularity");
+
+  // Construct the lease before mappings and the stream last: every exit drains
+  // CUDA, unmaps imports, and only then closes/aborts the server lease.
+  GmsV1Client client(std::move(socket));
+  std::map<std::string, uint64_t> expected;
+  size_t bytes = 0;
+  auto sources = ValidateGmsSources(request, directory.get(), granularity, &expected, &bytes);
+  std::vector<std::unique_ptr<Shard>> shards;
+  for (auto& source : sources) shards.push_back(std::make_unique<Shard>(std::move(source)));
+  Stream stream;
+  Check(cuStreamCreate(&stream.value, CU_STREAM_NON_BLOCKING), "create GMS stream");
+  trace.Emit("validated", ",\"bytes\":" + std::to_string(bytes) + ",\"shards\":" + std::to_string(shards.size()));
+  check_deadline();
+  trace.Emit("lease_start");
+  client.Handshake(request.destination_uuid(), request.expected_server_nonce());
+  trace.Emit("lease_acquired");
+  trace.Emit("allocation_import_start");
+  for (auto& shard : shards) {
+    shard->reservation.size = shard->size;
+    Check(cuMemAddressReserve(&shard->reservation.base, shard->size, granularity, 0, 0), "reserve GMS shard VA");
+    for (const auto* allocation : shard->allocations) {
+      check_deadline();
+      client.Allocate(allocation->allocation_id(), allocation->aligned_size());
+      auto fd = client.Export(allocation->allocation_id());
+      auto mapping = std::make_unique<Mapping>();
+      mapping->base = shard->reservation.base + allocation->offset();
+      mapping->size = allocation->aligned_size();
+      Check(cuMemImportFromShareableHandle(&mapping->handle, reinterpret_cast<void*>(static_cast<intptr_t>(fd.get())),
+                                         CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR), "import GMS allocation FD");
+      fd = FileDescriptor(-1);
+      CUmemAllocationProp imported{};
+      Check(cuMemGetAllocationPropertiesFromHandle(&imported, mapping->handle), "inspect imported GMS allocation");
+      Require(imported.location.type == CU_MEM_LOCATION_TYPE_DEVICE && imported.location.id == device.device,
+              "imported GMS allocation belongs to another GPU");
+      Check(cuMemMap(mapping->base, mapping->size, 0, mapping->handle, 0), "map GMS allocation");
+      mapping->mapped = true;
+      CUmemAccessDesc access{};
+      access.location = properties.location;
+      access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+      Check(cuMemSetAccess(mapping->base, mapping->size, &access, 1), "enable GMS write access");
+      shard->mappings.push_back(std::move(mapping));
+    }
+  }
+  trace.Emit("allocation_import_complete");
+  double queue_seconds = 0, transfer_seconds = 0, storage_seconds = 0, cuda_wait_seconds = 0;
+  for (auto& shard : shards) {
+    check_deadline();
+    const std::string fields = ",\"shard\":" + Quote(shard->path) + ",\"bytes\":" + std::to_string(shard->size);
+    trace.Emit("ring_queue_start", fields);
+    const auto queued = Clock::now();
+    {
+      std::lock_guard lease(device.mutex);
+      const double wait = Seconds(queued);
+      queue_seconds += wait;
+      check_deadline();
+      trace.Emit("ring_acquired", fields + ",\"queue_seconds\":" + std::to_string(wait));
+      trace.Emit("read_copy_start", fields + ",\"o_direct\":true");
+      cuda::TransferMetrics metrics;
+      std::string error;
+      // Whole-file reads into adjacent imported allocations preserve the exact
+      // qualified 32-slot NIXL/POSIX/CUDA data path and its drain guarantee.
+      if (!device.buffers.Transfer(shard->file.get(), shard->reservation.base, shard->size, stream.value,
+                                   cuda::TransferOperation::kRestore, &metrics, &error))
+        throw std::runtime_error(error);
+      Require(metrics.bytes == shard->size, "incomplete GMS shard transfer");
+      transfer_seconds += metrics.total_seconds;
+      storage_seconds += metrics.storage_io_seconds;
+      cuda_wait_seconds += metrics.cuda_wait_seconds;
+      trace.Emit("read_copy_complete", fields + ",\"transfer_seconds\":" + std::to_string(metrics.total_seconds) +
+                 ",\"storage_request_service_seconds\":" + std::to_string(metrics.storage_io_seconds) +
+                 ",\"cuda_wait_seconds\":" + std::to_string(metrics.cuda_wait_seconds));
+    }
+  }
+  Check(cuStreamSynchronize(stream.value), "drain GMS copies before publication");
+  trace.Emit("copies_drained");
+  shards.clear();
+  trace.Emit("imports_released");
+  check_deadline();
+  std::map<std::string, uint64_t> actual;
+  for (const auto& allocation : client.ListAllocations())
+    Require(actual.emplace(allocation.allocation_id, allocation.aligned_size).second, "duplicate server GMS allocation ID");
+  Require(actual == expected, "GMS server allocation IDs or sizes differ from the capture");
+  trace.Emit("commit_start");
+  client.Commit();
+  const auto committed_epoch = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+  trace.Emit("committed", ",\"bytes\":" + std::to_string(bytes));
+  std::ostringstream report;
+  report << "{\"event\":\"gms_weights_loaded\",\"capture_id\":" << Quote(request.capture_id())
+    << ",\"generation\":" << Quote(request.generation()) << ",\"rank\":" << request.rank()
+    << ",\"destination_uuid\":" << Quote(device.uuid)
+    << ",\"server_nonce\":" << Quote(client.server_nonce())
+    << ",\"manifest_sha256\":" << Quote(request.manifest_sha256())
+    << ",\"committed_epoch_ns\":" << committed_epoch << ",\"bytes\":" << bytes
+    << ",\"allocations\":" << expected.size() << ",\"queue_wait_seconds\":" << queue_seconds
+    << ",\"transfer_seconds\":" << transfer_seconds << ",\"storage_request_service_seconds\":" << storage_seconds
+    << ",\"cuda_wait_seconds\":" << cuda_wait_seconds << ",\"total_seconds\":" << trace.Elapsed() << "}";
+  return report.str();
+}
+}  // namespace snapshot::pagebroker
