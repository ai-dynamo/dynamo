@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "file_descriptor.hpp"
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace snapshot::pagebroker {
+
+struct GmsAllocationRecord {
+  std::string allocation_id;
+  uint64_t aligned_size;
+  bool operator==(const GmsAllocationRecord&) const = default;
+};
+
+// One exclusive V1 weights lease over an already-connected AF_UNIX stream.
+// No reconnect: acquiring a new RW lease clears the server's allocation epoch.
+// Construct this before GPU mapping resources so their destruction/drain occurs
+// before the socket closes. A failed RPC latches the client unusable, retaining
+// its lease until the caller drains GPU work and calls Close/Abort or destroys it.
+class GmsV1Client {
+ public:
+  explicit GmsV1Client(FileDescriptor connected_socket,
+                       std::chrono::milliseconds rpc_timeout = std::chrono::seconds(30));
+  ~GmsV1Client() noexcept;
+  GmsV1Client(const GmsV1Client&) = delete;
+  GmsV1Client& operator=(const GmsV1Client&) = delete;
+  GmsV1Client(GmsV1Client&&) noexcept = default;
+  GmsV1Client& operator=(GmsV1Client&&) = delete;
+
+  // A nonempty current server nonce fences incarnation/UUID before RW admission.
+  // An empty nonce discovers this new server's identity, then checks its UUID.
+  void Handshake(const std::string& expected_uuid, const std::string& expected_nonce = "");
+  void Allocate(const std::string& allocation_id, uint64_t aligned_size);
+  FileDescriptor Export(const std::string& allocation_id);
+  std::vector<GmsAllocationRecord> ListAllocations();
+  // Caller must synchronize every GPU transfer and drop writable mappings first.
+  void Commit();
+  // Caller must drain/unmap before abort/close. Broken wires are closed without RPC.
+  void Abort();
+  void Close() noexcept;
+  const std::string& server_nonce() const noexcept { return server_nonce_; }
+  const std::string& gpu_uuid() const noexcept { return gpu_uuid_; }
+
+ private:
+  enum class State { New, Writer, Reader, Closed };
+  struct Reply;
+  Reply Exchange(const std::string& payload);
+  void Require(State state) const;
+
+  FileDescriptor socket_;
+  std::chrono::milliseconds timeout_;
+  State state_ = State::New;
+  bool failed_ = false;
+  std::string server_nonce_;
+  std::string gpu_uuid_;
+};
+
+}  // namespace snapshot::pagebroker
