+void ServeGmsSession(Engine& engine, v1::LoadGmsWeightsRequest request,
+                     FileDescriptor connection, FileDescriptor directory, FileDescriptor gms) {
+  v1::NativeSessionReply reply;
+  try {
+    Device* selected = nullptr;
+    for (const auto& [context, device] : engine.devices) {
+      if (device->uuid != request.destination_uuid()) continue;
+      Require(selected == nullptr, "ambiguous GMS destination GPU");
+      selected = device.get();
+    }
+    Require(selected != nullptr, "GMS destination GPU is not available in the persistent engine");
+    reply.set_report(LoadGmsWeights(request, std::move(directory), std::move(gms),
+        {selected->device, selected->context, selected->uuid, selected->buffers, selected->mutex}));
+  } catch (const std::exception& error) {
+    // LoadGmsWeights unwinds the stream/mappings before closing its RW lease.
+    // Unknown drain outcomes are engine-fatal and never reach this reply.
+    reply.mutable_failure()->set_code(v1::Failure::INTERNAL_ERROR);
+    reply.mutable_failure()->set_message(error.what());
+  }
+  try { SendFrame(connection.get(), reply); } catch (const std::exception&) {}
+}
