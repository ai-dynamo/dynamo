@@ -0,0 +1,327 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "broker.hpp"
+#include "gms_admission.hpp"
+#include "integrity/content_digest.hpp"
+
+#include <gtest/gtest.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <future>
+#include <sstream>
+#include <thread>
+
+namespace snapshot::pagebroker {
+namespace {
+namespace fs = std::filesystem;
+
+class GmsAdmissionTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    char path[] = "/tmp/pb-gms-admit-XXXXXX";
+    ASSERT_NE(mkdtemp(path), nullptr);
+    root_ = path;
+    artifact_ = root_ / "storage" / "artifact";
+    fs::create_directories(artifact_ / "shards");
+    std::ofstream(artifact_ / "shards" / "weights.bin") << std::string(12288, 'w');
+    request_.set_capture_id("capture-A");
+    request_.set_generation("restore-generation-A");
+    request_.set_rank(1);
+    request_.set_destination_uuid("GPU-10000000-0000-0000-0000-000000000001");
+    request_.set_expected_server_nonce("server-incarnation-A");
+    request_.set_socket_path((root_ / "gms.sock").string());
+    request_.set_artifact_directory(artifact_.string());
+    request_.set_timeout_seconds(5);
+    auto* a = request_.add_allocations();
+    a->set_allocation_id("captured-allocation-a");
+    a->set_aligned_size(4096);
+    a->set_shard("shards/weights.bin");
+    a = request_.add_allocations();
+    a->set_allocation_id("captured-allocation-b");
+    a->set_aligned_size(8192);
+    a->set_offset(4096);
+    a->set_shard("shards/weights.bin");
+    SaveMatchingManifest();
+    directory_ = FileDescriptor(open(artifact_.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    ASSERT_GE(directory_.get(), 0);
+  }
+
+  void TearDown() override { fs::remove_all(root_); }
+
+  void SaveManifest(const std::string& bytes) {
+    std::ofstream(artifact_ / "manifest.json", std::ios::trunc) << bytes;
+    cuda_checkpoint_storage::ContentDigest hash;
+    std::string digest, error;
+    ASSERT_TRUE(hash.Update(bytes.data(), bytes.size(), &error)) << error;
+    ASSERT_TRUE(hash.Finalize(&digest, &error)) << error;
+    request_.set_manifest_sha256(digest);
+  }
+
+  void SaveMatchingManifest() {
+    std::ostringstream manifest;
+    manifest << "{\"version\":1,\"allocations\":[";
+    for (int i = 0; i < request_.allocations_size(); ++i) {
+      const auto& a = request_.allocations(i);
+      if (i) manifest << ',';
+      manifest << "{\"allocation_id\":\"" << a.allocation_id()
+               << "\",\"aligned_size\":" << a.aligned_size()
+               << ",\"shard\":\"" << a.shard() << "\",\"offset\":" << a.offset() << '}';
+    }
+    manifest << "]}";
+    SaveManifest(manifest.str());
+  }
+
+  void ExpectRejected(const v1::LoadGmsWeightsRequest& request, const std::string& reason) {
+    try {
+      ValidateGmsArtifact(request, directory_.get());
+      FAIL() << "invalid artifact was accepted";
+    } catch (const std::exception& error) {
+      EXPECT_NE(std::string(error.what()).find(reason), std::string::npos) << error.what();
+    }
+  }
+
+  Request Envelope(std::string id = "load-1", std::string transaction = "transaction-1") {
+    Request r;
+    r.set_request_id(std::move(id));
+    r.set_transaction_id(std::move(transaction));
+    *r.mutable_load_gms_weights() = request_;
+    return r;
+  }
+
+  void Listen() {
+    listener_ = FileDescriptor(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+    ASSERT_GE(listener_.get(), 0);
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, request_.socket_path().c_str(), request_.socket_path().size() + 1);
+    ASSERT_EQ(bind(listener_.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)), 0);
+    ASSERT_EQ(listen(listener_.get(), 16), 0);
+  }
+
+  bool WaitForAdmission() {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (std::chrono::steady_clock::now() < deadline) {
+      if (Calls() != 0) return true;
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return false;
+  }
+
+  size_t Calls() {
+    std::ifstream file(artifact_ / "gms-calls");
+    size_t count = 0;
+    std::string line;
+    while (std::getline(file, line)) ++count;
+    return count;
+  }
+
+  fs::path root_, artifact_;
+  FileDescriptor directory_{-1}, listener_{-1};
+  v1::LoadGmsWeightsRequest request_;
+};
+
+TEST_F(GmsAdmissionTest, AcceptsExactCapturedAllocationsRegardlessOfRequestOrder) {
+  EXPECT_NO_THROW(ValidateGmsArtifact(request_, directory_.get()));
+  request_.mutable_allocations()->SwapElements(0, 1);
+  EXPECT_NO_THROW(ValidateGmsArtifact(request_, directory_.get()));
+}
+
+TEST_F(GmsAdmissionTest, RejectsCorruptManifestDigestBeforeOpeningPayloads) {
+  fs::remove_all(artifact_ / "shards");
+  std::ofstream(artifact_ / "manifest.json", std::ios::app) << ' ';
+  ExpectRejected(request_, "digest mismatch");
+}
+
+TEST_F(GmsAdmissionTest, RejectsEquivalentSizesWithWrongAllocationIdentity) {
+  request_.mutable_allocations(0)->set_allocation_id("unrelated-capture-allocation");
+  ExpectRejected(request_, "differ from captured manifest");
+}
+
+TEST_F(GmsAdmissionTest, RejectsWrongAllocationSizesOrOffsets) {
+  auto changed = request_;
+  changed.mutable_allocations(0)->set_aligned_size(8192);
+  ExpectRejected(changed, "differ from captured manifest");
+  changed = request_;
+  changed.mutable_allocations(1)->set_offset(8192);
+  ExpectRejected(changed, "differ from captured manifest");
+}
+
+TEST_F(GmsAdmissionTest, RejectsEmptyOrUnalignedAllocationExtents) {
+  for (uint64_t size : {0ULL, 4095ULL}) {
+    auto changed = request_;
+    changed.mutable_allocations(0)->set_aligned_size(size);
+    ExpectRejected(changed, "size or alignment");
+  }
+  auto changed = request_;
+  changed.mutable_allocations(1)->set_offset(4097);
+  ExpectRejected(changed, "size or alignment");
+}
+
+TEST_F(GmsAdmissionTest, RejectsTruncatedAndOversizedShards) {
+  fs::resize_file(artifact_ / "shards" / "weights.bin", 12287);
+  ExpectRejected(request_, "shard size mismatch");
+  fs::resize_file(artifact_ / "shards" / "weights.bin", 12289);
+  ExpectRejected(request_, "shard size mismatch");
+}
+
+TEST_F(GmsAdmissionTest, RejectsDuplicateIdsHolesAndOverlapsEvenWithMatchingManifest) {
+  const auto original = request_;
+  request_.mutable_allocations(1)->set_allocation_id(request_.allocations(0).allocation_id());
+  SaveMatchingManifest();
+  ExpectRejected(request_, "ID duplicate");
+  for (uint64_t offset : {0ULL, 8192ULL}) {
+    request_ = original;
+    request_.mutable_allocations(1)->set_offset(offset);
+    SaveMatchingManifest();
+    ExpectRejected(request_, "contiguous and non-overlapping");
+  }
+}
+
+TEST_F(GmsAdmissionTest, RejectsTraversalAndAbsoluteShardPaths) {
+  for (const auto* path : {"../weights.bin", "/tmp/weights.bin", "shards/../weights.bin", "shards/sub/weights.bin"}) {
+    SCOPED_TRACE(path);
+    auto changed = request_;
+    changed.mutable_allocations(0)->set_shard(path);
+    ExpectRejected(changed, "direct child of shards");
+  }
+}
+
+TEST_F(GmsAdmissionTest, RejectsSymlinkedManifestShardAndShardDirectory) {
+  fs::rename(artifact_ / "manifest.json", artifact_ / "manifest-real.json");
+  fs::create_symlink("manifest-real.json", artifact_ / "manifest.json");
