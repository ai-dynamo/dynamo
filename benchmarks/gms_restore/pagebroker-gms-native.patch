+  request_.set_artifact_directory((root_ / "storage" / "alias").string());
+  Broker broker(root_ / "staging", root_ / "storage");
+  const auto response = broker.HandleRequest(Envelope());
+  ASSERT_TRUE(response.has_failure());
+  EXPECT_EQ(response.failure().code(), v1::Failure::INVALID_REQUEST);
+  EXPECT_NE(response.failure().message().find("contains symlink"), std::string::npos);
