+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package controller
+
+import (
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+)
+
+// traceRestoreStage adds same-clock milestones for the restore startup study.
+// It reads only the Pod already held by the caller: no extra API or runtime
+// lookup belongs in this instrumentation. queue_add means an informer event
+// requested work; the workqueue may coalesce several such events into one pass.
+func (w *NodeController) traceRestoreStage(pod *corev1.Pod, stage string, started time.Time, err error, extra ...any) {
+	now := time.Now()
+	values := []any{
+		"pod", pod.Namespace + "/" + pod.Name,
+		"pod_uid", pod.UID,
+		"resource_version", pod.ResourceVersion,
+		"stage", stage,
+		"at_unix_nano", now.UnixNano(),
+		"pod_ip_present", pod.Status.PodIP != "",
+	}
+	if !started.IsZero() {
+		values = append(values, "elapsed_seconds", now.Sub(started).Seconds())
+	}
+	if err != nil {
+		values = append(values, "error", err.Error())
+	}
+	values = append(values, extra...)
+	w.log.Info("Restore startup milestone", values...)
+}
