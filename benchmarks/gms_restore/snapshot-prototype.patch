+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package controller
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+
+	snapshotruntime "github.com/ai-dynamo/snapshot/agent/internal/runtime"
+)
+
+func (w *NodeController) runtimeNetworkDiscoveryEnabled(pod *corev1.Pod) bool {
+	_, supported := w.runtime.(snapshotruntime.PodRestoreTargetResolver)
+	return supported && pod.Annotations[restoreRuntimeDiscoveryAnnotation] == "true" &&
+		pod.Annotations[restoreRuntimeNetworkDiscoveryAnnotation] == "true"
+}
+
+// resolveRestoreNetworkTarget binds a CRI-derived IP to the same READY sandbox
+// as the running destination. It is used only when both experimental opt-ins
+// are set and the preflight Pod snapshot has no IP. Neither the Pod nor its
+// informer cache is modified. Authoritative status can still win while polling.
+func (w *NodeController) resolveRestoreNetworkTarget(ctx context.Context, pod *corev1.Pod, destination, podKey string) (snapshotruntime.PodRestoreTarget, bool) {
+	var empty snapshotruntime.PodRestoreTarget
+	resolver, supported := w.runtime.(snapshotruntime.PodRestoreTargetResolver)
+	if !supported || !w.runtimeNetworkDiscoveryEnabled(pod) {
+		return empty, true
+	}
+	started := time.Now()
+	deadlineAt := started.Add(restoreContainerResolveTimeout)
+	pollCtx, cancelPoll := context.WithDeadline(ctx, deadlineAt)
+	defer cancelPoll()
+	tick := time.NewTicker(restoreContainerResolveInterval)
+	defer tick.Stop()
+	w.traceRestoreStage(pod, "runtime_network_poll_start", time.Time{}, nil, "destination", destination)
+	attempts := 0
+	var runtimeDuration time.Duration
+	var lastErr error
+	for {
+		if pollCtx.Err() != nil {
+			stage := "network_resolution_canceled"
+			timedOut := ctx.Err() == nil
+			if timedOut {
+				stage = "network_resolution_timeout"
+			}
+			w.traceRestoreStage(pod, stage, started, errors.Join(pollCtx.Err(), lastErr), "destination", destination, "attempts", attempts, "runtime_seconds", runtimeDuration.Seconds())
+			return empty, timedOut
+		}
+
+		// If kubelet catches up, preserve its primary IP and the existing
+		// container-status/runtime path. Never consume another incarnation.
+		latest := pod
+		if w.restorePodLister != nil {
+			observed, err := w.restorePodLister.Pods(pod.Namespace).Get(pod.Name)
+			if err == nil {
+				if observed.UID != pod.UID || observed.DeletionTimestamp != nil {
+					w.traceRestoreStage(pod, "network_resolution_canceled", started, errors.New("restore pod was replaced or deleted"), "destination", destination)
+					return empty, false
+				}
+				latest = observed
+			}
+		}
+		if latest.Status.PodIP != "" {
+			id, requeue := w.resolveRestoreContainerID(pollCtx, latest, destination, podKey)
+			if pollCtx.Err() != nil {
+				continue
+			}
+			if id == "" {
+				return empty, requeue
+			}
+			target := snapshotruntime.PodRestoreTarget{ContainerID: id, PodIP: latest.Status.PodIP}
+			w.traceRestoreStage(pod, "network_resolution_done", started, nil, "destination", destination, "source", "informer_status", "container_id", id, "target_pod_ip", target.PodIP, "attempts", attempts, "runtime_seconds", runtimeDuration.Seconds())
+			return target, false
+		}
+
+		resolveCtx, cancel := restoreContainerResolveAttemptContext(pollCtx, deadlineAt)
+		attemptStarted := time.Now()
+		attempts++
+		target, err := resolver.ResolveRestoreTargetByPodIdentity(resolveCtx, pod.Name, pod.Namespace, string(pod.UID), destination)
+		cancel()
+		runtimeDuration += time.Since(attemptStarted)
+		lastErr = err
+		if pollCtx.Err() == nil && err == nil && target.ContainerID != "" && target.PodSandboxID != "" && target.PodIP != "" {
+			w.traceRestoreStage(pod, "network_resolution_done", started, nil, "destination", destination, "source", "runtime", "container_id", target.ContainerID, "sandbox_id", target.PodSandboxID, "target_pod_ip", target.PodIP, "attempts", attempts, "runtime_seconds", runtimeDuration.Seconds())
+			w.log.Info("Resolved restore container and Pod IP via node runtime", "pod", podKey, "pod_uid", pod.UID, "container", destination, "container_id", target.ContainerID, "sandbox_id", target.PodSandboxID, "target_pod_ip", target.PodIP)
+			return target, false
+		}
+		select {
+		case <-pollCtx.Done():
+		case <-tick.C:
+		}
+	}
+}
