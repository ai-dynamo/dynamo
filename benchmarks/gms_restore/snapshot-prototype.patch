+func TestPodRestoreTargetDiscoveryCancellationAndRPCFailures(t *testing.T) {
+	for _, stage := range []string{"before lookup", "after sandbox list", "after container list", "after sandbox status"} {
+		t.Run(stage, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			sandbox := nativeDiscoverySandbox()
+			service := &discoveryRuntimeService{sandboxes: []*runtimeapi.PodSandbox{sandbox}, containers: []*runtimeapi.Container{discoveryContainer()}, status: discoverySandboxStatus(sandbox, "10.42.0.8")}
+			switch stage {
+			case "before lookup":
+				cancel()
+			case "after sandbox list":
+				service.sandboxHook = cancel
+			case "after container list":
+				service.containerHook = cancel
+			case "after sandbox status":
+				service.statusHook = cancel
+			}
+			target, err := resolveRestoreTargetByPodIdentity(ctx, service, "worker", "inference", "current-pod-uid", "main")
+			require.Empty(t, target)
+			require.ErrorIs(t, err, context.Canceled)
+		})
+	}
+	for _, stage := range []string{"sandbox list", "container list", "sandbox status"} {
+		t.Run(stage, func(t *testing.T) {
+			sandbox := nativeDiscoverySandbox()
+			failure := errors.New("RPC failed")
+			service := &discoveryRuntimeService{sandboxes: []*runtimeapi.PodSandbox{sandbox}, containers: []*runtimeapi.Container{discoveryContainer()}, status: discoverySandboxStatus(sandbox, "10.42.0.8")}
+			switch stage {
+			case "sandbox list":
+				service.sandboxErr = failure
+			case "container list":
+				service.containerErr = failure
+			case "sandbox status":
+				service.statusErr = failure
+			}
+			target, err := resolveRestoreTargetByPodIdentity(context.Background(), service, "worker", "inference", "current-pod-uid", "main")
+			require.Empty(t, target)
+			require.ErrorIs(t, err, failure)
+		})
+	}
+	t.Run("missing identity", func(t *testing.T) {
+		service := &discoveryRuntimeService{}
+		target, err := resolveRestoreTargetByPodIdentity(context.Background(), service, "worker", "inference", "", "main")
+		require.Empty(t, target)
+		require.ErrorContains(t, err, "UID")
+		require.Nil(t, service.sandboxFilter)
+	})
+}
