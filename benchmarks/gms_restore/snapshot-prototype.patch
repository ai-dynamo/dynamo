 }
 
+// ValidateExplicitDeviceMap accepts a complete bijection selected by the caller's
+// logical-rank plan. Unlike BuildDeviceMap it never favors matching physical UUIDs.
+func ValidateExplicitDeviceMap(value string, sourceUUIDs, targetUUIDs []string) (string, error) {
+	sources, targets := make(map[string]bool), make(map[string]bool)
+	for _, id := range sourceUUIDs {
+		sources[id] = true
+	}
+	for _, id := range targetUUIDs {
+		targets[id] = true
+	}
+	if len(sources) == 0 || len(sources) != len(sourceUUIDs) || len(targets) != len(targetUUIDs) || len(sources) != len(targets) {
+		return "", fmt.Errorf("explicit device map requires nonempty unique source and destination GPU sets of equal size")
+	}
+	mapping, used := make(map[string]string), make(map[string]bool)
+	for _, pair := range strings.Split(value, ",") {
+		src, dst, ok := strings.Cut(pair, "=")
+		if !ok || !gpuUUIDPattern.MatchString(src) || !gpuUUIDPattern.MatchString(dst) || !sources[src] || !targets[dst] || mapping[src] != "" || used[dst] {
+			return "", fmt.Errorf("invalid, duplicate, or unallocated explicit GPU pair %q", pair)
+		}
+		mapping[src], used[dst] = dst, true
+	}
+	if len(mapping) != len(sources) {
+		return "", fmt.Errorf("explicit device map must cover every captured GPU")
+	}
+	pairs := make([]string, 0, len(sourceUUIDs))
+	for _, src := range sourceUUIDs {
+		pairs = append(pairs, src+"="+mapping[src])
+	}
+	return strings.Join(pairs, ","), nil
+}
+
