+
+// PodIdentityResolver is an optional runtime capability for discovering a
+// running container before Kubernetes publishes its ID. Including the pod UID
+// prevents a previous incarnation of the same named pod from being selected.
+type PodIdentityResolver interface {
+	ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error)
+}
+
+type podDiscoveryService interface {
+	ListPodSandbox(context.Context, *runtimeapi.PodSandboxFilter) ([]*runtimeapi.PodSandbox, error)
+	ListContainers(context.Context, *runtimeapi.ContainerFilter) ([]*runtimeapi.Container, error)
+}
+
+var (
+	_ PodIdentityResolver = (*ContainerdRuntime)(nil)
+	_ PodIdentityResolver = (*CRIORuntime)(nil)
+)
+
+func (r *ContainerdRuntime) ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error) {
+	return resolveContainerIDByPodIdentity(ctx, r.cri, pod, ns, uid, ctr)
+}
+
+func (r *CRIORuntime) ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error) {
+	return resolveContainerIDByPodIdentity(ctx, r.svc, pod, ns, uid, ctr)
+}
+
+func resolveContainerIDByPodIdentity(ctx context.Context, svc podDiscoveryService, pod, ns, uid, ctr string) (string, error) {
+	if pod == "" || ns == "" || uid == "" || ctr == "" {
+		return "", errors.New("pod name, namespace, UID, and container name are required for runtime discovery")
+	}
+	ctx, cancel := context.WithTimeout(ctx, criCallTimeout)
+	defer cancel()
+
+	// CRI carries the pod annotations in the sandbox. Unlike container labels,
+	// these retain the virtual identity when vcluster translates the host name.
+	// Inspect only identity keys; other annotations may contain credentials.
+	sandboxes, err := svc.ListPodSandbox(ctx, &runtimeapi.PodSandboxFilter{
+		State: &runtimeapi.PodSandboxStateValue{State: runtimeapi.PodSandboxState_SANDBOX_READY},
+	})
+	if err != nil {
+		return "", fmt.Errorf("list pod sandboxes for %s/%s: %w", ns, pod, err)
+	}
+	var matched *runtimeapi.PodSandbox
+	for _, sandbox := range sandboxes {
+		if !sandboxMatchesPodIdentity(sandbox, pod, ns, uid) {
+			continue
+		}
+		if matched != nil {
+			return "", fmt.Errorf("multiple ready sandboxes match pod %s/%s UID %s", ns, pod, uid)
+		}
+		matched = sandbox
+	}
+	if matched == nil {
+		return "", fmt.Errorf("no ready sandbox matches pod %s/%s UID %s", ns, pod, uid)
+	}
+
+	containers, err := svc.ListContainers(ctx, &runtimeapi.ContainerFilter{
+		PodSandboxId: matched.GetId(),
+		State:        &runtimeapi.ContainerStateValue{State: runtimeapi.ContainerState_CONTAINER_RUNNING},
+	})
+	if err != nil {
+		return "", fmt.Errorf("list containers for pod %s/%s sandbox %s: %w", ns, pod, matched.GetId(), err)
+	}
+	containerID := ""
+	for _, container := range containers {
+		// Recheck the response as well as sending filters: a sandbox match must
+		// never broaden to a similarly named container from another pod.
+		if container.GetId() == "" || container.GetPodSandboxId() != matched.GetId() ||
+			container.GetState() != runtimeapi.ContainerState_CONTAINER_RUNNING ||
+			container.GetMetadata().GetName() != ctr {
+			continue
+		}
+		if containerID != "" {
+			return "", fmt.Errorf("multiple running containers match pod %s/%s UID %s container %s", ns, pod, uid, ctr)
+		}
+		containerID = container.GetId()
+	}
+	if containerID == "" {
+		return "", fmt.Errorf("no running container matches pod %s/%s UID %s container %s", ns, pod, uid, ctr)
+	}
+	return containerID, nil
+}
+
+func sandboxMatchesPodIdentity(sandbox *runtimeapi.PodSandbox, pod, ns, uid string) bool {
+	metadata := sandbox.GetMetadata()
+	if sandbox.GetId() == "" || sandbox.GetState() != runtimeapi.PodSandboxState_SANDBOX_READY ||
+		metadata.GetName() == "" || metadata.GetNamespace() == "" || metadata.GetUid() == "" {
+		return false
+	}
+	if metadata.GetName() == pod && metadata.GetNamespace() == ns && metadata.GetUid() == uid {
+		return true
+	}
+	annotations := sandbox.GetAnnotations()
+	// Require both sides of the translation. Never infer vcluster's host name
+	// encoding, and never accept a same-name sandbox with a different virtual UID.
+	return annotations["vcluster.loft.sh/object-name"] == pod &&
+		annotations["vcluster.loft.sh/object-namespace"] == ns &&
+		annotations["vcluster.loft.sh/object-uid"] == uid &&
+		annotations["vcluster.loft.sh/object-kind"] == "/v1, Kind=Pod" &&
+		annotations["vcluster.loft.sh/object-host-name"] == metadata.GetName() &&
+		annotations["vcluster.loft.sh/object-host-namespace"] == metadata.GetNamespace()
+}
