+				t.Run(backend+"/"+identity+"/"+address, func(t *testing.T) {
+					sandbox := create()
+					service := &discoveryRuntimeService{FakeRuntimeService: critesting.NewFakeRuntimeService(), sandboxes: []*runtimeapi.PodSandbox{sandbox}, containers: []*runtimeapi.Container{discoveryContainer()}, status: discoverySandboxStatus(sandbox, address)}
+					ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+					defer cancel()
+					deadline, _ := ctx.Deadline()
+					target, err := build(service).ResolveRestoreTargetByPodIdentity(ctx, "worker", "inference", "current-pod-uid", "main")
+					require.NoError(t, err)
+					require.Equal(t, PodRestoreTarget{ContainerID: "container-id", PodSandboxID: "sandbox-id", PodIP: address}, target)
+					require.Equal(t, deadline, service.deadline)
+					require.Equal(t, "sandbox-id", service.containerFilter.GetPodSandboxId())
+					require.Equal(t, "sandbox-id", service.statusSandboxID)
+					require.False(t, service.statusVerbose, "do not request unrelated runtime metadata")
+				})
+			}
+		}
+	}
