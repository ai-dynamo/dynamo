 // then persists the launch-job state needed to restore them.
 // On failure, the caller is expected to fail the operation and terminate the workload.
diff --git a/agent/internal/cuda/explicit_map_test.go b/agent/internal/cuda/explicit_map_test.go
new file mode 100644
index 00000000..7d02b6b2
--- /dev/null
+++ b/agent/internal/cuda/explicit_map_test.go
@@ -0,0 +1,33 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+package cuda
+
+import "testing"
+
+func TestExplicitDeviceMap(t *testing.T) {
+	a := "GPU-00000000-0000-0000-0000-000000000001"
+	b := "GPU-00000000-0000-0000-0000-000000000002"
+	c := "GPU-00000000-0000-0000-0000-000000000003"
+	for _, tc := range []struct {
+		name, value string
+		valid       bool
+	}{
+		{"permutation overrides identity", a + "=" + b + "," + b + "=" + a, true},
+		{"identity", a + "=" + a + "," + b + "=" + b, true},
+		{"missing rank", a + "=" + b, false},
+		{"duplicate target", a + "=" + b + "," + b + "=" + b, false},
+		{"duplicate source", a + "=" + a + "," + a + "=" + b, false},
+		{"unallocated destination", a + "=" + c + "," + b + "=" + b, false},
+		{"unknown source", c + "=" + a + "," + b + "=" + b, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ValidateExplicitDeviceMap(tc.value, []string{a, b}, []string{b, a})
+			if (err == nil) != tc.valid {
+				t.Fatalf("result %q error %v", got, err)
+			}
+			if tc.valid && got != tc.value {
+				t.Fatalf("map changed: %q", got)
+			}
+		})
+	}
+}
