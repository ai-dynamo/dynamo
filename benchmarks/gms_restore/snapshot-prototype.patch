+func TestNetworkDiscoveryPreflightIsExplicitAndCapabilityGated(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		identity  bool
+		network   bool
+		supported bool
+		tcp       bool
+		cachedIP  string
+		pending   bool
+		discover  bool
+	}{
+		{name: "both opt-ins", identity: true, network: true, supported: true, tcp: true, discover: true},
+		{name: "identity only", identity: true, supported: true, tcp: true, pending: true},
+		{name: "network only", network: true, supported: true, tcp: true, pending: true},
+		{name: "neither opt-in", supported: true, tcp: true, pending: true},
+		{name: "unsupported runtime", identity: true, network: true, tcp: true, pending: true},
+		{name: "no TCP restore", identity: true, network: true, supported: true},
+		{name: "cached IP wins", identity: true, network: true, supported: true, tcp: true, cachedIP: "10.1.2.3"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pod := networkDiscoveryPod()
+			if !tc.identity {
+				delete(pod.Annotations, restoreRuntimeDiscoveryAnnotation)
+			}
+			if !tc.network {
+				delete(pod.Annotations, restoreRuntimeNetworkDiscoveryAnnotation)
+			}
+			pod.Status.PodIP = tc.cachedIP
+			snapshot, content := readySnapshotObjects()
+			w := makeTestController(t, pod, snapshot, content)
+			w.config.CRIU.TcpEstablished = tc.tcp
+			rt := &networkFakeRuntime{}
+			if tc.supported {
+				w.runtime = rt
+			}
+			path, err := nsmount.ResolveArtifactPath(w.config.Storage.BasePath, string(content.UID), "main")
+			require.NoError(t, err)
+			require.NoError(t, os.MkdirAll(path, 0o700))
+			plan, err := w.preflightRestore(context.Background(), pod)
+			if tc.pending {
+				require.Nil(t, plan)
+				assert.Equal(t, "PodIPPending", pendingRestoreReason(t, err))
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, tc.discover, plan.runtimeNetworkDiscovery)
+				assert.Equal(t, tc.cachedIP, plan.targetPodIP)
+			}
+			assert.Zero(t, rt.calls, "preflight does not add runtime RPCs")
+			assert.Equal(t, tc.cachedIP, pod.Status.PodIP)
+		})
+	}
+}
