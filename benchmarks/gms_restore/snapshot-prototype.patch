+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package runtime
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	internalapi "k8s.io/cri-api/pkg/apis"
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+	critesting "k8s.io/cri-api/pkg/apis/testing"
+)
+
+type discoveryRuntimeService struct {
+	*critesting.FakeRuntimeService
+	sandboxes       []*runtimeapi.PodSandbox
+	containers      []*runtimeapi.Container
+	sandboxFilter   *runtimeapi.PodSandboxFilter
+	containerFilter *runtimeapi.ContainerFilter
+	sandboxErr      error
+	containerErr    error
+	deadline        time.Time
+	status          *runtimeapi.PodSandboxStatusResponse
+	statusErr       error
+	statusSandboxID string
+	statusVerbose   bool
+	sandboxHook     func()
+	containerHook   func()
+	statusHook      func()
+}
+
+func (s *discoveryRuntimeService) ListPodSandbox(ctx context.Context, filter *runtimeapi.PodSandboxFilter) ([]*runtimeapi.PodSandbox, error) {
+	s.sandboxFilter = filter
+	s.deadline, _ = ctx.Deadline()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if s.sandboxHook != nil {
+		s.sandboxHook()
+	}
+	return s.sandboxes, s.sandboxErr
+}
+
+func (s *discoveryRuntimeService) ListContainers(_ context.Context, filter *runtimeapi.ContainerFilter) ([]*runtimeapi.Container, error) {
+	s.containerFilter = filter
+	if s.containerHook != nil {
+		s.containerHook()
+	}
+	return s.containers, s.containerErr
+}
+
+func (s *discoveryRuntimeService) PodSandboxStatus(_ context.Context, id string, verbose bool) (*runtimeapi.PodSandboxStatusResponse, error) {
+	s.statusSandboxID, s.statusVerbose = id, verbose
+	if s.statusHook != nil {
+		s.statusHook()
+	}
+	return s.status, s.statusErr
+}
+
+func discoverySandboxStatus(sandbox *runtimeapi.PodSandbox, address string) *runtimeapi.PodSandboxStatusResponse {
+	annotations := make(map[string]string, len(sandbox.Annotations))
+	for key, value := range sandbox.Annotations {
+		annotations[key] = value
+	}
+	metadata := sandbox.GetMetadata()
+	return &runtimeapi.PodSandboxStatusResponse{Status: &runtimeapi.PodSandboxStatus{
+		Id: sandbox.Id, State: sandbox.State,
+		Metadata:    &runtimeapi.PodSandboxMetadata{Name: metadata.GetName(), Namespace: metadata.GetNamespace(), Uid: metadata.GetUid(), Attempt: metadata.GetAttempt()},
+		Annotations: annotations, Network: &runtimeapi.PodSandboxNetworkStatus{Ip: address},
+	}}
+}
+
+func nativeDiscoverySandbox() *runtimeapi.PodSandbox {
+	return &runtimeapi.PodSandbox{
+		Id:       "sandbox-id",
+		State:    runtimeapi.PodSandboxState_SANDBOX_READY,
+		Metadata: &runtimeapi.PodSandboxMetadata{Name: "worker", Namespace: "inference", Uid: "current-pod-uid"},
+	}
+}
+
+func virtualDiscoverySandbox() *runtimeapi.PodSandbox {
+	return &runtimeapi.PodSandbox{
+		Id:       "sandbox-id",
+		State:    runtimeapi.PodSandboxState_SANDBOX_READY,
+		Metadata: &runtimeapi.PodSandboxMetadata{Name: "translated-host-name", Namespace: "host-namespace", Uid: "host-pod-uid"},
+		Annotations: map[string]string{
+			"vcluster.loft.sh/object-name":           "worker",
+			"vcluster.loft.sh/object-namespace":      "inference",
+			"vcluster.loft.sh/object-uid":            "current-pod-uid",
+			"vcluster.loft.sh/object-kind":           "/v1, Kind=Pod",
+			"vcluster.loft.sh/object-host-name":      "translated-host-name",
+			"vcluster.loft.sh/object-host-namespace": "host-namespace",
+		},
+	}
+}
+
+func discoveryContainer() *runtimeapi.Container {
+	return &runtimeapi.Container{
+		Id: "container-id", PodSandboxId: "sandbox-id",
+		State:    runtimeapi.ContainerState_CONTAINER_RUNNING,
+		Metadata: &runtimeapi.ContainerMetadata{Name: "main"},
+	}
+}
+
+func TestPodIdentityDiscoveryBackends(t *testing.T) {
+	backends := map[string]func(internalapi.RuntimeService) PodIdentityResolver{
+		"containerd": func(service internalapi.RuntimeService) PodIdentityResolver { return &ContainerdRuntime{cri: service} },
+		"cri-o":      func(service internalapi.RuntimeService) PodIdentityResolver { return &CRIORuntime{svc: service} },
+	}
+	identities := map[string]func() *runtimeapi.PodSandbox{
+		"native": nativeDiscoverySandbox, "virtual": virtualDiscoverySandbox,
+	}
+	for backend, build := range backends {
+		for identity, sandbox := range identities {
+			t.Run(backend+"/"+identity, func(t *testing.T) {
+				service := &discoveryRuntimeService{
+					FakeRuntimeService: critesting.NewFakeRuntimeService(),
+					sandboxes:          []*runtimeapi.PodSandbox{sandbox()},
+					containers:         []*runtimeapi.Container{discoveryContainer()},
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+				defer cancel()
+				deadline, _ := ctx.Deadline()
+				id, err := build(service).ResolveContainerIDByPodIdentity(ctx, "worker", "inference", "current-pod-uid", "main")
+				require.NoError(t, err)
+				require.Equal(t, "container-id", id)
+				require.Equal(t, deadline, service.deadline, "keep the controller's shorter attempt deadline")
+				require.Equal(t, runtimeapi.PodSandboxState_SANDBOX_READY, service.sandboxFilter.GetState().GetState())
+				require.Equal(t, "sandbox-id", service.containerFilter.GetPodSandboxId())
+				require.Equal(t, runtimeapi.ContainerState_CONTAINER_RUNNING, service.containerFilter.GetState().GetState())
+			})
+		}
+	}
+}
+
+func TestPodIdentityDiscoveryRejectsSandboxMismatch(t *testing.T) {
+	tests := map[string]func(*runtimeapi.PodSandbox){
+		"stale virtual UID":           func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-uid"] = "previous-pod-uid" },
+		"wrong virtual name":          func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-name"] = "other" },
+		"wrong virtual namespace":     func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-namespace"] = "other" },
+		"wrong object kind":           func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-kind"] = "/v1, Kind=Service" },
+		"conflicting host name":       func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-host-name"] = "other" },
+		"conflicting host namespace":  func(s *runtimeapi.PodSandbox) { s.Annotations["vcluster.loft.sh/object-host-namespace"] = "other" },
+		"missing translation":         func(s *runtimeapi.PodSandbox) { s.Annotations = nil },
+		"missing virtual UID":         func(s *runtimeapi.PodSandbox) { delete(s.Annotations, "vcluster.loft.sh/object-uid") },
+		"missing host UID":            func(s *runtimeapi.PodSandbox) { s.Metadata.Uid = "" },
+		"missing sandbox ID":          func(s *runtimeapi.PodSandbox) { s.Id = "" },
