new file mode 100644
index 00000000..2de005fd
--- /dev/null
+++ b/agent/internal/runtime/discovery.go
@@ -0,0 +1,228 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package runtime
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+
+	runtimeapi "k8s.io/cri-api/pkg/apis/runtime/v1"
+)
+
+// PodIdentityResolver is an optional runtime capability for discovering a
+// running container before Kubernetes publishes its ID. Including the pod UID
+// prevents a previous incarnation of the same named pod from being selected.
+type PodIdentityResolver interface {
+	ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error)
+}
+
+// PodRestoreTarget binds the destination container and network address to one
+// validated, current pod sandbox. It is never assembled from separate lookups.
+type PodRestoreTarget struct {
+	ContainerID  string
+	PodSandboxID string
+	PodIP        string
+}
+
+// PodRestoreTargetResolver optionally discovers a complete restore destination
+// before kubelet publishes its container ID and Pod IP to the Kubernetes API.
+type PodRestoreTargetResolver interface {
+	ResolveRestoreTargetByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (PodRestoreTarget, error)
+}
+
+type podRestoreDiscoveryService interface {
+	podDiscoveryService
+	PodSandboxStatus(context.Context, string, bool) (*runtimeapi.PodSandboxStatusResponse, error)
+}
+
+type podDiscoveryService interface {
+	ListPodSandbox(context.Context, *runtimeapi.PodSandboxFilter) ([]*runtimeapi.PodSandbox, error)
+	ListContainers(context.Context, *runtimeapi.ContainerFilter) ([]*runtimeapi.Container, error)
+}
+
+var (
+	_ PodIdentityResolver      = (*ContainerdRuntime)(nil)
+	_ PodIdentityResolver      = (*CRIORuntime)(nil)
+	_ PodRestoreTargetResolver = (*ContainerdRuntime)(nil)
+	_ PodRestoreTargetResolver = (*CRIORuntime)(nil)
+)
+
+func (r *ContainerdRuntime) ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error) {
+	return resolveContainerIDByPodIdentity(ctx, r.cri, pod, ns, uid, ctr)
+}
+
+func (r *CRIORuntime) ResolveContainerIDByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (string, error) {
+	return resolveContainerIDByPodIdentity(ctx, r.svc, pod, ns, uid, ctr)
+}
+
+func (r *ContainerdRuntime) ResolveRestoreTargetByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (PodRestoreTarget, error) {
+	return resolveRestoreTargetByPodIdentity(ctx, r.cri, pod, ns, uid, ctr)
+}
+
+func (r *CRIORuntime) ResolveRestoreTargetByPodIdentity(ctx context.Context, pod, ns, uid, ctr string) (PodRestoreTarget, error) {
+	return resolveRestoreTargetByPodIdentity(ctx, r.svc, pod, ns, uid, ctr)
+}
+
+func validateDiscoveryIdentity(pod, ns, uid, ctr string) error {
+	if pod == "" || ns == "" || uid == "" || ctr == "" {
+		return errors.New("pod name, namespace, UID, and container name are required for runtime discovery")
+	}
+	return nil
+}
+
+func resolveContainerIDByPodIdentity(ctx context.Context, svc podDiscoveryService, pod, ns, uid, ctr string) (string, error) {
+	if err := validateDiscoveryIdentity(pod, ns, uid, ctr); err != nil {
+		return "", err
+	}
+	ctx, cancel := context.WithTimeout(ctx, criCallTimeout)
+	defer cancel()
+	matched, err := findPodIdentitySandbox(ctx, svc, pod, ns, uid)
+	if err != nil {
+		return "", err
+	}
+	return findSandboxContainer(ctx, svc, matched.GetId(), pod, ns, uid, ctr)
+}
+
+func resolveRestoreTargetByPodIdentity(ctx context.Context, svc podRestoreDiscoveryService, pod, ns, uid, ctr string) (PodRestoreTarget, error) {
+	var empty PodRestoreTarget
+	if err := validateDiscoveryIdentity(pod, ns, uid, ctr); err != nil {
+		return empty, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, criCallTimeout)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	matched, err := findPodIdentitySandbox(ctx, svc, pod, ns, uid)
+	if err != nil {
+		return empty, err
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	containerID, err := findSandboxContainer(ctx, svc, matched.GetId(), pod, ns, uid, ctr)
+	if err != nil {
+		return empty, err
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	// verbose=false avoids collecting unrelated runtime metadata. Recheck the
+	// sandbox after finding the container, including its host incarnation.
+	response, err := svc.PodSandboxStatus(ctx, matched.GetId(), false)
+	if err != nil {
+		return empty, fmt.Errorf("get sandbox status for pod %s/%s sandbox %s: %w", ns, pod, matched.GetId(), err)
+	}
+	if err := ctx.Err(); err != nil {
+		return empty, err
+	}
+	status := response.GetStatus()
+	current := &runtimeapi.PodSandbox{
+		Id: status.GetId(), State: status.GetState(), Metadata: status.GetMetadata(),
+		Annotations: status.GetAnnotations(),
+	}
+	if !sandboxMatchesPodIdentity(current, pod, ns, uid) || !sameDiscoverySandboxIdentity(matched, current) {
+		return empty, fmt.Errorf("sandbox identity or readiness changed for pod %s/%s UID %s", ns, pod, uid)
+	}
+	address := status.GetNetwork().GetIp()
+	ip := net.ParseIP(address)
+	if ip == nil || !ip.IsGlobalUnicast() {
+		return empty, fmt.Errorf("sandbox has no usable Pod IP for pod %s/%s UID %s", ns, pod, uid)
+	}
+	return PodRestoreTarget{ContainerID: containerID, PodSandboxID: matched.GetId(), PodIP: address}, nil
+}
+
+func sameDiscoverySandboxIdentity(before, after *runtimeapi.PodSandbox) bool {
+	a, b := before.GetMetadata(), after.GetMetadata()
+	if before.GetId() != after.GetId() || a.GetName() != b.GetName() || a.GetNamespace() != b.GetNamespace() || a.GetUid() != b.GetUid() {
+		return false
+	}
+	for _, key := range []string{
+		"vcluster.loft.sh/object-name", "vcluster.loft.sh/object-namespace",
+		"vcluster.loft.sh/object-uid", "vcluster.loft.sh/object-kind",
+		"vcluster.loft.sh/object-host-name", "vcluster.loft.sh/object-host-namespace",
+	} {
+		if before.GetAnnotations()[key] != after.GetAnnotations()[key] {
+			return false
+		}
+	}
+	return true
+}
+
+func findPodIdentitySandbox(ctx context.Context, svc podDiscoveryService, pod, ns, uid string) (*runtimeapi.PodSandbox, error) {
+	// CRI carries the pod annotations in the sandbox. Unlike container labels,
+	// these retain the virtual identity when vcluster translates the host name.
+	// Inspect only identity keys; other annotations may contain credentials.
+	sandboxes, err := svc.ListPodSandbox(ctx, &runtimeapi.PodSandboxFilter{
+		State: &runtimeapi.PodSandboxStateValue{State: runtimeapi.PodSandboxState_SANDBOX_READY},
+	})
+	if err != nil {
+		return nil, fmt.Errorf("list pod sandboxes for %s/%s: %w", ns, pod, err)
+	}
+	var matched *runtimeapi.PodSandbox
+	for _, sandbox := range sandboxes {
+		if !sandboxMatchesPodIdentity(sandbox, pod, ns, uid) {
+			continue
+		}
+		if matched != nil {
+			return nil, fmt.Errorf("multiple ready sandboxes match pod %s/%s UID %s", ns, pod, uid)
+		}
+		matched = sandbox
+	}
+	if matched == nil {
+		return nil, fmt.Errorf("no ready sandbox matches pod %s/%s UID %s", ns, pod, uid)
+	}
+
+	return matched, nil
+}
+
+func findSandboxContainer(ctx context.Context, svc podDiscoveryService, sandboxID, pod, ns, uid, ctr string) (string, error) {
+	containers, err := svc.ListContainers(ctx, &runtimeapi.ContainerFilter{
+		PodSandboxId: sandboxID,
+		State:        &runtimeapi.ContainerStateValue{State: runtimeapi.ContainerState_CONTAINER_RUNNING},
+	})
+	if err != nil {
+		return "", fmt.Errorf("list containers for pod %s/%s sandbox %s: %w", ns, pod, sandboxID, err)
+	}
+	containerID := ""
+	for _, container := range containers {
+		// Recheck the response as well as sending filters: a sandbox match must
+		// never broaden to a similarly named container from another pod.
+		if container.GetId() == "" || container.GetPodSandboxId() != sandboxID ||
+			container.GetState() != runtimeapi.ContainerState_CONTAINER_RUNNING ||
+			container.GetMetadata().GetName() != ctr {
+			continue
+		}
+		if containerID != "" {
+			return "", fmt.Errorf("multiple running containers match pod %s/%s UID %s container %s", ns, pod, uid, ctr)
+		}
+		containerID = container.GetId()
+	}
+	if containerID == "" {
+		return "", fmt.Errorf("no running container matches pod %s/%s UID %s container %s", ns, pod, uid, ctr)
+	}
+	return containerID, nil
+}
+
+func sandboxMatchesPodIdentity(sandbox *runtimeapi.PodSandbox, pod, ns, uid string) bool {
+	metadata := sandbox.GetMetadata()
+	if sandbox.GetId() == "" || sandbox.GetState() != runtimeapi.PodSandboxState_SANDBOX_READY ||
+		metadata.GetName() == "" || metadata.GetNamespace() == "" || metadata.GetUid() == "" {
+		return false
+	}
+	if metadata.GetName() == pod && metadata.GetNamespace() == ns && metadata.GetUid() == uid {
+		return true
+	}
+	annotations := sandbox.GetAnnotations()
+	// Require both sides of the translation. Never infer vcluster's host name
+	// encoding, and never accept a same-name sandbox with a different virtual UID.
+	return annotations["vcluster.loft.sh/object-name"] == pod &&
+		annotations["vcluster.loft.sh/object-namespace"] == ns &&
+		annotations["vcluster.loft.sh/object-uid"] == uid &&
+		annotations["vcluster.loft.sh/object-kind"] == "/v1, Kind=Pod" &&
+		annotations["vcluster.loft.sh/object-host-name"] == metadata.GetName() &&
+		annotations["vcluster.loft.sh/object-host-namespace"] == metadata.GetNamespace()
+}
