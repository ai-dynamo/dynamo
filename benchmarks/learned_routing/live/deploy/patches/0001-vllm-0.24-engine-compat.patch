+def _engine_generate_session_support(engine_client: Any) -> bool:
+    """Whether this vLLM's ``generate`` accepts ``session_id`` (absent in vLLM 0.24)."""
+    cached = getattr(engine_client, _GENERATE_SESSION_SUPPORT_CACHE_ATTR, None)
+    if isinstance(cached, bool):
+        return cached
+
+    try:
+        parameters = inspect.signature(engine_client.generate).parameters
+    except (TypeError, ValueError):
+        logger.debug("Unable to inspect vLLM generate signature; omitting session_id")
+        supports_session = False
+    else:
+        parameter = parameters.get("session_id")
+        supports_session = (
+            parameter is not None
+            and parameter.kind != inspect.Parameter.POSITIONAL_ONLY
+        ) or any(
+            param.kind == inspect.Parameter.VAR_KEYWORD for param in parameters.values()
+        )
+
+    try:
+        setattr(engine_client, _GENERATE_SESSION_SUPPORT_CACHE_ATTR, supports_session)
+    except (AttributeError, TypeError):
+        logger.debug("Unable to cache vLLM generate session_id support")
+    return supports_session
+
+
+def _engine_generate_session_kwargs(
+    engine_client: Any, session_id: str | None
+) -> dict[str, Any]:
+    if _engine_generate_session_support(engine_client):
+        return {"session_id": session_id}
+    return {}
+
