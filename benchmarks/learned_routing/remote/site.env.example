# Site settings for the Slurm CPU lane. Copy this file to site.env (git-ignored) next to it, or point
# LR_SITE_ENV at a copy elsewhere. Variables already set in the environment win over this file.
# Every value below is a placeholder.

# Campaign root (CR): cells, traces, runs/ and facts/ live here.
LR_CR=/path/to/learned-routing-campaign
# ssh alias (from ~/.ssh/config) of the cluster's Slurm login node.
LR_SSH_ALIAS=my-cpu-cluster
# Shared scratch directory on the cluster for bundles, returned results and Slurm output.
LR_REMOTE_ROOT=/path/on/cluster/scratch/learned-routing
# Slurm account and QoS for the batch jobs.
LR_ACCOUNT=my-slurm-account
LR_QOS=normal
# Comma-separated x86_64 zero-GPU partitions (glibc >= the bundle's floor). Slurm starts each job in
# the first listed partition that can run it.
LR_PARTITIONS=cpu-partition-a,cpu-partition-b

# Optional overrides (defaults shown).
# LR_MEM=180G
# LR_TIME=04:00:00

# p2orch.py only: placement targets (copy p2orch_targets.example.json), the time zone of its
# weekly job-end cutoff and, optionally, the ISO time the cluster reopens after a maintenance
# window (the default of `p2orch.py init --cluster-reopen`).
LR_P2ORCH_TARGETS=/path/to/p2orch_targets.json
# LR_TZ=UTC
# LR_CLUSTER_REOPEN=2030-01-05T20:00:00+00:00
