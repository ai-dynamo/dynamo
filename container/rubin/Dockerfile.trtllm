# Dynamo + TensorRT-LLM for Vera Rubin. Builds for BOTH arm64 (VR200, sbsa) and
# amd64 (x86_64); pass --platform + the matching BASE / TRTLLM_WHEEL_URL build-args.
#
# Build approach (per Ishan Dhanani's bringup guidance): install Dynamo FROM SOURCE
# inside the Rubin framework image instead of using render.py — the render.py trtllm
# path assumes a *release* image (tensorrt_llm + python-bundled NIXL) and breaks on the
# Rubin build base. The pytorch-rubin base has NO tensorrt_llm installed, so we add the
# prebuilt trtllm wheel first, then build Dynamo on top.
#
# Build on a NATIVE host of the target arch (emulation is slow for the Rust/maturin
# build). BASE and TRTLLM_WHEEL_URL are arch-specific — there is no combined
# multi-arch pytorch-rubin tag, so select the manifest matching the target arch:
#   arm64: pytorch-rubin-py3-sbsa-...   + RubinBringup-...-VR200-CUDA13.4.tar.gz
#   amd64: pytorch-rubin-py3-x86_64-... + TensorRT-LLM.tar.gz
# e.g. on an arm64 host (computelab-armbuild-1):
#   docker build --platform linux/arm64 \
#     --build-arg BASE=urm.nvidia.com/sw-tensorrt-docker/tensorrt-llm:pytorch-rubin-py3-sbsa-ubuntu24.04-trt10.15.1.29-20260512 \
#     --build-arg TRTLLM_WHEEL_URL=https://urm.nvidia.com/artifactory/sw-tensorrt-generic/llm-artifacts/LLM/feat-rubin-bringup/L0_PostMerge/24/RubinBringup-TensorRT-LLM-VR200-CUDA13.4.tar.gz \
#     -t <registry>/<you>-trtllm-rubin:<tag> -f Dockerfile.trtllm .
# The dynamo-ci pipeline resolves the latest build's BASE + wheel automatically
# (scripts/resolve_rubin_trtllm_base.sh) and passes them per arch.
# Validated arm64 image: nvcr.io/nvidian/dynamo-dev/tzulingk-trtllm-rubin:sbsa-fromsrc-main-7c8b4b19

# This needs to be the pytorch container which trtllm is building against. We need to track this somehow.
ARG BASE=urm.nvidia.com/sw-tensorrt-docker/tensorrt-llm:pytorch-rubin-py3-sbsa-ubuntu24.04-trt10.15.1.29-20260512
FROM ${BASE}
SHELL ["/bin/bash","-c"]
ENV DEBIAN_FRONTEND=noninteractive

# (1) Prebuilt TRT-LLM wheel for the target arch. Installed WITH deps (base lacks
#     trtllm's pure-python deps); the rubin-tuned torch/tensorrt are unpinned/satisfied
#     so pip leaves them untouched. The tarball carries a single arch-matching wheel,
#     so the glob resolves unambiguously. The default below is only a fallback for
#     manual arm64 builds — dynamo-ci overrides it per arch with the latest build.
ARG TRTLLM_WHEEL_URL=https://urm.nvidia.com/artifactory/sw-tensorrt-generic/llm-artifacts/LLM/feat-rubin-bringup/L0_PostMerge/24/RubinBringup-TensorRT-LLM-VR200-CUDA13.4.tar.gz
RUN cd /tmp \
 && curl -fSL --retry 3 -o t.tgz "${TRTLLM_WHEEL_URL}" \
 && tar xzf t.tgz --wildcards 'TensorRT-LLM/tensorrt_llm-*.whl' \
 && pip install --break-system-packages --no-cache-dir TensorRT-LLM/tensorrt_llm-*.whl \
 && rm -rf t.tgz TensorRT-LLM

# (2) nats + etcd. TARGETARCH is set automatically by buildkit from --platform
#     (amd64|arm64) and matches the nats/etcd release asset suffixes directly.
ARG TARGETARCH
RUN cd /tmp \
 && curl -fSL https://github.com/nats-io/nats-server/releases/download/v2.10.28/nats-server-v2.10.28-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 nats-server-*/nats-server /usr/local/bin/nats-server \
 && curl -fSL https://github.com/etcd-io/etcd/releases/download/v3.5.30/etcd-v3.5.30-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 etcd-*/etcd etcd-*/etcdctl /usr/local/bin/ \
 && rm -rf nats-server-* etcd-*

# (3) Rust toolchain + maturin (the pytorch-rubin base already ships uv, protoc, clang)
RUN curl -fSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}
RUN pip install --break-system-packages --no-cache-dir "maturin[patchelf]"

# (4) Dynamo from source
ARG DYNAMO_REF=main
RUN git clone --depth 1 --branch ${DYNAMO_REF} https://github.com/ai-dynamo/dynamo.git /opt/dynamo
WORKDIR /opt/dynamo

# REQUIRED on Rubin: cudarc 0.19.3 rejects CUDA 13.4 (its allow-list stops at 13.1).
# Pin to the 13.1 API — forward-compatible with the 13.4 driver.
ENV CUDARC_CUDA_VERSION=13010

RUN cd lib/bindings/python \
 && maturin build --release --features "kv-indexer,slot-tracker,select-service,mm-routing,aic-forward-pass" --out /opt/dynamo/dist \
 && cd /opt/dynamo && uv build --wheel --out-dir /opt/dynamo/dist
RUN pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo_runtime*.whl \
 && pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo-*.whl \
 && pip install --break-system-packages --no-cache-dir msgspec uvloop imageio imageio-ffmpeg

# (5) UCX + NIXL, built from source exactly as container/templates/wheel_builder.Dockerfile
#     does for CUDA — the Rubin framework bases ship no UCX/NIXL, so without this the
#     Rust nixl-sys dlopen("libnixl.so") falls into stub mode and KV transfer / disagg
#     is unavailable. Versions are the per-framework values from container/context.yaml
#     (trtllm: nixl v1.0.1). The supporting native deps (hwloc, gdrcopy, libfabric) are
#     built the same way so UCX/NIXL link identically to the templated images. Built
#     AFTER the Dynamo wheels so the validated stub-mode build above is unchanged; NIXL
#     is resolved at runtime via LD_LIBRARY_PATH (same wiring as the runtime templates).
#     dnf packages from wheel_builder are mapped to their apt equivalents for Ubuntu.
ARG NIXL_REF=v1.0.1
ARG NIXL_UCX_REF=v1.20.x
ARG NIXL_GDRCOPY_REF=v2.5.2
ARG NIXL_LIBFABRIC_REPO=https://github.com/ofiwg/libfabric.git
ARG NIXL_LIBFABRIC_REF=v2.5.1
ARG HWLOC_VERSION=2.12.2
ARG CUDA_MAJOR=13
ENV CUDA_HOME=/usr/local/cuda

# Build deps (apt equivalents of wheel_builder's dnf list) + meson/pybind11/tomlkit.
RUN apt-get update && apt-get install -y --no-install-recommends \
      autoconf automake libtool make cmake ninja-build pkg-config flex \
      git wget curl ca-certificates clang libclang-dev protobuf-compiler \
      libibverbs-dev rdma-core ibverbs-utils libibumad-dev librdmacm-dev ibverbs-providers \
      libnuma-dev libcurl4-openssl-dev libssl-dev uuid-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --break-system-packages --no-cache-dir --upgrade meson pybind11 patchelf tomlkit

# hwloc (NIXL needs a newer hwloc than distros ship; keep in sync with upstream NIXL).
RUN cd /tmp \
 && HWLOC_SERIES="$(echo "${HWLOC_VERSION}" | cut -d. -f1,2)" \
 && wget -q "https://download.open-mpi.org/release/hwloc/v${HWLOC_SERIES}/hwloc-${HWLOC_VERSION}.tar.gz" \
 && tar -xzf "hwloc-${HWLOC_VERSION}.tar.gz" && cd "hwloc-${HWLOC_VERSION}" \
 && ./configure --prefix=/usr/local --disable-nvml && make -j"$(nproc)" && make install && ldconfig \
 && rm -rf "/tmp/hwloc-${HWLOC_VERSION}" "/tmp/hwloc-${HWLOC_VERSION}.tar.gz"

# gdrcopy (UCX --with-gdrcopy). Library + headers only; the kmod lives on the host.
RUN cd /tmp \
 && git clone --depth 1 --branch ${NIXL_GDRCOPY_REF} https://github.com/NVIDIA/gdrcopy.git \
 && make -C gdrcopy CUDA=${CUDA_HOME} prefix=/usr/local lib lib_install && ldconfig \
 && rm -rf /tmp/gdrcopy

# libfabric (NIXL libfabric/EFA backend).
RUN cd /usr/local/src \
 && git clone ${NIXL_LIBFABRIC_REPO} && cd libfabric && git checkout ${NIXL_LIBFABRIC_REF} \
 && ./autogen.sh \
 && ./configure --prefix=/usr/local/libfabric \
      --disable-verbs --disable-psm3 --disable-opx --disable-usnic --disable-rstream \
      --enable-efa --with-cuda=${CUDA_HOME} --enable-cuda-dlopen --with-gdrcopy --enable-gdrcopy-dlopen \
 && make -j"$(nproc)" && make install \
 && echo "/usr/local/libfabric/lib" > /etc/ld.so.conf.d/libfabric.conf && ldconfig
ENV PKG_CONFIG_PATH=/usr/local/ucx/lib/pkgconfig:/usr/local/libfabric/lib/pkgconfig:${PKG_CONFIG_PATH:-}

# UCX.
RUN cd /usr/local/src \
 && git clone https://github.com/openucx/ucx.git && cd ucx && git checkout ${NIXL_UCX_REF} \
 && ./autogen.sh \
 && ./contrib/configure-release \
      --prefix=/usr/local/ucx --enable-shared --disable-static --disable-doxygen-doc \
      --enable-optimizations --enable-cma --enable-devel-headers \
      --with-cuda=${CUDA_HOME} --with-verbs --with-dm --with-gdrcopy=/usr/local --with-efa --enable-mt \
 && make -j"$(nproc)" && make -j install-strip \
 && echo "/usr/local/ucx/lib"     > /etc/ld.so.conf.d/ucx.conf \
 && echo "/usr/local/ucx/lib/ucx" >> /etc/ld.so.conf.d/ucx.conf && ldconfig

# NIXL native SDK (meson) + Python wheel, linked against the UCX/libfabric above.
RUN cd /usr/local/src \
 && git clone https://github.com/ai-dynamo/nixl.git && cd nixl && git checkout ${NIXL_REF} \
 && ./contrib/tomlutil.py --wheel-name "nixl-cu${CUDA_MAJOR}" pyproject.toml \
 && meson setup build/ --prefix=/opt/nvidia/nvda_nixl --libdir=lib64 --buildtype=release \
      -Dcudapath_lib=${CUDA_HOME}/lib64 -Dcudapath_inc=${CUDA_HOME}/include \
      -Ducx_path=/usr/local/ucx -Dlibfabric_path=/usr/local/libfabric \
 && cd build && ninja && ninja install \
 && echo "/opt/nvidia/nvda_nixl/lib64"         > /etc/ld.so.conf.d/nixl.conf \
 && echo "/opt/nvidia/nvda_nixl/lib64/plugins" >> /etc/ld.so.conf.d/nixl.conf && ldconfig \
 && cd /usr/local/src/nixl && uv build . --wheel --out-dir /opt/dynamo/nixl-dist --python 3.12 \
 && pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/nixl-dist/nixl*.whl

# Match the wheel_builder/runtime NIXL + UCX env so Rust nixl-sys dlopen() and the nixl
# Python package both resolve the copy we just built (no stub-mode fallback at runtime).
ENV NIXL_PREFIX=/opt/nvidia/nvda_nixl \
    NIXL_LIB_DIR=/opt/nvidia/nvda_nixl/lib64 \
    NIXL_PLUGIN_DIR=/opt/nvidia/nvda_nixl/lib64/plugins
ENV LD_LIBRARY_PATH=/opt/nvidia/nvda_nixl/lib64:/opt/nvidia/nvda_nixl/lib64/plugins:/usr/local/ucx/lib:/usr/local/ucx/lib/ucx:/usr/local/libfabric/lib:${LD_LIBRARY_PATH:-}

ENV DYNAMO_HOME=/opt/dynamo
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
