# Dynamo + TensorRT-LLM for Vera Rubin. Builds for BOTH arm64 (VR200, sbsa) and
# amd64 (x86_64); pass --platform + the matching BASE build-arg and stage the
# arch-matching TRT-LLM wheel into container/rubin/.trtllm-wheel/ first.
#
# Build approach (per Ishan Dhanani's bringup guidance): install Dynamo FROM SOURCE
# inside the Rubin framework image instead of using render.py — the render.py trtllm
# path assumes a *release* image (tensorrt_llm + python-bundled NIXL) and breaks on the
# Rubin build base. The pytorch-rubin base has NO tensorrt_llm installed, so we add the
# prebuilt trtllm wheel first, then build Dynamo on top.
#
# Build on a NATIVE host of the target arch (emulation is slow for the Rust/maturin
# build). BASE and the wheel are arch-specific — there is no combined multi-arch
# pytorch-rubin tag, so select the manifest matching the target arch:
#   arm64: pytorch-rubin-py3-sbsa-...   + a linux_aarch64 tensorrt_llm wheel
#   amd64: pytorch-rubin-py3-x86_64-... + a linux_x86_64 tensorrt_llm wheel
# e.g. on an arm64 host (computelab-armbuild-1):
#   mkdir -p container/rubin/.trtllm-wheel && cp tensorrt_llm-*aarch64.whl container/rubin/.trtllm-wheel/
#   DOCKER_BUILDKIT=1 docker build --platform linux/arm64 \
#     --build-arg BASE=urm.nvidia.com/sw-tensorrt-docker/tensorrt-llm:pytorch-rubin-py3-sbsa-ubuntu24.04-trt10.15.1.29-20260512 \
#     -t <registry>/<you>-trtllm-rubin:<tag> -f container/rubin/Dockerfile.trtllm .
# The dynamo-ci pipeline resolves the latest BASE and downloads the newest curated
# wheel (scripts/resolve_rubin_trtllm_base.sh + `jf rt download`) into that dir per arch.
# Validated arm64 image: nvcr.io/nvidian/dynamo-dev/tzulingk-trtllm-rubin:sbsa-fromsrc-main-7c8b4b19

# This needs to be the pytorch container which trtllm is building against. We need to track this somehow.
ARG BASE=urm.nvidia.com/sw-tensorrt-docker/tensorrt-llm:pytorch-rubin-py3-sbsa-ubuntu24.04-trt10.15.1.29-20260512
FROM ${BASE}
SHELL ["/bin/bash","-c"]
ENV DEBIAN_FRONTEND=noninteractive

# (1) Prebuilt TRT-LLM wheel for the target arch. Installed WITH deps (base lacks
#     trtllm's pure-python deps); the rubin-tuned torch/tensorrt are unpinned/satisfied
#     so pip leaves them untouched.
#
#     The wheel is staged into the build context at container/rubin/.trtllm-wheel/
#     BEFORE the build. dynamo-ci downloads it there with `jf` from the private
#     sw-dynamo-dev-generic-local Artifactory repo (newest upload.timestamp) so the
#     Artifactory credentials stay on the runner. We bind-mount that directory and
#     pip-install the wheel — it is never COPYed, so nothing wheel-related lands in
#     the image layers. Requires BuildKit (DOCKER_BUILDKIT=1).
#
#     Manual build: stage an arch-matching wheel there first, e.g.
#       mkdir -p container/rubin/.trtllm-wheel \
#         && cp tensorrt_llm-*.whl container/rubin/.trtllm-wheel/
# sentencepiece + tiktoken are the backends transformers uses to convert a slow
# (SentencePiece/tiktoken) tokenizer to a fast one. The pytorch-rubin base ships
# transformers without them, so tokenizer_factory() fails at model load with
# "Couldn't instantiate the backend tokenizer ... need sentencepiece or tiktoken".
RUN --mount=type=bind,source=container/rubin/.trtllm-wheel,target=/tmp/trtllm-wheel \
    pip install --break-system-packages --no-cache-dir /tmp/trtllm-wheel/*.whl \
 && pip install --break-system-packages --no-cache-dir sentencepiece tiktoken

# (2) nats + etcd. TARGETARCH is set automatically by buildkit from --platform
#     (amd64|arm64) and matches the nats/etcd release asset suffixes directly.
ARG TARGETARCH
RUN cd /tmp \
 && curl -fSL https://github.com/nats-io/nats-server/releases/download/v2.10.28/nats-server-v2.10.28-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 nats-server-*/nats-server /usr/local/bin/nats-server \
 && curl -fSL https://github.com/etcd-io/etcd/releases/download/v3.5.30/etcd-v3.5.30-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 etcd-*/etcd etcd-*/etcdctl /usr/local/bin/ \
 && rm -rf nats-server-* etcd-*

# (3) Rust toolchain + maturin (the pytorch-rubin base already ships uv, protoc, clang)
RUN curl -fSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}
RUN pip install --break-system-packages --no-cache-dir "maturin[patchelf]"

# (4) Dynamo from source
ARG DYNAMO_REF=main
RUN --mount=type=secret,id=gitlab_user \
    --mount=type=secret,id=gitlab_token \
    GITLAB_USERNAME=$(cat /run/secrets/gitlab_user) && \
    GITLAB_TOKEN=$(cat /run/secrets/gitlab_token) && \
    git clone --depth 1 --branch ${DYNAMO_REF} https://${GITLAB_USERNAME}:${GITLAB_TOKEN}@gitlab-master.nvidia.com/dl/ai-dynamo/dynamo.git /opt/dynamo
WORKDIR /opt/dynamo

# REQUIRED on Rubin: cudarc 0.19.3 rejects CUDA 13.4 (its allow-list stops at 13.1).
# Pin to the 13.1 API — forward-compatible with the 13.4 driver.
ENV CUDARC_CUDA_VERSION=13010

RUN cd lib/bindings/python \
 && maturin build --release --features "kv-indexer,slot-tracker,select-service,mm-routing,aic-forward-pass,nvtx" --out /opt/dynamo/dist \
 && cd /opt/dynamo && uv build --wheel --out-dir /opt/dynamo/dist
RUN pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo_runtime*.whl \
 && pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo-*.whl \
 && pip install --break-system-packages --no-cache-dir msgspec uvloop imageio imageio-ffmpeg

# Dynamo runtime dependency closure. The ai_dynamo wheels above are installed with
# --no-deps, and the pytorch-rubin base is minimal (unlike the upstream
# tensorrt-llm/release image the templated build layers on), so install the same
# requirement sets container/templates/{dynamo_runtime,trtllm_runtime}.Dockerfile use:
#   common   — fastapi/uvicorn/httpx/pydantic/opentelemetry/prometheus/transformers/...
#   frontend — grpcio + tritonclient[grpc]
#   planner  — kubernetes/aiconfigurator/scikit-learn/filterpy/pmdarima
# requirements.trtllm.txt is intentionally NOT installed here: it has many pins that
# conflict with the pytorch-rubin base. nixl-cu13 is installed separately in step 5.
# PyYAML is installed by apt in the pytorch-rubin base (dist-packages, no RECORD),
# so pip can't uninstall it to satisfy requirements.common.txt's PyYAML==6.0.3.
# Install it fresh first (ignore the apt copy, no deps); the -r install below then
# sees a pip-managed 6.0.3 and never attempts an uninstall. Add any further
# apt-managed packages that trip "Cannot uninstall ... no RECORD file" to this pre-step.
RUN --mount=type=bind,source=container/deps/requirements.common.txt,target=/tmp/req.common.txt \
    --mount=type=bind,source=container/deps/requirements.frontend.txt,target=/tmp/req.frontend.txt \
    --mount=type=bind,source=container/deps/requirements.planner.txt,target=/tmp/req.planner.txt \
    pip install --break-system-packages --no-cache-dir --ignore-installed --no-deps PyYAML \
 && pip install --break-system-packages --no-cache-dir \
      -r /tmp/req.common.txt \
      -r /tmp/req.frontend.txt \
      -r /tmp/req.planner.txt

# (5) NIXL: use the copy bundled inside the TRT-LLM wheel (same approach as
#     container/templates/trtllm_runtime.Dockerfile on main). No source build needed.
#     LD_PRELOAD forces TRT-LLM's libnixl.so over the nixl-cu13 PyPI copy, which
#     bundles UCX 1.20.0 and hangs in uct_md_query_tl_resources (nixl#1668). Install
#     nixl-cu13 from PyPI for the Python bindings only; the native .so is overridden.
RUN ARCH_ALT=$([ "${TARGETARCH}" = "amd64" ] && echo "x86_64" || echo "aarch64") \
 && test -f /usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/libnixl.so \
 && test -d /usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/plugins \
 && printf '%s\n' \
        "/opt/nvidia/nvda_nixl/lib/${ARCH_ALT}-linux-gnu" \
        "/opt/nvidia/nvda_nixl/lib64" \
        > /etc/ld.so.conf.d/00-dynamo-trtllm.conf \
 && ldconfig \
 && pip install --break-system-packages --no-cache-dir "nixl-cu13"

ENV LD_PRELOAD=/usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/libnixl.so \
    NIXL_PLUGIN_DIR=/usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/plugins

ENV DYNAMO_HOME=/opt/dynamo
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
