# syntax=docker/dockerfile:1.10.0-labs
# SPDX-FileCopyrightText: Copyright (c) 2024-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Multi-stage Dynamo build on top of a TRT-LLM release image that ships
# tensorrt_llm pre-installed.
#
# Stage 1 (wheel_builder): build ai-dynamo and ai-dynamo-runtime wheels inside
#   the TRT-LLM image so the wheel is compiled against the exact CUDA/Python ABI
#   the runtime image uses.
# Stage 2 (runtime): install those wheels (and Dynamo deps) onto a fresh copy of
#   the same TRT-LLM image.
#
# Build:
#   DOCKER_BUILDKIT=1 docker build \
#     --build-arg TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release \
#     --build-arg TRTLLM_IMAGE_TAG=1.3.0 \
#     -t <registry>/dynamo-trtllm:<tag> \
#     -f container/Dockerfile.trtllm .

ARG TRTLLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release
ARG TRTLLM_IMAGE_TAG=latest

# ── Stage 1: wheel builder ────────────────────────────────────────────────────
FROM ${TRTLLM_IMAGE}:${TRTLLM_IMAGE_TAG} AS wheel_builder

SHELL ["/bin/bash", "-c"]
ARG TARGETARCH

# CUDARC_CUDA_VERSION pins cudarc's allow-list to the 13.1 API level, which is
# forward-compatible with 13.2/13.4 stacks that cudarc hasn't catalogued yet.
ENV CUDARC_CUDA_VERSION=13010 \
    CARGO_TARGET_DIR=/opt/dynamo/target

# Rust toolchain + maturin (uv is already present on most TRT-LLM images; add
# it here in case a slim variant omits it).
RUN curl -fSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}

RUN pip install --break-system-packages --no-cache-dir "maturin[patchelf]" uv

# Copy dynamo source from the build context.
WORKDIR /opt/dynamo
COPY .cargo/ .cargo/
COPY pyproject.toml README.md LICENSE Cargo.toml Cargo.lock rust-toolchain.toml hatch_build.py ./
COPY lib/ lib/
COPY components/ components/

# Build ai-dynamo-runtime (Rust/maturin) and ai-dynamo (pure-Python) wheels.
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=shared \
    --mount=type=cache,target=/root/.cargo/git,sharing=shared \
    mkdir -p /opt/dynamo/dist && \
    cd lib/bindings/python && \
    maturin build --release \
        --features "kv-indexer,slot-tracker,select-service,mm-routing,aic-forward-pass" \
        --out /opt/dynamo/dist && \
    cd /opt/dynamo && \
    uv build --wheel --out-dir /opt/dynamo/dist

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM ${TRTLLM_IMAGE}:${TRTLLM_IMAGE_TAG} AS runtime

SHELL ["/bin/bash", "-c"]
ARG TARGETARCH

# Install nats-server and etcd (same versions as the rubin/template builds).
RUN cd /tmp \
 && curl -fSL https://github.com/nats-io/nats-server/releases/download/v2.10.28/nats-server-v2.10.28-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 nats-server-*/nats-server /usr/local/bin/nats-server \
 && curl -fSL https://github.com/etcd-io/etcd/releases/download/v3.5.30/etcd-v3.5.30-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 etcd-*/etcd etcd-*/etcdctl /usr/local/bin/ \
 && rm -rf nats-server-* etcd-*

# Register TRT-LLM's native library paths with the dynamic loader. The release
# image sets these only for interactive shells (/etc/shinit_v2), not for K8s /
# bare `python3` launches, so `import tensorrt` / `import tensorrt_llm` fail with
# "libnvonnxparser.so.10: cannot open shared object file". This does NOT rebuild
# or reconfigure nixl/ucx — ldconfig only indexes the .so files already shipped
# in the image. Mirrors container/templates/trtllm_runtime.Dockerfile.
RUN ARCH_ALT=$([ "${TARGETARCH}" = "amd64" ] && echo "x86_64" || echo "aarch64") \
 && printf '%s\n' \
        "/usr/local/tensorrt/lib" \
        "/usr/local/cuda/lib64" \
        "/usr/local/ucx/lib" \
        "/opt/hpcx/ompi/lib" \
        "/opt/hpcx/ucc/lib" \
        "/opt/nvidia/nvda_nixl/lib/${ARCH_ALT}-linux-gnu" \
        "/opt/nvidia/nvda_nixl/lib64" \
        > /etc/ld.so.conf.d/00-dynamo-trtllm.conf \
 && ldconfig

# uv — used to install into the Dynamo venv below.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Copy wheels produced by the builder stage.
COPY --from=wheel_builder /opt/dynamo/dist/*.whl /opt/dynamo/wheelhouse/

# Venv with system-site-packages preserves the upstream TRT-LLM package solve
# (Python is PEP 668 externally-managed in the release image).
RUN python3 -m venv --system-site-packages /opt/dynamo/venv

ENV VIRTUAL_ENV=/opt/dynamo/venv \
    PATH=/opt/dynamo/venv/bin:${PATH}

# Install dynamo wheels and ONLY the extra deps the TRT-LLM image omits.
# EVERYTHING is --no-deps: the release image already carries a consistent solve
# (torch, tensorrt_llm, its bundled nixl/ucx, pydantic+pydantic-core, fastapi,
# transformers, ...). We must NOT install requirements.common.txt/frontend.txt
# here — pinning e.g. pydantic without its matching pydantic-core shadows the
# upstream pair in the venv and breaks at import. requirements.trtllm.txt is the
# curated set of packages the release image genuinely lacks (msgspec, uvloop,
# imageio, nixl bindings). --no-deps also stops nixl-cu13 from pulling its UCX
# 1.20.0 wheel, so TRT-LLM's native libnixl/libucx stay untouched (LD_PRELOAD
# below keeps them active). Mirrors container/templates/trtllm_runtime.Dockerfile.
RUN --mount=type=bind,source=./container/deps/requirements.trtllm.txt,target=/tmp/requirements.trtllm.txt \
    uv pip install --no-deps /opt/dynamo/wheelhouse/ai_dynamo_runtime*.whl && \
    uv pip install --no-deps /opt/dynamo/wheelhouse/ai_dynamo*any.whl && \
    uv pip install --no-deps --requirement /tmp/requirements.trtllm.txt

# MPI/HPC-X: TRT-LLM launches its runtime via OpenMPI (from HPC-X). OpenMPI bakes
# in its build prefix (/build-result/hpcx-.../ompi4) and needs OPAL_PREFIX to
# relocate to the real install, or MPI_Init_thread aborts on a NULL communicator.
# OMPI_MCA_coll_ucc_enable=0 skips the UCC collective (avoids a hard HPC-X UCC
# dependency). Mirrors container/dev/50-framework-paths.sh, which the release
# image only applies to interactive shells (not bare `python3` launches).
#
# LD_PRELOAD forces TRT-LLM's bundled libnixl over the nixl-cu13 PyPI copy, which
# bundles UCX 1.20.0 and hangs in uct_md_query_tl_resources (nixl#1668).
ENV DYNAMO_HOME=/workspace \
    OPAL_PREFIX=/opt/hpcx/ompi \
    OMPI_MCA_coll_ucc_enable=0 \
    PATH=/opt/hpcx/ompi/bin:/usr/local/bin/etcd:${PATH} \
    LD_PRELOAD=/usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/libnixl.so \
    NIXL_PLUGIN_DIR=/usr/local/lib/python3.12/dist-packages/tensorrt_llm/libs/nixl/plugins

WORKDIR /workspace
ENTRYPOINT []
CMD ["/bin/bash"]
