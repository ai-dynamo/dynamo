# Dynamo + vLLM for Vera Rubin (VR200, sbsa/arm64).
#
# The dl/dgx/vllm:rubin-py3-devel image already has vLLM installed (built from the
# rubin-devel branch, CUDA 13.4), so unlike trtllm there is no wheel step — we just
# install Dynamo from source on top (per Ishan Dhanani's bringup guidance).
#
# Build on a NATIVE arm64 Docker host:
#   docker build --platform linux/arm64 -t <registry>/<you>-vllm-rubin:<tag> -f Dockerfile.vllm .

ARG BASE=gitlab-master.nvidia.com:5005/dl/dgx/vllm:rubin-py3-devel
FROM ${BASE}
SHELL ["/bin/bash","-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Build tools. clang/libclang are REQUIRED: dynamo's rust bindings use bindgen via
# nixl-sys, and the dl/dgx bases do not ship libclang (the trtllm pytorch-rubin base does).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl git ca-certificates build-essential protobuf-compiler clang libclang-dev \
 && rm -rf /var/lib/apt/lists/*

# nats + etcd. TARGETARCH (amd64|arm64) is set by buildkit from --platform and
# matches the nats/etcd release asset suffixes directly. Must be arch-aware: a
# hardcoded arch ships the wrong-arch binary in the other arch's image and fails
# at runtime with "Exec format error" (e.g. arm64 nats-server on an x86 node).
ARG TARGETARCH
RUN cd /tmp \
 && curl -fSL https://github.com/nats-io/nats-server/releases/download/v2.10.28/nats-server-v2.10.28-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 nats-server-*/nats-server /usr/local/bin/nats-server \
 && curl -fSL https://github.com/etcd-io/etcd/releases/download/v3.5.30/etcd-v3.5.30-linux-${TARGETARCH}.tar.gz | tar xz \
 && install -m755 etcd-*/etcd etcd-*/etcdctl /usr/local/bin/ \
 && rm -rf nats-server-* etcd-*

# Rust + maturin + uv
RUN curl -fSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}
RUN python3 -m pip install --break-system-packages --no-cache-dir "maturin[patchelf]" uv

# Dynamo from source
ARG DYNAMO_REF=main
RUN git clone --depth 1 --branch ${DYNAMO_REF} https://github.com/ai-dynamo/dynamo.git /opt/dynamo
WORKDIR /opt/dynamo

# REQUIRED on Rubin: cudarc 0.19.3 rejects CUDA 13.4; pin to the 13.1 API (driver-forward-compatible).
ENV CUDARC_CUDA_VERSION=13010

RUN cd lib/bindings/python \
 && maturin build --release --features "kv-indexer,slot-tracker,select-service,mm-routing,aic-forward-pass" --out /opt/dynamo/dist \
 && cd /opt/dynamo && uv build --wheel --out-dir /opt/dynamo/dist
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo_runtime*.whl \
 && python3 -m pip install --break-system-packages --no-cache-dir --no-deps /opt/dynamo/dist/ai_dynamo-*.whl \
 && python3 -m pip install --break-system-packages --no-cache-dir msgspec uvloop imageio imageio-ffmpeg

# NIXL + UCX: the dl/dgx Rubin base ALREADY ships framework-matched NIXL 1.3.0 (at
# /usr/local/nixl, Debian-multiarch libdir) and UCX 1.21.0 (at /usr/local/ucx), so unlike
# trtllm we do NOT rebuild them from source — doing so would downgrade/shadow the base's
# newer, framework-linked copies. We only wire the NIXL env so Dynamo's Rust nixl-sys
# dlopen("libnixl.so") and the nixl Python package resolve the base copy instead of the
# build-time stub. A stable /opt/dynamo/nixl symlink hides the arch-specific multiarch dir
# so the ENV values below are arch-independent. The test -f/-d asserts the base layout is
# as expected — if the base ever moves NIXL, the build fails here with the real listing
# rather than silently shipping a stub-mode image.
ARG TARGETARCH
RUN ARCH_ALT=$([ "${TARGETARCH:-$(dpkg --print-architecture)}" = "amd64" ] && echo x86_64 || echo aarch64) \
 && NIXL_ARCH_DIR=/usr/local/nixl/lib/${ARCH_ALT}-linux-gnu \
 && test -f "${NIXL_ARCH_DIR}/libnixl.so" \
 && test -d "${NIXL_ARCH_DIR}/plugins" \
 && ls -la "${NIXL_ARCH_DIR}" "${NIXL_ARCH_DIR}/plugins" \
 && mkdir -p /opt/dynamo \
 && ln -sfn "${NIXL_ARCH_DIR}" /opt/dynamo/nixl

ENV NIXL_PREFIX=/usr/local/nixl \
    NIXL_LIB_DIR=/opt/dynamo/nixl \
    NIXL_PLUGIN_DIR=/opt/dynamo/nixl/plugins
ENV LD_LIBRARY_PATH=/opt/dynamo/nixl:/opt/dynamo/nixl/plugins:/usr/local/ucx/lib:/usr/local/ucx/lib/ucx:${LD_LIBRARY_PATH:-}

ENV DYNAMO_HOME=/opt/dynamo
WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
