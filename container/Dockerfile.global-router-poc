# CPU-only image for the first regional Global Router POC. This intentionally
# builds only the Rust binary; it does not pull in a framework or Python wheel.
FROM rust:1.96.1-trixie AS builder
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config protobuf-compiler libclang-dev libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --locked --release -p dynamo-llm --bin global-router-poc \
      --no-default-features --features global-view-diagnostics

FROM debian:trixie-slim AS global-router-poc
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /workspace/target/release/global-router-poc /usr/local/bin/global-router-poc
USER 10001:0
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/global-router-poc"]
