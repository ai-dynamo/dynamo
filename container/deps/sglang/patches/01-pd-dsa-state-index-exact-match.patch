+                # origin_input_len). Prefix pages are populated by whichever
+                # request originally produced them, so reading indexer state
+                # at :extend_range.start is valid.
+                dsa_seq_len = transfer_input_len
                 kv_indices_full = self.req_to_token_pool.req_to_token[
-                    req.req_pool_idx, :seq_len
+                    req.req_pool_idx, :dsa_seq_len
                 ]
                 return kv_to_page_indices(kv_indices_full, page_size)
 
