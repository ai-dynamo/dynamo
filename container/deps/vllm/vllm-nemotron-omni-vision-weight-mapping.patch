+    def _load_legacy_vision_weights(
+        self, pending: list[tuple[str, torch.Tensor]]
+    ) -> None:
+        """Map `vision_model.*` / `vision_projector.*` exports onto this
+        implementation's parameters (separate Q/K/V -> packed attn.qkv,
+        `encoder.layer.N` -> `encoder.layers.N`, `embeddings.*` ->
+        `model.patch_generator.*`)."""
+        vis = dict(self.vision_model.named_parameters())
+        mlp = dict(self.mlp1.named_parameters())
+        mlp_map = {
+            "norm.weight": "0.weight",
+            "linear1.weight": "1.weight",
+            "linear2.weight": "3.weight",
+        }
+        emb_map = {
+            "embeddings.cls_register_token":
+                "model.patch_generator.cls_token.token",
+            "embeddings.patch_projection.weight":
+                "model.patch_generator.embedder.weight",
+            "embeddings.position_embedding":
+                "model.patch_generator.pos_embed",
+            "embeddings.video_patch_projection.weight":
+                "model.patch_generator.video_embedder.weight",
+        }
+
+        def rename(n: str) -> str:
+            n = n.replace(".layer.", ".layers.")
+            n = n.replace(".attention.output.dense.", ".attn.proj.")
+            n = n.replace(".layer_scale1.lambda1", ".ls1")
+            return n.replace(".layer_scale2.lambda1", ".ls2")
+
+        def assign(tgt: torch.Tensor, w: torch.Tensor) -> bool:
+            if tuple(tgt.shape) != tuple(w.shape):
+                if tgt.numel() != w.numel():
+                    return False
+                w = w.reshape(tgt.shape)
+            with torch.no_grad():
+                tgt.copy_(w.to(tgt.dtype).to(tgt.device))
+            return True
 
+        remaining = dict(pending)
+        qkv: dict[tuple[str, str], dict[str, torch.Tensor]] = {}
+        for name in list(remaining):
+            if ".attention.attention." not in name:
+                continue
+            base, rest = name.split(".attention.attention.")
+            part, kind = rest.rsplit(".", 1)
+            qkv.setdefault((base, kind), {})[part] = remaining.pop(name)
+        for (base, kind), parts in qkv.items():
+            if not all(k in parts for k in ("query", "key", "value")):
+                continue
+            fused = torch.cat([parts["query"], parts["key"], parts["value"]], dim=0)
+            tail = rename(base[len("vision_model."):]) + f".attn.qkv.{kind}"
+            for cand in (tail, "model." + tail):
+                tgt = vis.get(cand)
+                if tgt is not None and assign(tgt, fused):
+                    break
+
+        unmapped: list[str] = []
+        for name, w in remaining.items():
+            tgt = None
+            if name.startswith("vision_projector.mlp1."):
+                key = mlp_map.get(name[len("vision_projector.mlp1."):])
+                tgt = mlp.get(key) if key else None
+            elif name.startswith("vision_model."):
+                raw = name[len("vision_model."):]
+                if raw in emb_map:
+                    tgt = vis.get(emb_map[raw])
+                else:
+                    cand = rename(raw)
+                    tgt = vis.get(cand) or vis.get("model." + cand)
+            if tgt is None or not assign(tgt, w):
+                unmapped.append(name)
+        if unmapped:
+            logger.warning(
+                "Vision weights not mapped (%d): %s",
+                len(unmapped),
+                ", ".join(sorted(unmapped)[:8]),
+            )
+
