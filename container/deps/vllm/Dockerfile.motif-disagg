# The CI base was built from d11469cbc14d540498175fe9a5eb18e4b6adf1c2.
# Its tree is identical to db6a3705c1d9a9df4f94324636c454e45dc000aa:
# c3a1bd9474d38139c76f9ceebab819906606085d. Reuse those exact binaries.
FROM nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.5.0-motif-3-dev.1@sha256:de58c43b05c5754ae4b6b80933a86b00e064bc6e04316102dd5b47a5951b067e

USER root
RUN --mount=type=bind,source=container/deps/vllm/apply_motif_nixl_patch.py,target=/tmp/apply_motif_nixl_patch.py \
    python3 /tmp/apply_motif_nixl_patch.py

ARG DYNAMO_COMMIT_SHA
RUN test -n "${DYNAMO_COMMIT_SHA}"
ENV DYNAMO_COMMIT_SHA=${DYNAMO_COMMIT_SHA}
LABEL org.opencontainers.image.source="https://github.com/ai-dynamo/dynamo" \
      org.opencontainers.image.revision="${DYNAMO_COMMIT_SHA}" \
      org.opencontainers.image.base.name="nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.5.0-motif-3-dev.1" \
      org.opencontainers.image.base.digest="sha256:de58c43b05c5754ae4b6b80933a86b00e064bc6e04316102dd5b47a5951b067e" \
      ai.dynamo.source-base="db6a3705c1d9a9df4f94324636c454e45dc000aa" \
      ai.dynamo.motif-nixl-patch="1"
USER dynamo
