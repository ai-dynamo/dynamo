From e2e40c76f172f17403a9d1138d9e1da21cb99986 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 27 Aug 2026 04:04:25 -0700
Subject: [PATCH] fix(spec decode): honor DSpark anchor sampling layout

Signed-off-by: Codex <codex@openai.com>
---
 vllm/transformers_utils/configs/speculators/algos.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/vllm/transformers_utils/configs/speculators/algos.py b/vllm/transformers_utils/configs/speculators/algos.py
index e034cec97..90ff5271b 100644
--- a/vllm/transformers_utils/configs/speculators/algos.py
+++ b/vllm/transformers_utils/configs/speculators/algos.py
@@ -148,8 +148,13 @@ def update_dspark(config_dict: dict, pre_trained_config: dict) -> None:
         target_layer_ids (DSpark's i-1 layer semantics).
     """
     pre_trained_config["architectures"] = ["Qwen3DSparkModel"]
-    # Speculators DSpark uses the 1+N fill-in block (anchor is a bonus token).
-    pre_trained_config["dspark_bonus_anchor"] = True
+    # Preserve the block layout declared by the checkpoint. When
+    # sample_from_anchor is true, the anchor predicts the first draft token and
+    # DSpark needs N query slots. Otherwise it uses the 1+N fill-in layout where
+    # the anchor is a separate bonus token.
+    pre_trained_config["dspark_bonus_anchor"] = not config_dict.get(
+        "sample_from_anchor", False
+    )
 
     aux_layer_ids = config_dict["aux_hidden_state_layer_ids"]
     pre_trained_config["eagle_aux_hidden_state_layer_ids"] = aux_layer_ids
-- 
2.34.1

