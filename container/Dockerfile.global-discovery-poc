# CPU-only image for the Global Discovery HTTP service POC. It serves the Relay
# pools found in Karmada-imported EndpointSlices; see global-discovery-poc.yaml.
FROM rust:1.96.1-trixie AS builder
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config protobuf-compiler libclang-dev libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --locked --release -p dynamo-llm --bin global-discovery-poc \
      --no-default-features --features global-discovery-poc

FROM debian:trixie-slim AS global-discovery-poc
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /workspace/target/release/global-discovery-poc /usr/local/bin/global-discovery-poc
USER 10001:0
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/global-discovery-poc"]
