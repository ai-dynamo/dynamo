# Standalone test image — layers test deps on top of a pre-built runtime image.
# Usage: docker build -f container/Dockerfile.test --target test_image --build-arg BASE_IMAGE=<runtime-image> .
# Planner's distroless runtime needs the dedicated test_planner target below.
# Usage: docker build -f container/Dockerfile.test --target test_planner --build-arg BASE_IMAGE=<planner-image> .
ARG BASE_IMAGE

FROM ${BASE_IMAGE} AS test_image

# Install test dependencies on top of runtime image.
# No uv cache: this image is built from a SHA-tagged base, so the layer is
# rebuilt every time and a shared cache mount would be the one place a build
# could still meet uv cache entries written by a different uv version. The
# download is a few seconds against a ~660MB cache, so UV_NO_CACHE keeps it out
# of the layer rather than trading that for the version hazard.
USER root
RUN --mount=type=bind,source=./container/deps/requirements.test.txt,target=/tmp/requirements.test.txt \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    export UV_NO_CACHE=1 UV_GIT_LFS=1 UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    if [ -n "$VIRTUAL_ENV" ]; then \
        uv pip install \
            --requirement /tmp/requirements.test.txt; \
    else \
        pip install --break-system-packages \
            --requirement /tmp/requirements.test.txt; \
    fi

# Copy pytest configuration (markers, filterwarnings, asyncio_mode, etc.)
COPY --chmod=664 --chown=dynamo:0 pyproject.toml /workspace/pyproject.toml
# The nightly version-stamping tests execute this script against temporary
# fixture repositories. Keep the production image unchanged and expose only
# this script in the test image.
COPY --chmod=664 --chown=dynamo:0 .github/scripts/apply_dev_version.py /workspace/.github/scripts/apply_dev_version.py
# Required: blocks dynamo.vllm/sglang from shadowing the installed packages.
COPY --chmod=664 --chown=dynamo:0 conftest.py /workspace/conftest.py
COPY --chmod=775 --chown=dynamo:0 benchmarks/ /workspace/benchmarks/

# The ARC runner executes the job pod as uid 1001 with a non-dynamo gid (see
# shared-test.yml), which lands in "other" perms on this baked dynamo:0 tree.
# Tests create files in their CWD (fault-tolerance engine configs in
# /workspace, launch-script ./logs dirs under examples/), so grant others the
# directory write bit. Directories only: creating a file needs w on its parent
# dir, and touching file modes would copy every file into a new image layer.
# The distroless planner base has no find here — it takes the skip branch and
# test_distroless below repeats the chmod after the runner tools land.
RUN if command -v find; then find /workspace -type d -exec chmod o+w {} +; else echo "skipped (distroless planner)"; fi

USER dynamo

FROM debian:bookworm-slim AS github_runner_tools

# glibc-family libs (loader, libc, libm) are excluded from the harvest: they
# must resolve from the base image. A copied bookworm libm shadows the base's
# newer one via LD_LIBRARY_PATH and breaks its consumers — libpython needs
# GLIBC_2.38 symbols that bookworm's 2.36 libm lacks.
RUN set -eux; \
    tools="bash tail tar gzip cat grep env tr head mkdir chmod mv sleep find"; \
    mkdir -p /github-runner-tools/usr/local/bin /github-runner-tools/opt/dynamo/lib; \
    for tool in ${tools}; do \
        tool_path="$(command -v "${tool}")"; \
        cp -L "${tool_path}" "/github-runner-tools/usr/local/bin/${tool}"; \
        ldd "${tool_path}" \
            | awk '/=> \// { print $3 } /^\// { print $1 }' \
            | grep -Ev '/(ld-linux|libc\.so|libm\.so)' \
            | while read -r lib_path; do \
                cp -L "${lib_path}" "/github-runner-tools/opt/dynamo/lib/$(basename "${lib_path}")"; \
            done; \
    done

FROM test_image AS test_distroless

# The planner runtime is distroless, so add supporting software for GitHub Actions.
USER root
COPY --from=github_runner_tools /github-runner-tools/usr/local/bin/ /usr/local/bin/
COPY --from=github_runner_tools /github-runner-tools/opt/dynamo/lib/ /opt/dynamo/lib/

# find/chmod exist now (copied above): apply the /workspace dir-write fix that
# test_image skipped on this distroless base.
RUN find /workspace -type d -exec chmod o+w {} +

USER dynamo

FROM test_distroless AS test_planner

# Keep Planner-only tests and source-contract fixtures out of the production
# image. The Planner runtime installs the AISimulate wheel, so its test image is
# the only image that can execute these optional replay and Sweeper contracts.
USER root
COPY --chmod=775 --chown=dynamo:0 lib/bindings/python/tests/replay/ /workspace/lib/bindings/python/tests/replay/
COPY --chmod=664 --chown=dynamo:0 components/src/dynamo/mocker/config.py /workspace/components/src/dynamo/mocker/config.py
# Give the copied module a unique basename: AISimulate also ships a top-level
# `test_config.py`, and pytest's default import mode otherwise aliases the two
# non-package modules during whole-workspace collection.
COPY --chmod=664 --chown=dynamo:0 components/src/dynamo/mocker/tests/unit/test_config.py /workspace/components/src/dynamo/mocker/tests/unit/test_mocker_config.py

# These small source descriptors make the AISimulate wheel-context tests
# executable in the installed-wheel image without copying the source tree.
COPY --chmod=664 --chown=dynamo:0 aisimulate/pyproject.toml /workspace/aisimulate/pyproject.toml
COPY --chmod=664 --chown=dynamo:0 Cargo.toml /workspace/Cargo.toml
COPY --chmod=664 --chown=dynamo:0 container/templates/wheel_builder.Dockerfile /workspace/container/templates/wheel_builder.Dockerfile
COPY --chmod=664 --chown=dynamo:0 .github/workflows/release.yml /workspace/.github/workflows/release.yml

# BuildKit applies the file mode to parent directories it creates for these
# single-file COPY instructions. Restore directory traversal/write access for
# the uid/gid that the ARC runner injects at pod startup.
RUN find /workspace -type d -exec chmod o+rwx {} +

USER dynamo
