# Standalone test image — layers test deps on top of a pre-built runtime image.
# Usage: docker build -f container/Dockerfile.test --target test_image --build-arg BASE_IMAGE=<runtime-image> .
# Planner's distroless runtime needs the dedicated test_planner target below.
# Usage: docker build -f container/Dockerfile.test --target test_planner --build-arg BASE_IMAGE=<planner-image> .
ARG BASE_IMAGE

# Helm is needed by chart tests collected in the runtime test lanes.
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS helm_binary
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
# Match deploy/operator/Makefile and the Helm Chart Tests job.
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) checksum=ee88b3c851ae6466a3de507f7be73fe94d54cbf2987cbaa3d1a3832ea331f2cd ;; \
        arm64) checksum=7944e3defd386c76fd92d9e6fec5c2d65a323f6fadc19bfb5e704e3eee10348e ;; \
        *) echo "Unsupported Helm architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --retry 5 --connect-timeout 30 --max-time 300 \
        "https://get.helm.sh/helm-v3.17.3-linux-${TARGETARCH}.tar.gz" -o /tmp/helm.tar.gz; \
    echo "${checksum}  /tmp/helm.tar.gz" | sha256sum -c -; \
    mkdir /out; \
    tar -xzf /tmp/helm.tar.gz --strip-components=1 -C /out "linux-${TARGETARCH}/helm"

FROM ${BASE_IMAGE} AS test_image
COPY --from=helm_binary --chmod=755 /out/helm /usr/local/bin/helm
# Match container/context.yaml; supported system-Python images also need overrides.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 --chmod=755 /uv /opt/dynamo/test-tools/uv

# Install test dependencies on top of runtime image.
# No uv cache: this image is built from a SHA-tagged base, so the layer is
# rebuilt every time and a shared cache mount would be the one place a build
# could still meet uv cache entries written by a different uv version. The
# download is a few seconds against a ~660MB cache, so UV_NO_CACHE keeps it out
# of the layer rather than trading that for the version hazard.
USER root
# The generic Dynamo and Planner CI lanes own the AIS-dependent suites.
# Serving-framework test images retain the ordinary optional-dependency contract.
ARG DYNAMO_TEST_REQUIRE_AIS_RUNTIME=0
ENV DYNAMO_TEST_REQUIRE_AIS_RUNTIME=${DYNAMO_TEST_REQUIRE_AIS_RUNTIME}
# Check the complete newly resolved AIS environment in its owning lanes.
# Backend test layers retain their existing dependency policy; this change
# does not claim their inherited framework graphs pass a full pip check.
RUN --mount=type=bind,source=./container/deps/requirements.test.txt,target=/tmp/requirements.test.txt \
    --mount=type=bind,source=./container/deps/requirements.aisimulate.txt,target=/tmp/requirements.aisimulate.txt \
    --mount=type=bind,source=./tests/wheels/smoke_install.py,target=/tmp/smoke_install.py \
    --mount=type=bind,source=./container/deps/overrides.planner.txt,target=/tmp/overrides.planner.txt \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    --mount=type=secret,id=pip-index-url,env=PIP_INDEX_URL \
    --mount=type=secret,id=uv-default-index,env=UV_DEFAULT_INDEX \
    --mount=type=secret,id=pypi-netrc,target=/run/secrets/pypi-netrc,mode=0444 \
    export NETRC=/run/secrets/pypi-netrc \
        UV_NO_CACHE=1 UV_GIT_LFS=1 UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 && \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    case "$DYNAMO_TEST_REQUIRE_AIS_RUNTIME" in 0|1) ;; *) exit 1 ;; esac && \
    set -- --requirement /tmp/requirements.test.txt && \
    if [ "$DYNAMO_TEST_REQUIRE_AIS_RUNTIME" = 1 ]; then \
        set -- "$@" --find-links https://pypi.nvidia.com/aisimulate/ \
            --only-binary=aisimulate --requirement /tmp/requirements.aisimulate.txt && \
        for wheel in /opt/dynamo/wheelhouse/ai_dynamo*any.whl; do \
            if [ -f "$wheel" ]; then set -- "$@" "${wheel}[ais]"; fi; \
        done; \
    fi && \
    check_python=python3 && \
    if [ -n "$VIRTUAL_ENV" ]; then \
        check_python="$VIRTUAL_ENV/bin/python" && \
        /opt/dynamo/test-tools/uv pip install --python "$check_python" \
            --overrides /tmp/overrides.planner.txt \
            "$@"; \
    else \
        /opt/dynamo/test-tools/uv pip install --python "$check_python" \
            --system --break-system-packages \
            --overrides /tmp/overrides.planner.txt \
            "$@"; \
    fi && \
    if [ "$DYNAMO_TEST_REQUIRE_AIS_RUNTIME" = 1 ]; then \
        "$check_python" -c 'import runpy, sys; from pathlib import Path; runpy.run_path("/tmp/smoke_install.py")["pip_check"](Path(sys.executable), pillow_override=Path("/tmp/overrides.planner.txt"))'; \
    fi

# Datadog's CI action shells out to `pip`. Images that run from a virtualenv
# keep pip inside it rather than on PATH, so expose it. A PATH entry that does
# not exist is skipped, so this is a no-op on the non-venv images.
ENV PATH="/opt/dynamo/venv/bin:${PATH}"

# Copy pytest configuration (markers, filterwarnings, asyncio_mode, etc.)
COPY --chmod=664 --chown=dynamo:0 pyproject.toml /workspace/pyproject.toml
# Stage the source contract for explicit AIS lane ownership.
COPY --chmod=755 --chown=dynamo:0 container/Dockerfile.test /workspace/container/Dockerfile.test
COPY --chmod=755 --chown=dynamo:0 .github/workflows/shared-build-image.yml /workspace/.github/workflows/shared-build-image.yml
# Focused dependency tests read the same declared override used during installation.
COPY --chmod=664 --chown=dynamo:0 container/deps/overrides.planner.txt /workspace/container/deps/overrides.planner.txt
# Dependency contract tests inspect both templates in every component test image.
COPY --chmod=664 --chown=dynamo:0 container/templates/planner.Dockerfile /workspace/container/templates/planner.Dockerfile
COPY --chmod=664 --chown=dynamo:0 tests/__init__.py /workspace/tests/__init__.py
COPY --chmod=664 --chown=dynamo:0 tests/marker_categories.py /workspace/tests/marker_categories.py
# Version-stamping and shell regression tests execute these workflow helpers.
# COPY also creates parent directories: keep them traversable by ARC's uid 1001.
COPY --chmod=755 --chown=dynamo:0 \
    .github/scripts/apply_dev_version.py \
    .github/scripts/helm_chart_version.py \
    .github/scripts/retry_kubectl.sh \
    .github/scripts/collect_vcluster_diagnostics.sh /workspace/.github/scripts/
# Required: blocks dynamo.vllm/sglang from shadowing the installed packages.
COPY --chmod=664 --chown=dynamo:0 conftest.py /workspace/conftest.py
COPY --chmod=775 --chown=dynamo:0 benchmarks/ /workspace/benchmarks/
COPY --chmod=775 --chown=dynamo:0 lib/gpu_memory_service/tests/ /workspace/lib/gpu_memory_service/tests/

# The ARC runner executes the job pod as uid 1001 with a non-dynamo gid (see
# shared-test.yml), which lands in "other" perms on this baked dynamo:0 tree.
# Tests create files in their CWD (fault-tolerance engine configs in
# /workspace, launch-script ./logs dirs under examples/), so grant others the
# directory write bit. Directories only: creating a file needs w on its parent
# dir, and touching file modes would copy every file into a new image layer.
# The distroless planner base has no find here — it takes the skip branch and
# test_distroless below repeats the chmod after the runner tools land.
RUN if command -v find; then find /workspace -type d -exec chmod o+w {} +; else echo "skipped (distroless planner)"; fi

USER dynamo

FROM debian:bookworm-slim AS github_runner_tools

# glibc-family libs (loader, libc, libm) are excluded from the harvest: they
# must resolve from the base image. A copied bookworm libm shadows the base's
# newer one via LD_LIBRARY_PATH and breaks its consumers — libpython needs
# GLIBC_2.38 symbols that bookworm's 2.36 libm lacks.
RUN set -eux; \
    tools="bash tail tar gzip cat grep env tr head mkdir chmod mv sleep find"; \
    mkdir -p /github-runner-tools/usr/local/bin /github-runner-tools/opt/dynamo/lib; \
    for tool in ${tools}; do \
        tool_path="$(command -v "${tool}")"; \
        cp -L "${tool_path}" "/github-runner-tools/usr/local/bin/${tool}"; \
        ldd "${tool_path}" \
            | awk '/=> \// { print $3 } /^\// { print $1 }' \
            | grep -Ev '/(ld-linux|libc\.so|libm\.so)' \
            | while read -r lib_path; do \
                cp -L "${lib_path}" "/github-runner-tools/opt/dynamo/lib/$(basename "${lib_path}")"; \
            done; \
    done

FROM test_image AS test_distroless

# The planner runtime is distroless, so add supporting software for GitHub Actions.
USER root
COPY --from=github_runner_tools /github-runner-tools/usr/local/bin/ /usr/local/bin/
COPY --from=github_runner_tools /github-runner-tools/opt/dynamo/lib/ /opt/dynamo/lib/

# find/chmod exist now (copied above): apply the /workspace dir-write fix that
# test_image skipped on this distroless base.
RUN find /workspace -type d -exec chmod o+w {} +

USER dynamo

FROM test_distroless AS test_planner

# A required AIS lane must never silently inherit the optional default.
RUN test "$DYNAMO_TEST_REQUIRE_AIS_RUNTIME" = 1

# Keep Planner-only tests out of the production image. The Planner runtime
# installs the AISimulate wheel, so its test image can execute the optional
# Dynamo replay and Sweeper integration contracts.
USER root
COPY --chmod=775 --chown=dynamo:0 components/src/dynamo/aisimulate/tests/ /workspace/components/src/dynamo/aisimulate/tests/
COPY --chmod=775 --chown=dynamo:0 lib/bindings/python/tests/replay/ /workspace/lib/bindings/python/tests/replay/
COPY --chmod=664 --chown=dynamo:0 components/src/dynamo/mocker/config.py /workspace/components/src/dynamo/mocker/config.py
# Give the isolated copy a unique basename so pytest cannot alias it with
# another non-package `test_config.py` during whole-workspace collection.
COPY --chmod=664 --chown=dynamo:0 components/src/dynamo/mocker/tests/unit/test_config.py /workspace/components/src/dynamo/mocker/tests/unit/test_mocker_config.py

# BuildKit applies the file mode to parent directories it creates for these
# single-file COPY instructions. Restore directory traversal/write access for
# the uid/gid that the ARC runner injects at pod startup.
RUN find /workspace -type d -exec chmod o+rwx {} +

USER dynamo
