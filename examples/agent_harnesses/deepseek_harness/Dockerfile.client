FROM node:24.10.0-bookworm-slim@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9

ARG DYNAMO_RECIPE_COMMIT=unknown
ARG PNPM_VERSION=11.7.0

COPY examples/agent_harnesses/deepseek_harness/client/package.json examples/agent_harnesses/deepseek_harness/client/pnpm-lock.yaml /opt/dsh-client/
RUN corepack pnpm@${PNPM_VERSION} --dir /opt/dsh-client install --prod --frozen-lockfile --ignore-scripts && ln -s /opt/dsh-client/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/local/lib/dsh-bin.js
COPY .agents/skills/dynamo-agent-harness/scripts/drive_deepseek_harness.mjs /usr/local/bin/drive_deepseek_harness.mjs

ENV DSH_BIN=/usr/local/lib/dsh-bin.js
LABEL org.opencontainers.image.revision="${DYNAMO_RECIPE_COMMIT}" \
      org.opencontainers.image.source="https://github.com/ai-dynamo/dynamo"
USER node
ENTRYPOINT ["node", "/usr/local/bin/drive_deepseek_harness.mjs"]
