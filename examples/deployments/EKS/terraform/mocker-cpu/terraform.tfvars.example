aws_region = "us-west-2"

# Replace this documentation-only address with the public IPv4 address of the
# machine that runs Terraform and kubectl. Keep the /32 mask.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

# Null selects the first EKS-eligible AZ returned for the Region. Set an
# explicit value such as "us-west-2a" when placement must be deterministic.
workload_availability_zone = null

mocker_replicas = 3
