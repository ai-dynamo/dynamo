diff --git a/csrc/engine/block_manager.hpp b/csrc/engine/block_manager.hpp
index 51b92aa..027af7e 100644
--- a/csrc/engine/block_manager.hpp
+++ b/csrc/engine/block_manager.hpp
@@ -238,6 +238,40 @@ struct BlockManagerMutexAcquire {
         return true;
     }
 
+    /// Like try_allocate_seq, but the leading blocks are already-filled prefix blocks shared with
+    /// other holders (an external prefix cache). They are pinned (ref+1) instead of allocated.
+    bool try_allocate_seq_with_prefix(Sequence &seq, const std::vector<int> &prefix_blocks) {
+        TORCH_CHECK(seq.schedule.status == SequenceStatus::WAITING, "status ", int(seq.schedule.status));
+        TORCH_CHECK(seq.cache.block_table.empty(), "Block table not empty");
+        if (this->state_manager) {
+            TORCH_CHECK(seq.cache.state_id == -1, "state already allocated");
+        }
+
+        int num_blocks = seq.get_num_blocks();
+        int num_prefix = static_cast<int>(prefix_blocks.size());
+        TORCH_CHECK_LE(num_prefix, num_blocks);
+        int num_new = num_blocks - num_prefix;
+
+        bool state_alloc_status = this->state_manager ? this->state_manager->can_allocate_single_nolock() : true;
+        auto block_alloc_status = this->block_manager->can_allocate_nolock(num_new);
+        if (block_alloc_status != AllocStatus::OK || !state_alloc_status) {
+            TORCH_CHECK(block_alloc_status != AllocStatus::NEVER, "can never allocate ", num_new, " blocks");
+            return false;
+        }
+
+        this->block_manager->pin_blocks_nolock(prefix_blocks);
+        auto new_blocks = this->block_manager->allocate_nolock(num_new);
+        std::vector<int> block_table;
+        block_table.reserve(num_blocks);
+        block_table.insert(block_table.end(), prefix_blocks.begin(), prefix_blocks.end());
+        block_table.insert(block_table.end(), new_blocks.begin(), new_blocks.end());
+        seq.cache.block_table = std::move(block_table);
+        if (this->state_manager) {
+            seq.cache.state_id = this->state_manager->allocate_single_nolock();
+        }
+        return true;
+    }
+
     std::shared_ptr<BlockManager> &block_manager;
     std::shared_ptr<BlockManager> &state_manager;
 };
