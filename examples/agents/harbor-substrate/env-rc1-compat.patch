 func main() {
 	var (
+		tlsCAFile         = flag.String("tls-ca-file", "", "CA PEM for Substrate API and router")
+		tlsBundle         = flag.String("tls-credential-bundle", "", "projected pod identity certificate and private key PEM")
 		listen            = flag.String("listen", "0.0.0.0:7777", "address to serve the API on")
 		ateapi            = flag.String("ateapi", ate.DefaultControlAddr, "address of the ateapi gRPC control plane")
