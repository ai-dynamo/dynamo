@@ -45,9 +50,33 @@ func main() {
 		wakeRunningBudget = flag.Duration("wake-running-budget", apiservice.DefaultWakeRunningBudget, "how long a guest call waits when the environment is already RUNNING but the router still answers Unavailable (guest not yet listening vs. path down)")
 	)
 	flag.Parse()
+	var tlsConfig *tls.Config
+	if *tlsCAFile != "" {
+		ca, err := os.ReadFile(*tlsCAFile)
+		if err != nil {
+			log.Fatal(err)
+		}
+		roots := x509.NewCertPool()
+		if !roots.AppendCertsFromPEM(ca) {
+			log.Fatal("CA file contains no certificates")
+		}
+		tlsConfig = &tls.Config{MinVersion: tls.VersionTLS12, RootCAs: roots}
+		tlsConfig.GetClientCertificate = func(*tls.CertificateRequestInfo) (*tls.Certificate, error) {
+			pem, err := os.ReadFile(*tlsBundle)
+			if err != nil {
+				return nil, err
+			}
+			cert, err := tls.X509KeyPair(pem, pem)
+			if err != nil {
+				return nil, fmt.Errorf("loading pod identity: %w", err)
+			}
+			return &cert, nil
+		}
+	}
 
 	client, err := ate.New(ate.Options{
 		ControlAddr:     *ateapi,
+		TLSConfig:       tlsConfig,
 		RouterAddr:      *atenet,
 		HostSuffix:      *hostSuffix,
 		SkipVerify:      *skipVerify,
