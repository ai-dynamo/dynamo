+
+// GuestTransportCredentials uses the configured CA and client certificate for actor ingress.
+// Tests without a TLS configuration retain their local plaintext router.
+func (c *Client) GuestTransportCredentials() credentials.TransportCredentials {
+	if c.opts.TLSConfig != nil {
+		return credentials.NewTLS(c.opts.TLSConfig.Clone())
+	}
+	return insecure.NewCredentials()
