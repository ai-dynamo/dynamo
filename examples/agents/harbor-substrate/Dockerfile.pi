ARG TASK_IMAGE=swebench/sweb.eval.x86_64.astropy_1776_astropy-12907@sha256:7485c1e3c8861efd0c6a4a78b952857592e541031039000d25e9481f045dc4a3
FROM ${TASK_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NODE_VERSION=22.23.4
ARG PI_VERSION=0.72.1
ENV NVM_DIR=/root/.nvm
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates stunnel4 ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash \
    && source "$NVM_DIR/nvm.sh" && nvm install "$NODE_VERSION" && nvm alias default "$NODE_VERSION" \
    && npm install -g "@mariozechner/pi-coding-agent@$PI_VERSION" \
    && npm cache clean --force
COPY pi-plugin /root/pi-dynamo-provider
RUN source "$NVM_DIR/nvm.sh" && cd /root/pi-dynamo-provider && npm ci && npm run build \
    && node --input-type=module -e 'import fs from "node:fs"; const p=JSON.parse(fs.readFileSync("package.json")); p.pi.extensions=["./dist/index.js"]; fs.writeFileSync("package.json",JSON.stringify(p,null,2)+"\n");' \
    && pi install /root/pi-dynamo-provider && npm cache clean --force \
    && node --input-type=module -e 'import fs from "node:fs"; import {createRequire} from "node:module"; const require=createRequire(import.meta.url); const pi=require(process.env.NVM_BIN+"/../lib/node_modules/@mariozechner/pi-coding-agent/package.json"); fs.writeFileSync("/opt/pi-runtime.json",JSON.stringify({node:process.version,pi:pi.version,provider:"/root/pi-dynamo-provider",extension:"/root/pi-dynamo-provider/dist/index.js"})+"\n");' \
    && sha256sum dist/*.js > /opt/pi-provider.sha256
RUN curl -fsSL https://github.com/astral-sh/uv/releases/download/0.7.13/uv-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xz --strip-components=1 -C /usr/local/bin uv-x86_64-unknown-linux-gnu/uv \
    && mkdir -p /logs/agent /logs/verifier /logs/artifacts /installed-agent
# Keep login shells cheap: retain task Conda activation but do not auto-load NVM.
RUN source "$NVM_DIR/nvm.sh" \
    && for binary in node npm npx pi; do ln -s "$NVM_BIN/$binary" "/usr/local/bin/$binary"; done \
    && sed -i '/NVM_DIR/d' /root/.bashrc
WORKDIR /testbed
