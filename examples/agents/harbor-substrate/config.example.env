# Copy to .local/config.env, set your values, then source it with set -a.
KUBE_CONTEXT=your-kubernetes-context
SANDBOX_NODE=your-amd64-sandbox-node
IMAGE_REPO=registry.example.com/harbor-substrate
ENV_API_IMAGE=registry.example.com/harbor-substrate/env-api@sha256:REPLACE
GUEST_IMAGE=registry.example.com/harbor-substrate/env-guest@sha256:REPLACE
PREPARED_IMAGE=registry.example.com/harbor-substrate/astropy-pi@sha256:REPLACE
ACTOR_TEMPLATE=swe-astropy-12907-pi
MODEL_BASE_URL=http://model-frontend.inference.svc.cluster.local:8000/v1
SERVED_MODEL=RadixArk/GLM-5.3-Flash-NVFP4
MODEL_CONTEXT_WINDOW=65536
MODEL_MAX_TOKENS=8192
# Set to 0 for an external API that does not support Dynamo session-final requests.
DYN_AGENT_SESSION_FINAL=1
