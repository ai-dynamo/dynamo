{
  "uid": "substrate-native-metrics",
  "title": "Agent Substrate \u00b7 Native Metrics",
  "description": "Native platform telemetry via the OTLP/Prometheus bridge. No session IDs, code changes, or suspension policy. SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved. SPDX-License-Identifier: Apache-2.0",
  "tags": [
    "substrate",
    "harbor",
    "otel"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Native Substrate metrics \u00b7 OTLP \u2192 Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Platform metrics only. Worker counts are **pods, not actor slots**. Replicated API fleet gauges are deduplicated with `max` before aggregation. Operation totals/means are **since process start**, including the first event in a newly created series. Empty parking/restore panels mean no observations; they do not prove a broken bridge. Actor resource samples refresh roughly once per minute even though export/scrape is every 5 seconds. Restore/checkpoint phases overlap and must not be added."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Collection and worker readiness",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Bridge scrape healthy",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{service=\"substrate-metrics-bridge\",endpoint=\"prometheus\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
