    {
      "id": 6,
      "title": "Peak sampled actors",
      "description": "Maximum sampled actor count in the selected time range. Measurement coverage, not an authoritative actor inventory. The exporter expires missing groups after 30s; native sampling/polling adds delay.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ate_actor_stats_sampled_actors{substrate_telemetry=\"otlp\",ate_template_name=~\"$template\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
