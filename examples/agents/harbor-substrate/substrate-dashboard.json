    {
      "id": 14,
      "title": "Router latency p95 by activation",
      "description": "Routing through worker endpoint discovery; excludes guest command execution and model inference. Warm and activation paths remain separate. Histogram estimate, not an exact latency for a single request.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,ate_router_resume) (rate(atenet_router_route_duration_seconds_bucket{substrate_telemetry=\"otlp\",ate_template_name=~\"$template\"}[$__rate_interval])))",
          "legendFormat": "{{ate_router_resume}}",
