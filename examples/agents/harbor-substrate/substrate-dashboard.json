      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ate_worker_state) (max by (ate_workerpool_namespace,ate_workerpool_name,ate_worker_state,ate_sandbox_class) (ate_workerpool_workers{substrate_telemetry=\"otlp\",ate_workerpool_name=~\"$pool\"}))",
          "legendFormat": "{{ate_worker_state}}",
