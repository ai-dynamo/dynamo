@@ -42,6 +44,31 @@
 
     @override
     async def install(self, environment: BaseEnvironment) -> None:
+        if self._preinstalled:
+            if not self._version:
+                raise ValueError("preinstalled mode requires an explicit Pi version")
+            # Validate the baked runtime without running the package manager.
+            expected = shlex.quote(self._version)
+            await self.exec_as_agent(
+                environment,
+                command=(
+                    "set -euo pipefail; "
+                    "node -e 'const fs=require(\"fs\"); "
+                    "const m=JSON.parse(fs.readFileSync(\"/opt/pi-runtime.json\")); "
+                    "const p=require(require(\"path\").dirname(process.execPath)+\"/../lib/node_modules/@mariozechner/pi-coding-agent/package.json\"); "
+                    "if(m.pi!==process.argv[1] || p.version!==m.pi || process.version!==m.node) process.exit(1); "
+                    "fs.accessSync(m.extension); console.log(JSON.stringify(m));' "
+                    f"{expected}; "
+                    "cd /root/pi-dynamo-provider; sha256sum -c /opt/pi-provider.sha256; "
+                    "command -v stunnel >/dev/null; command -v uv >/dev/null"
+                ),
+            )
+            tls_config = self._get_env("DYN_TOOL_TRACE_TLS_CONFIG")
+            if tls_config:
+                await self.exec_as_root(
+                    environment, command=f"stunnel {shlex.quote(tls_config)}"
+                )
+            return
         await super().install(environment)
