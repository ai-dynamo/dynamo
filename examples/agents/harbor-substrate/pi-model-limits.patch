+describe("explicit model limits", () => {
+	afterEach(() => {
+		vi.unstubAllEnvs();
+		vi.restoreAllMocks();
+	});
+
+	it.each([
+		[32768, 4096, 65536, 32768, 4096],
+		[32768, 8192, 16384, 16384, 4096],
+		[131072, 8192, undefined, 131072, 8192],
+		[32768, 1024, 8192, 8192, 1024],
+		[32768, 8192, 2, 2, 1],
+		[32768, 8192, 3, 3, 1],
+	])("respects configured %s/%s and served %s limits", async (context, output, served, contextWindow, maxTokens) => {
+		vi.stubEnv("DYNAMO_CONTEXT_WINDOW", String(context));
+		vi.stubEnv("DYNAMO_MAX_TOKENS", String(output));
+		vi.spyOn(globalThis, "fetch").mockResolvedValue(
+			new Response(JSON.stringify({ data: [{ id: "configured-model", context_window: served }] })),
+		);
+
+		const models = await discoverDynamoModels(config);
+
+		expect(models).toHaveLength(1);
+		expect(models[0]).toMatchObject({ id: "configured-model", contextWindow, maxTokens });
+		expect(models[0]?.maxTokens).toBeGreaterThan(0);
+	});
+
+	it.each([
+		["invalid", "8192"],
+		["8192", "8192"],
+		["32768", "1"],
+		["32768", "-1"],
+		["32768", "1.5"],
+	])("rejects invalid configured limits %s/%s", (context, output) => {
+		vi.stubEnv("DYNAMO_CONTEXT_WINDOW", context);
+		vi.stubEnv("DYNAMO_MAX_TOKENS", output);
+
+		expect(() => createDynamoModels(["configured-model"], config.baseUrl)).toThrow(
+			"Require 1 < DYNAMO_MAX_TOKENS < DYNAMO_CONTEXT_WINDOW",
+		);
+	});
+});
