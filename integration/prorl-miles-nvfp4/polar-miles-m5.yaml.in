polar_rollout_url: "http://prorl-miles-nvfp4-m5-0ee1d48-20260826t033310z-prorl:8080"
polar_reward_key: "score"
polar_max_async_level: 1
polar_request_timeout: 1800
polar_callback_host: "__POD_IP__"
polar_min_complete_accept_fraction: 1.0

polar_task_id_template: "m5-agent-train-{rollout_id}-{sample.group_index}"
polar_task_template:
  timeout_seconds: 1500
  runtime:
    backend: "docker"
    image: "docker.io/library/node@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96"
    network: "host"
    workdir: "/polar/session/workspace"
    cpus: 2
    memory_mb: 8192
    env:
      HOME: "/polar/session/home"
      npm_config_cache: "/polar/session/home/.npm"
      CLAUDE_CODE_MAX_OUTPUT_TOKENS: "4096"
    prepare:
      - type: exec
        command: >-
          mkdir -p /polar/session/home /polar/session/workspace /polar/session/logs/agent &&
          npm install -g @anthropic-ai/claude-code@2.1.139 &&
          claude --version | grep -F 2.1.139
  agent:
    harness: "claude_code"
    model_name: "Qwen/Qwen3-30B-A3B"
    settings:
      max_turns: 8
      max_thinking_tokens: 1024
      tools: "Agent"
      allowed_tools: "Agent"
      append_system_prompt: >-
        This is an integration validation. Use the Agent tool with the exact
        requested arguments, wait for its foreground result, and keep all
        responses concise.
  builder:
    strategy: "per_request"
  evaluator:
    strategy: "session_completed"
