[0.908, "o", "\u001b[0;37m# The runtime image has no Ray or verl, so the Ray head installs the wheels when it starts.\u001b[0m\r\n"]
[1.007, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m🧠 Step 2: Train with verl on KubeRay\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.908, "o", "\u001b[0;37m# One RayJob runs verl's trainer on a Ray head Pod that holds all 8 GPUs.\u001b[0m\r\n"]
