[0.007, "o", "\u001b[?25h\u001b[H\u001b[2J\u001b[3J"]
[0.001, "o", "\r\n\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m🚀 Let's train Qwen2.5-7B-Instruct with verl and Dynamo!\u001b[0m\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.903, "o", "\u001b[0;37m# Each step: Dynamo serves the rollouts\u001b[0m"]
[0.546, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.510, "o", "\u001b[0;37mverl trains on them\u001b[0m"]
[0.509, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.508, "o", "\u001b[0;37mthe new weights sync back.\u001b[0m\r\n"]
[0.907, "o", "\u001b[0;37m# GRPO on GSM8K, 15 steps, \u001b[0;91m\u001b[1m8 GPUs\u001b[0m\u001b[0;37m: the FSDP trainer and 4 vLLM engines in Dynamo share them.\u001b[0m\r\n"]
[1.504, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1m📦 Step 1: Build verl and Stage the Model\u001b[0m\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
