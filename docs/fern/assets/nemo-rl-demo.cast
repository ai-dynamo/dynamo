[0.811, "o", "  entrypoint: >-  # KubeRay pastes this into a shell script unquoted, so it can't hold comments\r\n    /opt/nemo_rl_venv/bin/python examples/run_grpo_single_controller.py\r\n    --config examples/configs/grpo_math_1B_dynamo_single_controller.yaml\r\n"]
[0.000, "o", "    cluster.gpus_per_node=3\r\n    policy.generation.colocated.resources.gpus_per_node=2\r\n    grpo.max_num_steps=25\r\n"]
[0.000, "o", "    logger.monitor_gpus=false\r\n\r\n"]
[0.911, "o", "\u001b[0;37m# Dynamo rollouts · KV-aware routing · 2 engine GPUs and 1 trainer GPU · no DGD\u001b[0m\r\n\r\n"]
