[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1m🧠 Step 2: Train with NeMo RL on KubeRay\u001b[0m\r\n"]
[0.001, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.915, "o", "\u001b[0;37m# One RayJob runs NeMo RL's GRPO driver on a Ray head Pod that holds all 3 GPUs.\u001b[0m\r\n"]
[0.911, "o", "\u001b[0;37m# Its config sets policy.generation.dynamo: true, so the driver starts Dynamo in the job.\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[?25h"]
[0.000, "o", "\u001b[0;97m❯\u001b[0m "]
