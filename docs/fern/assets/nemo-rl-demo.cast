{"version": 3, "term": {"cols": 100, "rows": 25, "theme": {"fg": "#eeffff", "bg": "#0c0d0b", "palette": "#333333:#f07178:#c3e88d:#ffcb6b:#82aaff:#c792ea:#89ddff:#8b949e:#6e7681:#f78c6c:#c3e88d:#eeffff:#82aaff:#89ddff:#89ddff:#8cce37"}}, "timestamp": 1794627976, "idle_time_limit": 2.0, "command": "bash nemo-rl-demo.sh", "env": {"SHELL": "/bin/zsh"}}
[0.015, "o", "\u001b[?25h"]
[0.000, "o", "\u001b[H\u001b[2J\u001b[3J\r\n\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m🚀 Let's train Qwen2.5-1.5B with NeMo RL and Dynamo!\u001b[0m\r\n\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.909, "o", "\u001b[0;37m# Each step: Dynamo serves the rollouts\u001b[0m"]
[0.517, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.509, "o", "\u001b[0;37mNeMo RL trains on them\u001b[0m"]
[0.517, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.514, "o", "\u001b[0;37mthe new weights sync back.\u001b[0m\r\n"]
[0.919, "o", "\u001b[0;37m# GRPO on OpenMathInstruct-2, 25 steps, \u001b[0;91m\u001b[1m3 GPUs\u001b[0m\u001b[0;37m: a Megatron Core trainer and 2 vLLM engines.\u001b[0m\r\n"]
[1.514, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m📦 Step 1: Build the Image and Stage the Data\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
