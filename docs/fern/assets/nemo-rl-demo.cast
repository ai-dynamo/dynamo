[0.918, "o", "\u001b[0;37m# The mean reward rose from \u001b[0;91m\u001b[1m0.08\u001b[0m\u001b[0;37m in the first 3 steps to \u001b[0;91m\u001b[1m0.28\u001b[0m\u001b[0;37m in the last 3.\u001b[0m\r\n"]
[0.913, "o", "\u001b[0;37m# gen_kl_error stayed near 0.001: the engines generated with the weights from each sync.\u001b[0m\r\n"]
[0.910, "o", "\u001b[0;37m# The engines generate a step's batch during the step before, so training never waits.\u001b[0m\r\n"]
[1.017, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
