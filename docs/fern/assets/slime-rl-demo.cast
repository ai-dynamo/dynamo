[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1m🚀 Step 3: Serve Rollouts with Dynamo\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.904, "o", "\u001b[0;37m# A DynamoGraphDeployment (DGD) runs a Dynamo frontend and two SGLang engines, one GPU each.\u001b[0m\r\n"]
[0.909, "o", "\u001b[0;37m# Each engine is stock sglang.launch_server. Dynamo's sidecar registers it with the frontend.\u001b[0m\r\n"]
[0.910, "o", "\u001b[0;37m# One Service per engine exposes SGLang's own API on port 30000 for Slime's weight updates.\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[?25h"]
[0.000, "o", "\u001b[0;97m❯\u001b[0m "]
