[0.011, "o", "\u001b[?25h"]
[0.000, "o", "\u001b[H\u001b[2J\u001b[3J\r\n\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[0;32m\u001b[1m🚀 Let's train Qwen3-0.6B with Slime and Dynamo!\u001b[0m\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.907, "o", "\u001b[0;34m# Each step: Dynamo serves the rollouts\u001b[0m"]
[0.506, "o", "\u001b[0;37m\u001b[1m → \u001b[0m"]
[0.504, "o", "\u001b[0;34mSlime trains on them\u001b[0m"]
[0.508, "o", "\u001b[0;37m\u001b[1m → \u001b[0m"]
[0.517, "o", "\u001b[0;34mthe new weights sync back.\u001b[0m\r\n"]
[0.910, "o", "\u001b[0;34m# GRPO on GSM8K, 10 steps, \u001b[1;33m\u001b[1m3 GPUs\u001b[0m\u001b[0;34m: two SGLang engines in Dynamo, one Megatron-LM trainer on KubeRay.\u001b[0m\r\n"]
[1.506, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[0;32m\u001b[1m📦 Step 1: Stage the Model and Data\u001b[0m\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.907, "o", "\u001b[0;34m# Prerequisites: the Dynamo platform and the KubeRay operator, both installed with Helm.\u001b[0m\r\n\r\n"]
