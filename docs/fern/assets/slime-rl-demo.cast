[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n  \u001b[1m🚀 Let's train Qwen3-0.6B with Slime and Dynamo!\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.908, "o", "\u001b[0;37m# Each step: Dynamo serves the rollouts\u001b[0m"]
[0.509, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.509, "o", "\u001b[0;37mSlime trains on them\u001b[0m"]
[0.510, "o", "\u001b[0m\u001b[1m → \u001b[0m"]
[0.508, "o", "\u001b[0;37mthe new weights sync back.\u001b[0m\r\n"]
[0.910, "o", "\u001b[0;37m# GRPO on GSM8K, 10 steps, \u001b[0;91m\u001b[1m3 GPUs\u001b[0m\u001b[0;37m: two SGLang engines in Dynamo, one Megatron-LM trainer on KubeRay.\u001b[0m\r\n"]
[1.509, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[0;30m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1m📦 Step 1: Stage the Model and Data\u001b[0m\r\n"]
