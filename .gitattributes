*                   text  eol=lf
*.sln               text  eol=crlf
*.[Gg][Ii][Ff]      binary
*.[Ii][Cc][Oo]      binary
*.[Jj][Pp][Ee][Gg]  binary
*.[Jj][Pp][Gg]      binary
*.[Pp][Dd][Ff]      binary
*.[Pp][Nn][Gg]      binary
*.[Ww][Ee][Bb][Pp]  binary
*.[Zz][Ii][Pp]      binary
*.[Tt][Gg][Zz]      binary
*.[Gg][Zz]          binary
*.fatbin            binary
*.mp4               binary
*.woff2             binary -eol

# Exclude test data files from linguist language detection
lib/llm/tests/data/** linguist-vendored
lib/llm/tests/snapshots/** linguist-vendored

# Preserve the released vLLM proto byte-for-byte, including its trailing blank line.
lib/backend/vllm-sidecar/proto/vllm_grpc.proto -text diff whitespace=-blank-at-eof

# Generated from the Rust media types: see scripts/generate_media_protocols.py.
lib/llm/src/protocols/openai/media_schemas/*.json linguist-generated
components/src/dynamo/common/protocols/audio_protocol.py linguist-generated
components/src/dynamo/common/protocols/image_protocol.py linguist-generated
components/src/dynamo/common/protocols/video_protocol.py linguist-generated
