{
  "description": "Regex verdicts shared by two tests. The Rust preprocessor test checks its hand-written construct list against them, and the Python frontend test checks them against XGrammar itself, so the Rust list cannot drift from the compiler unnoticed. Each case is [pattern, construct]: the construct the Rust list names, or null when XGrammar compiles the pattern. Verified with XGrammar 0.1.33, 0.2.7, and 0.2.8.",
  "cases": [
    ["^(?!\\s*$).+", "lookahead"],
    ["^(?=.*\\d).+$", "lookahead"],
    ["\\\\(?=x)", "lookahead"],
    ["(?<=a)b", "lookbehind"],
    ["(?<!a)b", "lookbehind"],
    ["(a)\\1", "backreference"],
    ["\\8", "backreference"],
    ["(?<n>a)\\k<n>", "backreference"],
    ["[^]\\1]x", "backreference"],
    ["(?>ab)", "group modifier"],
    ["(?i)abc", "group modifier"],
    ["(?i:a)", "group modifier"],
    ["(?P<year>\\d{4})", "group modifier"],
    ["(?#note)a", "group modifier"],
    ["a\\b", "word boundary"],
    ["\\Ba", "word boundary"],
    ["\\p{L}+", "Unicode property escape"],
    ["[]a", "empty character class"],
    ["a++", "consecutive quantifiers"],
    ["a{2}*", "consecutive quantifiers"],
    ["a+??", "consecutive quantifiers"],
    ["a{,3}", "malformed repetition"],
    ["a{x}", "malformed repetition"],
    ["a{ 2}", "malformed repetition"],
    ["a{3,2}", "malformed repetition"],
    ["x{", "malformed repetition"],
    ["{2}a", "quantifier without an element"],
    ["a{1000000000000001}", "malformed repetition"],
    ["a{1,1000000000000001}", "malformed repetition"],
    ["a{99999999999999999}", "malformed repetition"],
    ["é+(?=ø)", "lookahead"],
    ["^[a-z]+$", null],
    ["(?<year>\\d{4})", null],
    ["(?:ab)+", null],
    ["\\(\\?=x\\)", null],
    ["[(?=]+", null],
    ["[\\b\\p{L}]", null],
    ["[^]a", null],
    ["a+?b*?c??d{2}?", null],
    ["a{2}b{2,}c{2,3}d{02}", null],
    ["a{1000000000000000}b{1,1000000000000000}", null],
    ["\\u{1F600}+", null],
    ["a}", null],
    ["[ä-ö]+ø{2}\\é", null],
    ["\\{2}", null],
    ["\\0\\cA\\x41\\u0041", null]
  ]
}
