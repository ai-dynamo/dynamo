#!/usr/bin/env python3
import pathlib
import sys


ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "implementation/lib"))

from snapshot_poc import checkpoint_id


if len(sys.argv) != 2:
    raise SystemExit(f"usage: {sys.argv[0]} <64-hex-compatibility-hash>")
print(checkpoint_id(sys.argv[1]))
