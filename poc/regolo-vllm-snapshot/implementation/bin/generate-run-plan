#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
from snapshot_poc import canonical_json, make_run_plan


parser = argparse.ArgumentParser()
parser.add_argument("--output-dir", type=pathlib.Path, required=True)
parser.add_argument("--seed", type=int, default=20260811)
args = parser.parse_args()
args.output_dir.mkdir(parents=True, exist_ok=True)
schedule, key = make_run_plan(args.seed)
schedule_bytes = (json.dumps(schedule, indent=2, sort_keys=True) + "\n").encode()
(args.output_dir / "run-plan.json").write_bytes(schedule_bytes)
key_path = args.output_dir / "unblinding-key.json"
key_path.write_text(json.dumps(key, indent=2, sort_keys=True) + "\n")
os.chmod(key_path, 0o600)
(args.output_dir / "seed.txt").write_text(str(args.seed) + "\n")
print(hashlib.sha256(schedule_bytes).hexdigest())
