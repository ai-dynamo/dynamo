#!/usr/bin/env python3
"""Fail closed on obvious credential material before checkpoint creation."""

import argparse
import json
import pathlib
import re
import subprocess


SUSPICIOUS = re.compile(
    r"(token|secret|password|passwd|api[_-]?key|authorization|credential|aws_access|aws_secret|hf_token)",
    re.IGNORECASE,
)


def walk(value, path="$"):
    if isinstance(value, dict):
        for key, item in value.items():
            here = f"{path}.{key}"
            if key in {"secretKeyRef", "secret", "envFrom", "serviceAccountToken"}:
                yield here, item
            yield from walk(item, here)
    elif isinstance(value, list):
        for index, item in enumerate(value):
            yield from walk(item, f"{path}[{index}]")
    elif isinstance(value, str) and SUSPICIOUS.search(value):
        yield path, value


parser = argparse.ArgumentParser()
parser.add_argument("--manifest", type=pathlib.Path, required=True)
parser.add_argument("--image", required=True)
args = parser.parse_args()
manifest = json.loads(args.manifest.read_text())
findings = list(walk(manifest))

inspect = subprocess.run(
    ["docker", "image", "inspect", args.image], text=True, capture_output=True
)
if inspect.returncode:
    findings.append(("image", "image is not locally inspectable; fail closed"))
else:
    image = json.loads(inspect.stdout)[0]
    for env in image.get("Config", {}).get("Env") or []:
        name = env.split("=", 1)[0]
        if SUSPICIOUS.search(name):
            findings.append(("image.Config.Env", name))
    history = subprocess.run(
        ["docker", "history", "--no-trunc", "--format", "{{.CreatedBy}}", args.image],
        text=True,
        capture_output=True,
    )
    for line in history.stdout.splitlines():
        if SUSPICIOUS.search(line):
            findings.append(("image.history", line[:240]))

report = {"passed": not findings, "findings": findings}
print(json.dumps(report, indent=2, sort_keys=True))
raise SystemExit(0 if not findings else 1)
