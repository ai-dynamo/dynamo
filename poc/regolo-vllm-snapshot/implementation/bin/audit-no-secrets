#!/usr/bin/env python3
"""Fail closed on obvious credential material before checkpoint creation."""

import argparse
import json
import pathlib
import re
import subprocess


SUSPICIOUS = re.compile(
    r"(token|secret|password|passwd|api[_-]?key|authorization|credential|aws_access|aws_secret|hf_token)",
    re.IGNORECASE,
)
HISTORY_ASSIGNMENT = re.compile(
    r"\b(?:token|secret|password|passwd|api[_-]?key|authorization|credential|aws_access|aws_secret|hf_token)\b\s*=",
    re.IGNORECASE,
)


def walk(value, path="$"):
    if isinstance(value, dict):
        for key, item in value.items():
            here = f"{path}.{key}"
            if key in {"secretKeyRef", "secret", "envFrom", "serviceAccountToken"}:
                yield here, item
            yield from walk(item, here)
    elif isinstance(value, list):
        for index, item in enumerate(value):
            yield from walk(item, f"{path}[{index}]")
    elif isinstance(value, str) and SUSPICIOUS.search(value):
        yield path, value


parser = argparse.ArgumentParser()
parser.add_argument("--manifest", type=pathlib.Path, required=True)
parser.add_argument("--image", required=True)
args = parser.parse_args()
manifest = json.loads(args.manifest.read_text())
findings = list(walk(manifest))
if manifest.get("spec", {}).get("automountServiceAccountToken") is not False:
    findings.append(
        (
            "$.spec.automountServiceAccountToken",
            "must be explicitly false so the API server cannot inject a service-account token",
        )
    )

inspect = subprocess.run(
    ["docker", "image", "inspect", args.image], text=True, capture_output=True
)
inspect_passed = inspect.returncode == 0
history_passed = False
if not inspect_passed:
    findings.append(("image", "image is not locally inspectable; fail closed"))
else:
    image = json.loads(inspect.stdout)[0]
    for env in image.get("Config", {}).get("Env") or []:
        name = env.split("=", 1)[0]
        if SUSPICIOUS.search(name):
            findings.append(("image.Config.Env", name))
    history = subprocess.run(
        ["docker", "history", "--no-trunc", "--format", "{{.CreatedBy}}", args.image],
        text=True,
        capture_output=True,
    )
    history_passed = history.returncode == 0
    if not history_passed:
        findings.append(("image.history", "Docker history inspection failed; fail closed"))
    else:
        for line in history.stdout.splitlines():
            if HISTORY_ASSIGNMENT.search(line):
                findings.append(("image.history", line[:240]))

report = {
    "docker_history_passed": history_passed,
    "docker_inspect_passed": inspect_passed,
    "findings": findings,
    "image": args.image,
    "passed": not findings,
}
print(json.dumps(report, indent=2, sort_keys=True))
raise SystemExit(0 if not findings else 1)
