name: "embedder"
backend: "python"
max_batch_size: 4

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [1]
  }
]
output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [8]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
