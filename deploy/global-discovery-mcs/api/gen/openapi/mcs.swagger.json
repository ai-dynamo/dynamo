        "cluster": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "description": "Cloud region, for example us-east-1."
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Availability zones of the cluster's nodes."
        },
        "provider": {
          "type": "string",
          "description": "Free-form provider name, for example eks or k3d."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "agentId": {
          "type": "string",
          "description": "Identity of the registering agent, for example the controller pod name."
        },
        "agentVersion": {
          "type": "string"
        },
        "lease": {
          "$ref": "#/definitions/v1Lease"
        },
        "generation": {
          "type": "string",
          "format": "uint64",
          "description": "Incremented by the server on every registration."
