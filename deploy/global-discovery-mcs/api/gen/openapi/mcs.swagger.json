        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time of the first registration; kept across re-registrations."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Cluster is the registration of a member cluster."
    },
    "v1ClusterEndpoints": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string"
