+static int restore_vma_buffered_job(struct task_restore_args *args, struct restore_vma_io *rio)
+{
+	int j;
+
+	switch (rio->storage) {
+	case VMA_IO_UNCOMPRESSED:
+		return restore_vma_preadv_one(args, rio, true);
+	case VMA_IO_PACKED_RAW:
+		return restore_vma_preadv_one(args, rio, false);
+	case VMA_IO_ZERO:
+		for (j = 0; j < rio->nr_iovs; j++)
+			memset(rio->iovs[j].iov_base, 0, rio->iovs[j].iov_len);
+		return 0;
+	default:
+		return -1;
+	}
+}
+
+static int restore_vma_buffered_sequential(struct task_restore_args *args)
+{
+	struct restore_vma_io *rio = args->vma_ios;
+	unsigned int i;
+
+	for (i = 0; i < args->vma_ios_n; i++) {
+		if (restore_vma_buffered_job(args, rio))
+			return -1;
+		rio = (struct restore_vma_io *)((char *)rio + RIO_SIZE(rio->nr_iovs));
+	}
+	return 0;
+}
+
+static int restore_vma_buffered_chunk(struct task_restore_args *args,
+				      struct buffered_restore_job *job)
+{
+	struct iovec iov = { .iov_base = job->addr, .iov_len = job->len };
+	loff_t off = job->off;
+
+	if (job->zero) {
+		memset(job->addr, 0, job->len);
+		return 0;
+	}
+	while (iov.iov_len) {
+		ssize_t n = sys_preadv(args->vma_ios_fd, &iov, 1, off);
+
+		if (n <= 0)
+			return -1;
+		iov.iov_base = (char *)iov.iov_base + n;
+		iov.iov_len -= n;
+		off += n;
+	}
+	return 0;
+}
+
+static long restore_vma_buffered_worker(struct buffered_restore_worker_arg *arg)
+{
+	struct buffered_restore_shared *shared = arg->shared;
+
+	while (!__atomic_load_n(&shared->error, __ATOMIC_RELAXED)) {
+		unsigned int index = __atomic_fetch_add(&shared->next_job, 1, __ATOMIC_RELAXED);
+		int expected = 0;
+
+		if (index >= shared->nr_jobs)
+			break;
+		if (restore_vma_buffered_chunk(shared->args, &shared->jobs[index]))
+			__atomic_compare_exchange_n(&shared->error, &expected, -1, false,
+						    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+	}
+	futex_dec_and_wake(&shared->remaining);
+	sys_exit(0);
+	return 0;
+}
+
+static int wait_buffered_restore_barrier(void)
+{
+	futex_t *barrier = &task_entries_local->buffered_restore_barrier;
+
+	if (!task_entries_local->buffered_restore_participants)
+		return 0;
+	futex_dec_and_wake(barrier);
+	futex_wait_until(barrier, 0);
+	if (futex_get(barrier) & FUTEX_ABORT_FLAG) {
+		pr_err("Buffered VMA restore barrier aborted\n");
+		return -1;
+	}
+	return 0;
+}
