ARG DOCKER_PROXY
ARG BASE_IMAGE="library/golang"
ARG BASE_IMAGE_TAG="1.27.3"
FROM ${DOCKER_PROXY}${BASE_IMAGE}:${BASE_IMAGE_TAG} AS builder

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /workspace/bin/search-ui ./cmd/search-ui

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/bin/search-ui /search-ui
USER 65532:65532
ENTRYPOINT ["/search-ui"]
