// TestCaptureEnvironmentSyncPredecessor runs only in the archived source named
// below. It writes unnormalized renderer objects and the predecessor's own hashes.
func TestCaptureEnvironmentSyncPredecessor(t *testing.T) {
	for _, origin := range []string{"1.8.0", "1.7.0", ""} {
		t.Run("origin="+origin, func(t *testing.T) {
			t.Log("Capture actual predecessor lowerings, never current-code approximations")
			dgd := &v1beta1.DynamoGraphDeployment{Name: "graph", Namespace: "ns", UID: "graph-uid",
				Annotations: map[string]string{consts.KubeAnnotationDynamoOperatorOriginVersion: origin},
				Spec: v1beta1.DynamoGraphDeploymentSpec{BackendFramework: "vllm", Components: []v1beta1.DynamoComponentDeploymentSharedSpec{{
					ComponentName: "frontend", ComponentType: v1beta1.ComponentTypeFrontend, Replicas: new(int32(1)),
					PodTemplate: &corev1.PodTemplateSpec{Spec: corev1.PodSpec{Containers: []corev1.Container{{
						Name: "main", Image: "runtime:1.7.0", Env: []corev1.EnvVar{{Name: "B", Value: "$(A)"}, {Name: "A", Value: "x"}},
					}}}},
				}}},
			}
			if origin == "" {
				dgd.Annotations = nil
			}
			children, err := dynamo.GenerateDynamoComponentsDeployments(dgd, nil, nil, dynamo.RollingUpdateContext{})
			require.NoError(t, err)
			dcd := children["frontend"]
			dcd.UID, dcd.Generation = "dcd-uid", 7
			dcd.OwnerReferences = []metav1.OwnerReference{*metav1.NewControllerRef(dgd, v1beta1.DynamoGraphDeploymentGVK)}
			config := &configv1alpha1.OperatorConfiguration{}
			runtimeConfig := &common.RuntimeConfig{Gate: features.Gates{Grove: true}}
			secrets := &mockDockerSecretRetriever{GetSecretsFunc: func(string, string) ([]string, error) { return nil, nil }}
			pcs, err := dynamo.GenerateGrovePodCliqueSet(t.Context(), dgd, nil, config, runtimeConfig, nil, secrets, nil, nil, false, nil)
			require.NoError(t, err)
			pcs.UID, pcs.Generation = "pcs-uid", 7
			pcs.OwnerReferences = []metav1.OwnerReference{*metav1.NewControllerRef(dgd, v1beta1.DynamoGraphDeploymentGVK)}

			t.Log("Capture matching-origin standalone Deployment and LWS inputs")
			template := dgd.Spec.Components[0].PodTemplate.DeepCopy()
			template.Annotations = map[string]string{consts.KubeAnnotationDynamoOperatorOriginVersion: origin}
			template.Spec.Containers[0].Command = []string{"python3", "-m", "dynamo.vllm"}
			template.Spec.Containers[0].Args = []string{"--model", "test-model"}
			deploymentDCD := &v1beta1.DynamoComponentDeployment{Name: "worker", Namespace: "ns", UID: "dcd-uid",
				Annotations: map[string]string{consts.KubeAnnotationDynamoOperatorOriginVersion: origin},
				Spec: v1beta1.DynamoComponentDeploymentSpec{BackendFramework: "vllm", DynamoComponentDeploymentSharedSpec: v1beta1.DynamoComponentDeploymentSharedSpec{
					ComponentName: "worker", ComponentType: v1beta1.ComponentTypeWorker, Replicas: new(int32(1)), PodTemplate: template,
				}},
			}
			if origin == "" {
				deploymentDCD.Annotations = nil
				template.Annotations = nil
			}
			lwsDCD := deploymentDCD.DeepCopy()
			lwsDCD.Spec.Multinode = &v1beta1.MultinodeSpec{NodeCount: 2}
			kubeClient := fake.NewClientBuilder().WithScheme(newDynamoGraphDeploymentControllerTestScheme(t)).WithObjects(deploymentDCD).Build()
			reconciler := &DynamoComponentDeploymentReconciler{Client: kubeClient, Recorder: events.NewFakeRecorder(20), Config: config, RuntimeConfig: &common.RuntimeConfig{}}
			deployment, _, err := reconciler.generateDeployment(t.Context(), generateResourceOption{dynamoComponentDeployment: deploymentDCD})
			require.NoError(t, err)
			deployment.UID, deployment.Generation = "deployment-uid", 7
			deployment.OwnerReferences = []metav1.OwnerReference{*metav1.NewControllerRef(deploymentDCD, v1beta1.DynamoComponentDeploymentGVK)}
			lws, _, err := reconciler.generateLeaderWorkerSet(t.Context(), generateResourceOption{dynamoComponentDeployment: lwsDCD}, leaderWorkerSetName(lwsDCD))
			require.NoError(t, err)
			lws.UID, lws.Generation = "lws-uid", 7
			lws.OwnerReferences = []metav1.OwnerReference{*metav1.NewControllerRef(lwsDCD, v1beta1.DynamoComponentDeploymentGVK)}

			t.Log("Record the predecessor's spec hash and generation bookkeeping unchanged")
			for _, object := range []client.Object{dcd, pcs, deployment, lws} {
				hash, err := common.GetSpecHash(object)
				require.NoError(t, err)
				annotations := object.GetAnnotations()
				if annotations == nil {
					annotations = map[string]string{}
				}
				annotations[common.NvidiaAnnotationHashKey] = hash
				annotations[common.NvidiaAnnotationGenerationKey] = "7"
				object.SetAnnotations(annotations)
			}
			output := map[string]any{
				"sourceRevision": "8f1fdc45f043356fa2e15bfcd28f576ce44db555",
				"origin":         origin, "graph": dgd, "component": dcd, "podCliqueSet": pcs,
				"deploymentInput": deploymentDCD, "deployment": deployment,
				"leaderWorkerSetInput": lwsDCD, "leaderWorkerSet": lws,
			}
			data, err := json.MarshalIndent(output, "", "  ")
			require.NoError(t, err)
			name := origin
			if name == "" {
				name = "missing"
			}
			require.NoError(t, os.WriteFile(filepath.Join(os.Getenv("DYNAMO_ENV_SYNC_CAPTURE_DIR"), "origin-"+name+".json"), append(data, '\n'), 0o644))
		})
	}
}
