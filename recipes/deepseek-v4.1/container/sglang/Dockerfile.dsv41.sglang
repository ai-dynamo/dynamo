ARG DYNAMO_SRC_IMAGE=dynamo:latest-sglang-runtime
# Preview image from https://github.com/sgl-project/sglang/pull/38798 (open and unmerged).
ARG DSV41_BASE_IMAGE=lmsysorg/sglang@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349

FROM ${DYNAMO_SRC_IMAGE} AS dynamo_src

FROM ${DSV41_BASE_IMAGE}

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

RUN pip uninstall -y black termplotlib \
    && apt-get update \
    && apt-get purge -y libx264-164 libx265-199 libde265-0 libavcodec60 libxvidcore4 \
    && apt list --upgradable 2>/dev/null | tail -n +2 | grep 'noble' | awk -F/ '{print $1}' | xargs -r apt-get install -y --only-upgrade \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages "distro>=1.7,<2"

COPY --from=dynamo_src /usr/bin/nats-server /usr/bin/nats-server
COPY --from=dynamo_src /usr/local/bin/etcd /usr/local/bin/etcd
ENV PATH=/usr/local/bin/etcd:${PATH}

# The SGLang base is a multi-arch index. Its Python venv is /opt/sglang and
# its editable SGLang source is /sgl-workspace/sglang; /workspace/sglang and
# /usr/local/lib/python3.12/dist-packages are not runtime Python paths.
# Select the donor's platform-specific UCX directory at build time, then copy
# NIXL into the venv's active site-packages directory.
RUN --mount=type=bind,from=dynamo_src,source=/usr/lib,target=/dynamo-src/usr/lib,readonly \
    --mount=type=bind,from=dynamo_src,source=/usr/local/lib/python3.12/dist-packages,target=/dynamo-src/dist-packages,readonly \
    case "${TARGETARCH}" in \
        amd64) libdir=x86_64-linux-gnu ;; \
        arm64) libdir=aarch64-linux-gnu ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && site="$(python3 -c 'import site; print(site.getsitepackages()[-1])')" \
    && mkdir -p "/usr/lib/${libdir}" "${site}" \
    && cp -a "/dynamo-src/usr/lib/${libdir}/ucx" "/usr/lib/${libdir}/" \
    && cp -a "/dynamo-src/usr/lib/${libdir}"/libuc*.so* "/usr/lib/${libdir}/" \
    && cp -a /dynamo-src/dist-packages/nixl* "${site}/" \
    && ldconfig

COPY --from=dynamo_src /opt/dynamo/wheelhouse /opt/dynamo/wheelhouse
RUN pip install --no-cache-dir --force-reinstall --no-deps \
    /opt/dynamo/wheelhouse/ai_dynamo_runtime*.whl \
    /opt/dynamo/wheelhouse/ai_dynamo-*.whl && \
    python3 -c "from dynamo._core import get_tool_parser_names; assert 'deepseek_v41' in get_tool_parser_names(), 'V4.1 parser missing!'; print('V4.1 parser verified')"

COPY --from=dynamo_src /workspace/components/src/dynamo /workspace/components/src/dynamo
COPY --from=dynamo_src /workspace/ATTRIBUTIONS-Python.md /workspace/ATTRIBUTIONS-Rust.md /workspace/ATTRIBUTIONS.md /workspace/

# SGLang resolves through its editable install at /sgl-workspace/sglang.
ENV PYTHONPATH=/workspace/components/src

ENV SGLANG_JIT_DEEPGEMM_PRECOMPILE=0 \
    SGLANG_JIT_DEEPGEMM_FAST_WARMUP=1

WORKDIR /workspace

ENTRYPOINT []
CMD ["bash"]
