{% set dgd = base.dynamographdeployment | only %}
apiVersion: nvidia.com/v1beta1
kind: DynamoGraphDeployment
metadata:
  name: {{ dgd.metadata.name }}
spec:
  components:
  {% for component in dgd.spec.components if component.type in ("worker", "prefill", "decode") %}
  - name: {{ component.name }}
    podTemplate:
      spec:
        containers:
        {% for container in component.podTemplate.spec.containers if container.name == "main" %}
        - name: main
          resources:
            limits: &{{ component.name }}EfaResources
              vpc.amazonaws.com/efa: "{{ container.resources.limits["nvidia.com/gpu"] | int * values.EFAS_PER_GPU }}"
            requests: *{{ component.name }}EfaResources
        {% endfor %}
  {% endfor %}
